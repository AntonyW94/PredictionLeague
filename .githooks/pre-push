#!/bin/sh
#
# Checks the Dapper reads touched by the commits being pushed against the database's real result-set
# shapes, so a result-set mismatch is caught before it reaches a shared branch rather than at runtime in
# production.
#
# Deliberately permissive about its own prerequisites: it skips when there is nothing to check, when
# dotnet is missing, or when the database cannot be reached. A hook that blocks a push on a train gets
# bypassed with --no-verify and then never runs again, so it only ever fails on a real finding.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
# Bypass a finding you believe is wrong with `git push --no-verify`.
#
# Note: the tool reads the working tree, not the commits being pushed, so a dirty tree is what actually
# gets checked. The hook warns when src/ has uncommitted changes.

set -e

ROOT=$(git rev-parse --show-toplevel)
DEFAULT_BRANCH="origin/master"

# git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
CHANGED=""
READ_ANY=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    READ_ANY=1

    # An all-zero local sha means the ref is being deleted - nothing to check.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    # An all-zero remote sha means a branch that does not exist on the remote yet, so there is no
    # previous state to diff against; compare with where it left the default branch instead.
    case "$remote_sha" in
        *[!0]*)
            RANGE="$remote_sha $local_sha"
            ;;
        *)
            BASE=$(git merge-base "$local_sha" "$DEFAULT_BRANCH" 2>/dev/null || true)
            if [ -n "$BASE" ]; then
                RANGE="$BASE $local_sha"
            else
                RANGE="$local_sha"
            fi
            ;;
    esac

    FILES=$(git diff --name-only --diff-filter=ACM $RANGE -- 'src/*.cs' 2>/dev/null || true)
    CHANGED=$(printf '%s\n%s' "$CHANGED" "$FILES")
done

# Run manually (no refs on stdin) and it falls back to everything this branch changed.
if [ "$READ_ANY" -eq 0 ]; then
    BASE=$(git merge-base HEAD "$DEFAULT_BRANCH" 2>/dev/null || true)
    if [ -n "$BASE" ]; then
        CHANGED=$(git diff --name-only --diff-filter=ACM "$BASE" HEAD -- 'src/*.cs' 2>/dev/null || true)
    fi
fi

CHANGED=$(printf '%s' "$CHANGED" | sed '/^$/d' | sort -u | tr '\n' ',')

if [ -z "$CHANGED" ]; then
    exit 0
fi

if [ -z "$PREDICTIONS_DEV_DB" ]; then
    echo "schema-check: skipped (PREDICTIONS_DEV_DB is not set)."
    exit 0
fi

if ! command -v dotnet > /dev/null 2>&1; then
    echo "schema-check: skipped (dotnet is not on PATH)."
    exit 0
fi

if ! git diff --quiet -- 'src/*.cs' 2>/dev/null; then
    echo "schema-check: note - src has uncommitted changes, and the check reads the working tree."
fi

set +e
OUTPUT=$(dotnet run --project "$ROOT/tools/ThePredictions.SchemaCheck" --verbosity quiet --nologo -- --root "$ROOT" --changed "$CHANGED" 2>&1)
STATUS=$?
set -e

# 0 = clean, 1 = a read cannot materialise, 2 = the tool could not run (no database, bad arguments).
if [ $STATUS -eq 0 ]; then
    exit 0
fi

if [ $STATUS -eq 2 ]; then
    echo "schema-check: skipped."
    echo "$OUTPUT" | sed 's/^/  /'
    exit 0
fi

echo ""
echo "schema-check FAILED - a Dapper read does not match the result set the database returns:"
echo ""
echo "$OUTPUT" | sed 's/^/  /'
echo ""
echo "This would throw at runtime, not at build time. Fix the SELECT or the result type, or push with"
echo "--no-verify if you know the finding is wrong (and please say why in tools/ThePredictions.SchemaCheck)."
echo ""

exit 1
