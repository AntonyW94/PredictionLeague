#!/bin/sh
#
# Checks the Dapper reads in staged C# files against the database's real result-set shapes, so a
# result-set mismatch is caught before it is committed rather than at runtime in production.
#
# Deliberately permissive about its own prerequisites: it skips when there is nothing to check, when
# dotnet is missing, or when the database cannot be reached. A hook that blocks committing on a train
# gets bypassed with --no-verify and then never runs again, so it only ever fails on a real finding.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
# Note: it inspects the working tree, not the staged snapshot, so a partially staged file is checked as
# it exists on disk.

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACM -- 'src/*.cs' | tr '\n' ',')

if [ -z "$STAGED" ]; then
    exit 0
fi

if [ -z "$PREDICTIONS_DEV_DB" ]; then
    echo "schema-check: skipped (PREDICTIONS_DEV_DB is not set)."
    exit 0
fi

if ! command -v dotnet > /dev/null 2>&1; then
    echo "schema-check: skipped (dotnet is not on PATH)."
    exit 0
fi

ROOT=$(git rev-parse --show-toplevel)

set +e
OUTPUT=$(dotnet run --project "$ROOT/tools/ThePredictions.SchemaCheck" --verbosity quiet --nologo -- --root "$ROOT" --changed "$STAGED" 2>&1)
STATUS=$?
set -e

# 0 = clean, 1 = a read cannot materialise, 2 = the tool could not run (no database, bad arguments).
if [ $STATUS -eq 0 ]; then
    exit 0
fi

if [ $STATUS -eq 2 ]; then
    echo "schema-check: skipped."
    echo "$OUTPUT" | sed 's/^/  /'
    exit 0
fi

echo ""
echo "schema-check FAILED - a Dapper read does not match the result set the database returns:"
echo ""
echo "$OUTPUT" | sed 's/^/  /'
echo ""
echo "This would throw at runtime, not at build time. Fix the SELECT or the result type, or commit with"
echo "--no-verify if you know the finding is wrong (and please say why in tools/ThePredictions.SchemaCheck)."
echo ""

exit 1
