<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.2.0" />
    <!-- Bumped from 5.2.2 (dbup-sqlserver 7.2.0 needs >= 6.1.4); pinned to the latest stable.
         This project is standalone (not referenced by the app), so the bump is isolated to the tooling. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migration set moved to the persistence adapter, which embeds it (the schema belongs to the
         adapter that speaks to it). This tool reads the scripts out of that assembly rather than
         carrying its own copy, so there is exactly one set of resource names and therefore one set of
         journal keys. -->
    <ProjectReference Include="..\..\src\ThePredictions.Persistence.SqlServer\ThePredictions.Persistence.SqlServer.csproj" />
  </ItemGroup>
</Project>
