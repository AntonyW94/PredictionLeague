<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            CompilerGeneratedAttribute is deliberately NOT excluded. Every async method body
            compiles into a state machine carrying that attribute, so excluding it hid the body of
            every async method in the solution - a handler with forty lines of branching reported as
            one coverable line (its constructor) and read as fully covered. GeneratedCodeAttribute
            still covers genuine tool output.
          -->
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <!--
            **/*.razor excludes the BuildRenderTree methods the Razor compiler generates from markup.
            Coverlet counts those as ~4,200 uncovered lines in Web.Client - roughly 95% of that
            project's coverable lines - which buried the real gaps everywhere else. Note this also
            excludes @code blocks, since they share the same file; component logic is untestable
            today anyway (no bUnit, no .razor.cs code-behind). Move logic to code-behind to measure it.
          -->
          <ExcludeByFile>**/*.g.cs,**/obj/**,**/*.razor,**/Program.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
