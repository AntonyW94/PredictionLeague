<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!-- Only include English satellite assemblies - excludes de, fr, es, zh-Hans, etc. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThePredictions.API\ThePredictions.API.csproj" />
        <ProjectReference Include="..\ThePredictions.Application\ThePredictions.Application.csproj" />
        <ProjectReference Include="..\ThePredictions.Contracts\ThePredictions.Contracts.csproj" />
        <ProjectReference Include="..\ThePredictions.Validators\ThePredictions.Validators.csproj" />
        <ProjectReference Include="..\ThePredictions.Web.Client\ThePredictions.Web.Client.csproj">
          <TreatAsUsed>true</TreatAsUsed>
        </ProjectReference>
        <!-- Supplies UseBlazorFrameworkFiles(), called in this project's Program.cs to serve the
             WebAssembly client. Previously reached transitively through Infrastructure, which does not
             use it: a data-access library should not be the reason the web host compiles. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.14" />
        <!-- CSS minifier, used by the MinifyCss inline task below. GeneratePathProperty exposes
             $(PkgNUglify) so the task can reference the assembly directly; PrivateAssets keeps it
             out of the published output, since it only ever runs at publish time. -->
        <PackageReference Include="NUglify" Version="1.22.3" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0">
          <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Serilog.Sinks.Datadog.Logs" Version="0.6.0">
          <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
    </ItemGroup>

    <!--
    CSS Bundling and Cache Busting for Production

    Development (dotnet run): Uses separate CSS files with @imports for easy debugging
    Production (dotnet publish): Bundles all CSS into one file with cache busting

    This target:
    1. Concatenates all CSS files in correct order, starting with the self-hosted Poppins font faces
    2. Minifies the result with NUglify
    3. Deletes individual CSS files and all pre-compressed copies (the webfonts under css/fonts/ and
       wwwroot/lib/ are left alone)
    4. Adds cache busting version to index.html

    Uses cross-platform C# inline tasks instead of platform-specific shell commands
    to ensure identical output on Windows (local publish) and Linux (CI/CD).
    -->
    <UsingTask TaskName="ConcatenateFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <OutputFile ParameterType="System.String" Required="true" />
            <Header ParameterType="System.String" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
var sb = new System.Text.StringBuilder();
if (!string.IsNullOrEmpty(Header))
{
    sb.AppendLine(Header);
}
foreach (var item in SourceFiles)
{
    var path = item.ItemSpec;
    if (System.IO.File.Exists(path))
    {
        sb.Append(System.IO.File.ReadAllText(path));
    }
    else
    {
        Log.LogWarning("CSS file not found: " + path);
    }
}
System.IO.File.WriteAllText(OutputFile, sb.ToString());
            ]]></Code>
        </Task>
    </UsingTask>

    <!--
    Minifies the bundled CSS. A real parser rather than a regex on purpose: hand-rolled CSS
    minification breaks quietly on calc() operator spacing and on data: URIs, and a broken
    stylesheet is a broken site. NUglify is the maintained fork of the Microsoft Ajax Minifier.

    Forward slashes in the Reference path deliberately - this runs on Linux in CI as well as on
    Windows locally. Any minifier error fails the build rather than writing a damaged stylesheet.
    -->
    <UsingTask TaskName="MinifyCss" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Reference Include="$(PkgNUglify)/lib/netstandard2.0/NUglify.dll" />
            <Code Type="Fragment" Language="cs"><![CDATA[
var original = System.IO.File.ReadAllText(FilePath);
var result = NUglify.Uglify.Css(original);

if (result.HasErrors)
{
    foreach (var error in result.Errors)
    {
        Log.LogError("CSS minification failed: " + error.ToString());
    }
}
else
{
    System.IO.File.WriteAllText(FilePath, result.Code);
    Log.LogMessage(
        Microsoft.Build.Framework.MessageImportance.High,
        string.Format(
            "CSS minified: {0:N0} -> {1:N0} bytes ({2:N1}% smaller)",
            original.Length,
            result.Code.Length,
            100.0 - (result.Code.Length * 100.0 / original.Length)));
}
            ]]></Code>
        </Task>
    </UsingTask>

    <UsingTask TaskName="ReplaceInFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
            <Find ParameterType="System.String" Required="true" />
            <ReplaceWith ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
var content = System.IO.File.ReadAllText(FilePath);
content = content.Replace(Find, ReplaceWith);
System.IO.File.WriteAllText(FilePath, content);
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="BundleCssAndAddCacheBusting" AfterTargets="Publish">
        <PropertyGroup>
            <CssVersion>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</CssVersion>
            <PublishWwwRoot>$(PublishDir)wwwroot\</PublishWwwRoot>
            <PublishCssDir>$(PublishWwwRoot)css\</PublishCssDir>
            <TargetCss>$(PublishCssDir)app.css</TargetCss>
            <IndexHtmlPath>$(PublishWwwRoot)index.html</IndexHtmlPath>
        </PropertyGroup>

        <Message Importance="high" Text="Bundling CSS files..." />

        <!-- Define CSS files in bundle order (matching @imports in app.css) -->
        <ItemGroup>
            <!-- Poppins font faces first: they must be declared before anything that uses them. -->
            <CssFilesToBundle Include="$(PublishCssDir)poppins.css" />
            <CssFilesToBundle Include="$(PublishCssDir)variables.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\typography.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\colours.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\borders.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\sizing.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\spacing.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\flex.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\display.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\position.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\overflow.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\cursor.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\animations.css" />
            <CssFilesToBundle Include="$(PublishCssDir)utilities\effects.css" />
            <CssFilesToBundle Include="$(PublishCssDir)layout\layout.css" />
            <CssFilesToBundle Include="$(PublishCssDir)layout\loading.css" />
            <CssFilesToBundle Include="$(PublishCssDir)layout\navbar.css" />
            <CssFilesToBundle Include="$(PublishCssDir)layout\section.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\card-base.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\team-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\match-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\member-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\round-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cards\match-editor-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\form-section.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\badges.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\filters.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\boosts.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\prize-scheme.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\detail-list.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\data-table.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\dashboard-prompts.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\season-pass-cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\page-hero.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\onboarding.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\payment-panel.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\payouts.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\buttons.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\carousel.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\forms.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\error-display.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\modals.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\rank-display.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\user-avatar.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\dashboard-tabs.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\footer.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\cookie-consent.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\prediction-split.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\incomplete-predictions.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\live-indicator.css" />
            <CssFilesToBundle Include="$(PublishCssDir)components\tp-badges.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\dashboard.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\home.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\leaderboard.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\predictions.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\prizes.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\tournament-structure.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\results-grid.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\boost-usage.css" />
            <CssFilesToBundle Include="$(PublishCssDir)pages\legal-page.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\layout.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\forms.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\cards.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\buttons.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\badges.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\tabs.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\light\match-editor.css" />
            <CssFilesToBundle Include="$(PublishCssDir)themes\dark\dark.css" />
            <CssFilesToBundle Include="$(PublishCssDir)app-base.css" />
        </ItemGroup>

        <!-- Concatenate all CSS files -->
        <!-- No Header: Poppins used to be pulled from fonts.googleapis.com here, which the
             Content-Security-Policy blocks and which leaked every visitor's IP to Google. It is now
             the first bundled file instead, with the woff2 files under css/fonts/ - a relative path
             that resolves the same from css/app.css whether bundled or imported. -->
        <ConcatenateFiles SourceFiles="@(CssFilesToBundle)" OutputFile="$(TargetCss)" />

        <MinifyCss FilePath="$(TargetCss)" />

        <!--
        Delete every individual CSS file and ALL pre-compressed copies, app.css.br and app.css.gz
        included. Those two used to be kept, but they are produced during publish from the pre-bundle
        app.css, so they have always described a file that no longer exists by the time this target
        finishes - and minifying makes them staler still. They are also unused: dev serves app.css
        with Content-Encoding gzip whose decompressed body is the full bundle, so the host compresses
        on the fly and never reads these. Deleting them removes the chance of a stale body being
        served if that ever changes.
        -->
        <ItemGroup>
            <CompressedCssToDelete Include="$(PublishCssDir)**\*.css.br" />
            <CompressedCssToDelete Include="$(PublishCssDir)**\*.css.gz" />
        </ItemGroup>
        <Delete Files="@(CssFilesToBundle)" />
        <Delete Files="@(CompressedCssToDelete)" />

        <!-- Remove empty CSS directories -->
        <RemoveDir Directories="$(PublishCssDir)utilities" Condition="Exists('$(PublishCssDir)utilities')" />
        <RemoveDir Directories="$(PublishCssDir)layout" Condition="Exists('$(PublishCssDir)layout')" />
        <RemoveDir Directories="$(PublishCssDir)components\cards" Condition="Exists('$(PublishCssDir)components\cards')" />
        <RemoveDir Directories="$(PublishCssDir)components" Condition="Exists('$(PublishCssDir)components')" />
        <RemoveDir Directories="$(PublishCssDir)pages" Condition="Exists('$(PublishCssDir)pages')" />
        <RemoveDir Directories="$(PublishCssDir)themes\light" Condition="Exists('$(PublishCssDir)themes\light')" />
        <RemoveDir Directories="$(PublishCssDir)themes\dark" Condition="Exists('$(PublishCssDir)themes\dark')" />
        <RemoveDir Directories="$(PublishCssDir)themes" Condition="Exists('$(PublishCssDir)themes')" />

        <Message Importance="high" Text="CSS bundled successfully!" />

        <!-- Add cache busting version to index.html -->
        <Message Importance="high" Text="Adding cache busting version: $(CssVersion)" />
        <ReplaceInFile FilePath="$(IndexHtmlPath)" Find="href=&quot;css/app.css&quot;" ReplaceWith="href=&quot;css/app.css?v=$(CssVersion)&quot;" />
        <ReplaceInFile FilePath="$(IndexHtmlPath)" Find="src=&quot;js/interop.js&quot;" ReplaceWith="src=&quot;js/interop.js?v=$(CssVersion)&quot;" />
        <ReplaceInFile FilePath="$(IndexHtmlPath)" Find="src=&quot;js/loading-theme.js&quot;" ReplaceWith="src=&quot;js/loading-theme.js?v=$(CssVersion)&quot;" />
        <ReplaceInFile FilePath="$(IndexHtmlPath)" Find="src=&quot;js/error-handlers.js&quot;" ReplaceWith="src=&quot;js/error-handlers.js?v=$(CssVersion)&quot;" />

        <Message Importance="high" Text="Cache busting complete. Version: $(CssVersion)" />
    </Target>
</Project>
