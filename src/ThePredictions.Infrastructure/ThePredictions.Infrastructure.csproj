<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- ReSharper disable once VulnerablePackage -->
        <PackageReference Include="brevo_csharp" Version="1.1.1" />
        <!-- Still needed by DapperUserStore and DapperRoleStore; leaves in phase 0c. -->
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
        <!-- AuthenticationTokenService uses JwtSecurityTokenHandler, so this project declares it rather
             than inheriting it. It previously arrived transitively through Microsoft.Data.SqlClient,
             which pulled Microsoft.IdentityModel.* at 8.x; when the persistence split removed that
             driver, System.IdentityModel.Tokens.Jwt fell back to 6.35.0 against
             Microsoft.IdentityModel.Tokens 8.14.0 and every JWT test failed with a TypeLoadException on
             the Microsoft.IdentityModel.Json.JsonConvert that 8.x deleted. Pinned to 8.15.0 to match
             ThePredictions.Web.Client, so both ends of the token round-trip agree. -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
        <PackageReference Include="Polly" Version="8.5.2" />
        <PackageReference Include="SkiaSharp" Version="4.150.1" />
        <PackageReference Include="Stripe.net" Version="52.1.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.3">
          <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Svg.Skia" Version="5.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Brand logos composited into the prediction share card (see ShareCardRenderer). Embedded
             so the framework-dependent publish always has them regardless of the web host layout. -->
        <EmbeddedResource Include="Assets\logo-header-dark.png" />
        <EmbeddedResource Include="Assets\logo-header-light.png" />
    </ItemGroup>

    <ItemGroup>
        <!-- Lets tests reach internal test seams, e.g. the time-zone id on UkEmailDateFormatter
             whose UTC fallback is otherwise unreachable. -->
        <InternalsVisibleTo Include="ThePredictions.Infrastructure.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThePredictions.Application\ThePredictions.Application.csproj" />
        <ProjectReference Include="..\ThePredictions.Contracts\ThePredictions.Contracts.csproj" />
    </ItemGroup>

</Project>
