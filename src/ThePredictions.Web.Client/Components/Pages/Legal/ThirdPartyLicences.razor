@page "/licences"

<PageTitle>Third-Party Licences - The Predictions</PageTitle>

<div class="legal-page">
    <article class="legal-page__content shadow">
        <h1>Open-Source Licences</h1>
        <p class="legal-page__updated">Last generated: @LastGenerated</p>

        <section>
            <p>
                The Predictions is built on open-source software. We are grateful to the maintainers of
                the packages below and acknowledge their licences. Each entry links to the project so you
                can read its full licence terms.
            </p>
            <p>
                This list covers the third-party packages distributed as part of the application. It is
                generated from the projects' NuGet package licence metadata; see the note at the foot of
                this page for how it is refreshed.
            </p>
        </section>

        <section>
            <h2>Packages</h2>
            <ul>
                @foreach (var package in Packages.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <li>
                        <strong>@package.Name</strong> @package.Version - @package.Licence
                        (<a href="@package.Url" target="_blank" rel="noopener noreferrer">project</a>)
                    </li>
                }
            </ul>
        </section>

        <section>
            <h2>How this list is maintained</h2>
            <p>
                The entries are taken from the <code>&lt;license&gt;</code> metadata in each package's
                <code>.nuspec</code> (the authoritative, author-declared licence). When a package is
                added, removed or upgraded, this list is regenerated from that metadata. Development-only
                and test-only packages are excluded because they are not distributed to users.
            </p>
        </section>
    </article>
</div>

@code {
