@inject LeagueDashboardStateService State
@inject IJSRuntime JsRuntime
@inject ILeagueService LeagueService
@inject IThemeService ThemeService

@implements IAsyncDisposable

@inherits BaseLeaderboardComponent

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Components.Pages.Boosts
@using ThePredictions.Web.Client.Services.Leagues
@using ThePredictions.Web.Client.Services.Theme

<div class="section">
    <h5 class="text-white fw-bold mb-3 text-center">Round Results</h5>

    @if (State.ViewableRounds.Any())
    {
        <div class="round-pill-selector mb-3" @ref="_roundPillContainerRef" role="tablist" aria-label="Select round">
            @foreach (var round in State.ViewableRounds.OrderBy(r => r.RoundNumber))
            {
                var isActive = round.Id == State.SelectedRoundId;
                <button class="round-pill @(isActive ? "active" : "")"
                        type="button"
                        role="tab"
                        aria-selected="@isActive.ToString().ToLower()"
                        @key="round.Id"
                        @onclick="() => SelectRound(round.Id)">
                    R@(round.RoundNumber)
                </button>
            }
        </div>
    }

    @if (CanShareSelectedRound)
    {
        <div class="d-flex justify-content-center mb-3">
            <button type="button" class="btn purple-button" @onclick="SharePredictionsAsync" disabled="@_isSharing">
                @if (_isSharing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Preparing...</span>
                }
                else
                {
                    <span class="bi bi-share-fill me-2"></span>
                    <span>Share my predictions</span>
                }
            </button>
        </div>
        @if (_shareMessage is not null)
        {
            <p class="text-center text-white-50 small mb-3">@_shareMessage</p>
        }
    }

    <ApiError Message="@State.RoundResultsError" />

    @if (State.IsLoadingRoundResults)
    {
        <p class="text-center text-white"><em>Loading results...</em></p>
    }
    else if (State.CurrentRoundResults.Any())
    {
        var selectedRound = State.ViewableRounds.FirstOrDefault(r => r.Id == State.SelectedRoundId);
        if (selectedRound != null)
        {
            <div class="d-none d-lg-block">
                <PredictionGrid Results="State.CurrentRoundResults"
                                Matches="State.CurrentRoundMatches"
                                DeadlineUtc="selectedRound.DeadlineUtc" />
            </div>

            <div class="d-lg-none">
                <div class="carousel-wrapper mobile-results-carousel">
                    <div class="carousel-container" @ontouchstart="HandleTouchStart" @ontouchmove="HandleTouchMove" @ontouchend="HandleTouchEnd">
                        <div class="carousel-track" style="@_trackStyle">
                            @foreach (var match in State.CurrentRoundMatches.OrderBy(m => m.MatchDateTimeUtc).ThenBy(m => m.HomeTeamShortName))
                            {
                                <div class="carousel-item-wrapper">
                                    <div class="carousel-item-content">
                                        <MobileMatchResultCard Match="match"
                                                               Results="State.CurrentRoundResults"
                                                               DeadlineUtc="selectedRound.DeadlineUtc" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="carousel-dots">
                        @for (var i = 0; i < State.CurrentRoundMatches.Count; i++)
                        {
                            var index = i;
                            <span class="carousel-dot @(index == _currentIndex ? "active" : "")" @onclick="() => GoToSlide(index)"></span>
                        }
                    </div>
                </div>

                <div class="card slide mt-4 mh-600 mx-auto">
                    <div class="header w-100">
                        <h6 class="text-white fw-bold mb-0 text-center">Round @(State.ViewableRounds.FirstOrDefault(r => r.Id == State.SelectedRoundId)?.RoundNumber) Points</h6>
                    </div>
                    <div class="body leaderboard-body">
                        <div class="table-responsive rounded">
                            <table class="leaderboard-table table-striped-purple light text-white">
                                <thead>
                                    <tr>
                                        <th class="rank-col fw-bold">#</th>
                                        <th class="player-name-col fw-bold">Player</th>
                                        <th class="points-col fw-bold">Points</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var player in State.CurrentRoundResults.OrderByDescending(p => p.TotalPoints))
                                    {
                                        <tr class="@(IsWinner(player) ? "overall-round-winner" : "") @(GetUserHighlightClass(player.UserId))">
                                            <td class="rank-col fw-bold">@player.Rank</td>
                                            <td class="player-name-col fw-bold">@player.PlayerName</td>
                                            <td class="points-col fw-bold">
                                                <SmallBoostAppliedIcon Player="player" DeadlineUtc="DeadlineUtc" />
                                                @player.TotalPoints
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center text-white-50">No results to display for this round.</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public int LeagueId { get; set; }

    private int _currentIndex;
    private string _trackStyle = "transform: translateX(0%);";
    private double _touchStartX;
    private ElementReference _roundPillContainerRef;
    private bool _pendingScrollIntoView;
    private bool _isSharing;
    private string? _shareMessage;

    // Only offer the share button when the current user actually appears in the selected round's
    // results - i.e. they took part, so the share-card endpoint has predictions to render.
    private bool CanShareSelectedRound =>
        State.SelectedRoundId is not null
        && !string.IsNullOrEmpty(CurrentUserId)
        && State.CurrentRoundResults.Any(p => p.UserId == CurrentUserId);

    // Fetches a server-rendered PNG of the current user's predictions for the selected round and
    // hands it to the native share sheet (Web Share API), falling back to a download on browsers
    // without file sharing. The card is rendered in the user's active theme.
    private async Task SharePredictionsAsync()
    {
        if (_isSharing || State.SelectedRoundId is not { } roundId)
            return;

        _isSharing = true;
        _shareMessage = null;

        try
        {
            var image = await LeagueService.GetShareCardAsync(roundId, ThemeService.CurrentTheme);

            if (image is null || image.Length == 0)
            {
                _shareMessage = "You have no predictions to share for this round.";
                return;
            }

            var base64 = Convert.ToBase64String(image);
            var fileName = $"predictions-round-{roundId}.png";
            var roundNumber = State.ViewableRounds.FirstOrDefault(r => r.Id == roundId)?.RoundNumber;
            var shareText = roundNumber is { } number ? $"My Round {number} predictions" : "My predictions";

            await JsRuntime.InvokeAsync<string>("blazorInterop.sharePredictions", base64, fileName, "My Predictions", shareText);
        }
        catch
        {
            _shareMessage = "Could not prepare the share image. Please try again.";
        }
        finally
        {
            _isSharing = false;
        }
    }

    private DateTime? DeadlineUtc => State.ViewableRounds.FirstOrDefault(r => r.Id == State.SelectedRoundId.GetValueOrDefault())?.DeadlineUtc;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        State.OnStateChange += StateHasChanged;
        _pendingScrollIntoView = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && State.CurrentRoundMatches.Any())
        {
            SetDefaultCarouselSlide();
            await InvokeAsync(StateHasChanged);
        }

        if (_pendingScrollIntoView && State.ViewableRounds.Any())
        {
            _pendingScrollIntoView = false;
            await JsRuntime.InvokeVoidAsync("blazorInterop.scrollActiveRoundIntoView", _roundPillContainerRef, firstRender ? false : true);
        }
    }

    private async Task SelectRound(int roundId)
    {
        if (State.SelectedRoundId == roundId)
            return;

        await State.LoadRoundResults(LeagueId, roundId);
        SetDefaultCarouselSlide();
        _pendingScrollIntoView = true;
    }

    private void SetDefaultCarouselSlide()
    {
        var matches = State.CurrentRoundMatches;
        if (!matches.Any())
        {
            _currentIndex = 0;
            UpdateTrackStyle();
            return;
        }

        var inProgressIndex = matches.FindIndex(m => m.Status == MatchStatus.InProgress);
        if (inProgressIndex != -1)
        {
            _currentIndex = inProgressIndex;
            UpdateTrackStyle();
            return;
        }

        var scheduledIndex = matches.FindIndex(m => m.Status == MatchStatus.Scheduled);
        if (scheduledIndex != -1)
        {
            _currentIndex = scheduledIndex;
            UpdateTrackStyle();
            return;
        }

        _currentIndex = 0;
        UpdateTrackStyle();
    }

    private bool IsWinner(PredictionResultDto player)
    {
        if (!State.CurrentRoundResults.Any() || State.CurrentRoundResults.All(p => p.TotalPoints == 0))
            return false;

        return player.Rank == 1;
    }

    private void HandleTouchStart(TouchEventArgs e) => _touchStartX = e.Touches[0].ClientX;
    private static void HandleTouchMove(TouchEventArgs e) { }
    private void HandleTouchEnd(TouchEventArgs e)
    {
        var touchEndX = e.ChangedTouches[0].ClientX;
        var diffX = _touchStartX - touchEndX;

        if (!(Math.Abs(diffX) > 50))
            return;

        if (diffX > 0)
        {
            if (_currentIndex >= State.CurrentRoundMatches.Count - 1)
                return;

            _currentIndex++;
        }
        else
        {
            if (_currentIndex <= 0)
                return;

            _currentIndex--;
        }

        UpdateTrackStyle();
    }

    private void GoToSlide(int index)
    {
        _currentIndex = index;
        UpdateTrackStyle();
    }

    private void UpdateTrackStyle()
    {
        _trackStyle = $"transform: translateX(-{_currentIndex * 100}%);";
    }

    public ValueTask DisposeAsync()
    {
        State.OnStateChange -= StateHasChanged;
        return ValueTask.CompletedTask;
    }
}