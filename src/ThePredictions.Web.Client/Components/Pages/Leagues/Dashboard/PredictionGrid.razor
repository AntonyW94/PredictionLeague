@inherits BaseLeaderboardComponent

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Admin.Rounds
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Components.Pages.Boosts

@if (Results != null && Matches != null)
{
    var orderedMatches = Matches.OrderBy(m => m.MatchDateTimeUtc).ThenBy(m => m.HomeTeamShortName).ThenBy(m => m.MatchNumber).ToList();
    var orderedPlayers = Results.OrderBy(p => p.Rank).ThenBy(p => p.PlayerName).ToList();
    var winnerPoints = Results.Any() ? Results.Max(p => p.TotalPoints) : 0;
    var hasWinner = orderedPlayers.Any() && winnerPoints > 0;

    <div class="results-grid-container">
        <table class="results-grid">
            <thead>
                <tr>
                    <th class="player-col">Player</th>
                    <th class="total-col">Total</th>
                    @foreach (var match in orderedMatches)
                    {
                        var homeConfirmed = match.HomeTeamId.HasValue;
                        var awayConfirmed = match.AwayTeamId.HasValue;
                        var areTeamsConfirmed = homeConfirmed && awayConfirmed;
                        <th class="match-col">
                            <div class="match-col-teams">
                                @if (homeConfirmed)
                                {
                                    <img src="@match.HomeTeamLogoUrl" class="match-logo-tiny" alt="@match.HomeTeamName" />
                                }
                                else
                                {
                                    <span class="match-logo-tiny match-logo-placeholder" title="Team to be decided">?</span>
                                }
                                <span class="match-col-abbr">@(homeConfirmed ? match.HomeTeamAbbreviation : "TBD") v @(awayConfirmed ? match.AwayTeamAbbreviation : "TBD")</span>
                                @if (awayConfirmed)
                                {
                                    <img src="@match.AwayTeamLogoUrl" class="match-logo-tiny" alt="@match.AwayTeamName" />
                                }
                                else
                                {
                                    <span class="match-logo-tiny match-logo-placeholder" title="Team to be decided">?</span>
                                }
                            </div>
                            <div class="match-col-actual">
                                @if (areTeamsConfirmed)
                                {
                                    <MatchStatusBadge Status="match.Status"
                                                      HomeScore="match.ActualHomeTeamScore"
                                                      AwayScore="match.ActualAwayTeamScore"
                                                      MatchDateTimeUtc="match.MatchDateTimeUtc" />
                                }
                                else
                                {
                                    <span class="match-col-tbc-label">TBC</span>
                                }
                            </div>
                            <MatchPredictionSplit Match="match"
                                                  Results="Results"
                                                  DeadlineUtc="DeadlineUtc"
                                                  UserChoice="@PredictionSplitChoice.For(Results, CurrentUserId, match.Id)" />
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var player in orderedPlayers)
                {
                    var isWinner = hasWinner && player.TotalPoints == winnerPoints;
                    var rowClasses = $"{(isWinner ? "winner-row" : string.Empty)} {GetUserHighlightClass(player.UserId)}".Trim();

                    <tr class="@rowClasses">
                        <td class="player-col">
                            <div class="player-cell">
                                <span class="player-rank">@player.Rank</span>
                                <span class="player-name">@player.PlayerName</span>
                                <SmallBoostAppliedIcon Player="player" DeadlineUtc="DeadlineUtc" />
                            </div>
                        </td>
                        <td class="total-col score-cell">@player.TotalPoints</td>
                        @foreach (var match in orderedMatches)
                        {
                            var prediction = player.Predictions.FirstOrDefault(p => p.MatchId == match.Id);
                            var matchTeamsConfirmed = match.HomeTeamId.HasValue && match.AwayTeamId.HasValue;
                            <td class="match-col score-cell">
                                @if (!matchTeamsConfirmed)
                                {
                                    <span class="not-predicted-icon" title="Teams not yet decided">&mdash;</span>
                                }
                                else if (prediction?.HomeScore != null || prediction?.AwayScore != null)
                                {
                                    @if (prediction.IsHidden)
                                    {
                                        <span class="blurred-score" title="Predictions are hidden until the deadline.">0 - 0</span>
                                    }
                                    else if (match.Status == MatchStatus.Scheduled)
                                    {
                                        <span>@prediction.HomeScore - @prediction.AwayScore</span>
                                    }
                                    else
                                    {
                                        <PredictionStatusBadge Status="match.Status"
                                                               HomeScore="prediction.HomeScore"
                                                               AwayScore="prediction.AwayScore"
                                                               Outcome="prediction.Outcome" />
                                    }
                                }
                                else
                                {
                                    @if (!player.HasPredicted && (match.CustomLockTimeUtc ?? DeadlineUtc) < DateTime.UtcNow)
                                    {
                                        <span class="not-predicted-icon text-red bi bi-x-circle-fill" title="No predictions submitted"></span>
                                    }
                                    else
                                    {
                                        <span class="bi bi-clock-fill not-predicted-icon" title="No prediction submitted."></span>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<PredictionResultDto>? Results { get; set; }
    [Parameter, EditorRequired] public List<MatchInRoundDto>? Matches { get; set; }
    [Parameter, EditorRequired] public DateTime DeadlineUtc { get; set; }
}
