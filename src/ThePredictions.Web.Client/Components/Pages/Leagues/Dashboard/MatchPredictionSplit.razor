@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Admin.Rounds

@if (_show)
{
    <PredictionSplitBar Home="_home" Draw="_draw" Away="_away" UserChoice="UserChoice" />
}

@code {
    [Parameter, EditorRequired] public MatchInRoundDto Match { get; set; } = null!;
    [Parameter, EditorRequired] public List<PredictionResultDto> Results { get; set; } = null!;
    [Parameter, EditorRequired] public DateTime DeadlineUtc { get; set; }

    // The logged-in user's own pick ("H"/"D"/"A"), supplied by the parent component which owns the
    // results data and the resolved current-user id. Bolds that count in the split.
    [Parameter] public string? UserChoice { get; set; }

    private int _home;
    private int _draw;
    private int _away;
    private bool _show;

    protected override void OnParametersSet()
    {
        _home = 0;
        _draw = 0;
        _away = 0;

        var teamsConfirmed = Match.HomeTeamId.HasValue && Match.AwayTeamId.HasValue;
        var deadlinePassed = DeadlineUtc < DateTime.UtcNow;

        if (!teamsConfirmed || !deadlinePassed)
        {
            _show = false;
            return;
        }

        foreach (var player in Results)
        {
            var prediction = player.Predictions.FirstOrDefault(p => p.MatchId == Match.Id);

            if (prediction?.HomeScore == null || prediction.AwayScore == null || prediction.IsHidden)
                continue;

            if (prediction.HomeScore > prediction.AwayScore)
                _home++;
            else if (prediction.HomeScore < prediction.AwayScore)
                _away++;
            else
                _draw++;
        }

        _show = _home + _draw + _away > 0;
    }
}
