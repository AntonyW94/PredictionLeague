@inject HttpClient Http
@inject LeagueDashboardStateService State
@inject IJSRuntime JsRuntime

@using System.Net.Http.Json
@using ThePredictions.Contracts.Admin.Rounds
@using ThePredictions.Contracts.Rounds
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Services.Leagues

@if (_activeRoundId.HasValue && _completion != null && _incomplete.Any())
{
    <div class="col-12 mb-4">
        <div class="section w-100">
        <h5 class="text-white fw-bold mb-3 text-center">Incomplete Predictions</h5>
        <p class="text-white-50 small mb-3 text-center">@_completion.RoundName</p>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_completion.CanSendReminders && !_completion.DeadlinePassed)
        {
            <div class="d-flex justify-content-center mb-3">
                <button class="btn btn-sm blue-light-button" disabled="@_isSending" @onclick="RemindAll">
                    @if (_isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <span class="bi bi-envelope-fill me-1"></span>
                    }
                    <span>Remind all</span>
                </button>
            </div>
        }

        <div class="incomplete-predictions">
                @foreach (var player in _incomplete)
                {
                    var remindedRecently = player.LastRemindedUtc.HasValue
                        && (DateTime.UtcNow - player.LastRemindedUtc.Value) < TimeSpan.FromHours(6);
                    <div class="incomplete-predictions__row">
                        <div class="incomplete-predictions__player">
                            <UserAvatar FullName="@player.PlayerName" />
                            <div class="incomplete-predictions__details">
                                <span class="text-white fw-bold">@player.PlayerName</span>
                                <small class="text-white-50">Missing: @string.Join(", ", player.MissingFixtures.Select(f => $"{f.HomeTeam} v {f.AwayTeam}"))</small>
                            </div>
                        </div>
                        <div class="incomplete-predictions__actions">
                            @if (player.HasEnteredNothing)
                            {
                                <span class="member-status-pill member-status-pending">None (@player.PredictedCount/@_completion.PredictableMatchCount)</span>
                            }
                            else
                            {
                                <span class="member-status-pill member-status-pending">Partial (@player.PredictedCount/@_completion.PredictableMatchCount)</span>
                            }
                            @if (_completion.CanSendReminders && !_completion.DeadlinePassed)
                            {
                                @if (remindedRecently)
                                {
                                    <span class="text-white-50 small" title="Reminded at @player.LastRemindedUtc!.Value.ToLocalTime().ToString("dd MMM HH:mm")">Reminded</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm blue-light-button text-nowrap" disabled="@_isSending" @onclick="() => RemindPlayer(player)">
                                        <span class="bi bi-envelope-fill me-1"></span>Remind
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int LeagueId { get; set; }

    private int? _activeRoundId;
    private RoundCompletionDto? _completion;
    private List<RoundCompletionPlayerDto> _incomplete = [];
    private bool _isSending;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        _activeRoundId = ResolveActiveRoundId();

        if (_activeRoundId.HasValue)
            await LoadAsync();
    }

    private int? ResolveActiveRoundId()
    {
        // Only chase a round that has opened for predictions but has not itself kicked off: Published
        // with a deadline still in the future. If any round is currently in progress (matches being
        // played) the tile is hidden entirely - so an in-progress previous round suppresses it, but
        // the very first round of a season still shows while it is open and not yet under way.
        var anyRoundInProgress = State.ViewableRounds.Any(r => r.Status == RoundStatus.InProgress);
        if (anyRoundInProgress)
            return null;

        var nextOpenRound = State.ViewableRounds
            .Where(r => r.Status == RoundStatus.Published && r.DeadlineUtc > DateTime.UtcNow)
            .OrderBy(r => r.RoundNumber)
            .FirstOrDefault();

        return nextOpenRound?.Id;
    }

    private async Task LoadAsync()
    {
        try
        {
            _completion = await Http.GetFromJsonAsync<RoundCompletionDto>(
                $"api/leagues/{LeagueId}/rounds/{_activeRoundId}/completion");

            _incomplete = _completion?.Players.Where(p => p.MissingCount > 0).ToList() ?? [];
        }
        catch (Exception)
        {
            _errorMessage = "Could not load prediction completion. Please try again later.";
        }
    }

    private async Task RemindPlayer(RoundCompletionPlayerDto player)
    {
        await SendRemindersAsync([player.UserId]);
    }

    private async Task RemindAll()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Send a prediction reminder to {_incomplete.Count} player(s) in this league?");
        if (!confirmed)
            return;

        await SendRemindersAsync(_incomplete.Select(p => p.UserId).ToList());
    }

    private async Task SendRemindersAsync(List<string> userIds)
    {
        _isSending = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/leagues/{LeagueId}/rounds/{_activeRoundId}/reminders",
                new SendPredictionRemindersRequest(userIds));

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SendPredictionRemindersResultDto>();
                _successMessage = BuildResultMessage(result);
                await LoadAsync();
            }
            else
            {
                // Most likely the deadline passed after the page loaded - the server refuses the send.
                // Reload so the completion reflects the passed deadline and the Remind controls hide.
                _errorMessage = "Could not send reminders. The prediction deadline may have passed.";
                await LoadAsync();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Could not send reminders. The prediction deadline may have passed.";
        }
        finally
        {
            _isSending = false;
        }
    }

    private static string BuildResultMessage(SendPredictionRemindersResultDto? result)
    {
        if (result == null)
            return "Reminders processed.";

        var message = $"Sent {result.SentCount} reminder(s).";
        if (result.SkippedRecentlyRemindedCount > 0)
            message += $" {result.SkippedRecentlyRemindedCount} skipped (reminded recently).";
        if (result.SkippedNoLongerMissingCount > 0)
            message += $" {result.SkippedNoLongerMissingCount} skipped (no longer missing).";

        return message;
    }
}
