@inject LeagueDashboardStateService State

@implements IDisposable

@inherits BaseLeaderboardComponent

@using ThePredictions.Contracts.Leaderboards
@using ThePredictions.Web.Client.Services.Leagues

<div class="section w-100 mh-600">
    <h5 class="text-white fw-bold mb-3 text-center">Overall Leaderboard</h5>
    <div class="body no-padding justify-start">
        @if (State.IsLoadingOverallLeaderboard)
        {
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border text-white" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(State.OverallLeaderboardError))
        {
            <div class="p-3">
                <ApiError Message="@State.OverallLeaderboardError" />
            </div>
        }
        else if (State.OverallLeaderboard.Any())
        {
            <div class="table-responsive rounded">
                <table class="leaderboard-table table-striped-purple text-white">
                    <thead>
                        <tr>
                            @if (State.OverallLeaderboard.First().IsRoundInProgress && State.OverallLeaderboard.First().SnapshotRank.HasValue)
                            {
                                <th class="rank-change-col"></th>
                            }
                            <th class="rank-col">#</th>
                            <th class="player-name-col">Player</th>
                            <th class="points-col">Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in State.OverallLeaderboard)
                        {
                            <tr class="@(GetUserHighlightClass(entry.UserId)) @entry.UserId">
                                @if (entry.IsRoundInProgress && entry.SnapshotRank.HasValue)
                                {
                                    <td class="rank-change-col">
                                        <RankChangeArrow PreviousRank="@entry.SnapshotRank"
                                                         CurrentRank="@entry.Rank"
                                                         IsVisible="@entry.IsRoundInProgress" />
                                    </td>
                                }
                                <td class="rank-col"><span class="fw-bold">@entry.Rank</span></td>
                                <td class="player-name-col fw-bold">@entry.PlayerName</td>
                                <td class="points-col fw-bold">@entry.TotalPoints</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-white-50 mt-4">No predictions have been scored yet.</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public int LeagueId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        State.OnStateChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnStateChange -= StateHasChanged;
    }
}
