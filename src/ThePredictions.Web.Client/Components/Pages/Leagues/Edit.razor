@page "/leagues/{LeagueId:int}/edit"

@attribute [Authorize]

@inject HttpClient Http
@inject IJSRuntime JS

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Boosts
@using ThePredictions.Contracts.Prizes

<PageTitle>Edit League</PageTitle>

<div class="page-container admin-light">
    @if (_model == null)
    {
        <p class="text-center"><em>Loading...</em></p>
    }
    else
    {
        <BaseFormComponent TModel="UpdateLeagueRequest"
                           Model="_model"
                           ContainerClass="wide"
                           SubmitAction="HandleUpdateLeagueAsync"
                           SuccessRedirectUrl="/leagues"
                           BackUrl="/leagues"
                           SuccessAlertMessage="League updated successfully!"
                           BusyText="Saving..."
                           IsSaveDisabled="_isPastDeadline">
            <Header>
                <h3 class="text-center fw-bold mb-4">Edit League</h3>
            </Header>
            <ChildContent>
                    @if (_isPastDeadline)
                    {
                        <div class="message-box-solid warning mb-4">
                            This league cannot be edited because the entry deadline has passed.
                        </div>
                    }

                    <FormSection Title="League details" ShowDivider="false">
                    <div class="mb-3">
                        <label class="form-label">Season</label>
                        <div class="form-value">@_seasonName</div>
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label">League Name</label>
                        <InputText id="name" class="form-control" @bind-Value="_model.Name" disabled="@_isPastDeadline" />
                        <StyledValidationMessage For="@(() => _model.Name)" />
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <InputCheckbox id="requiresApproval" class="form-check-input" @bind-Value="_model.RequiresMemberApproval" disabled="@_isPastDeadline" />
                            <label class="form-check-label" for="requiresApproval">Require approval for players to join</label>
                        </div>
                        <div class="form-text text-white-50">When off, anyone who joins is accepted automatically - no approval needed. You can change this at any time.</div>
                    </div>

                    @if (_entryCodeForDisplay != "Public")
                    {
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <InputCheckbox id="isListed" class="form-check-input" @bind-Value="_model.IsListed" disabled="@_isPastDeadline" />
                                <label class="form-check-label" for="isListed">Show this league in Available Leagues</label>
                            </div>
                            <div class="form-text text-white-50">Players can see the league exists, but still need the entry code to join. Member names stay hidden.</div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label">Entry Fee (£)</label>
                            <InputNumber id="price" class="form-control" @bind-Value="_model.Price" disabled="@_isPriceLocked" />
                            @if (_isPriceLocked && !_isPastDeadline)
                            {
                                <small class="form-text text-muted">Cannot be changed after members have joined.</small>
                            }
                            <StyledValidationMessage For="@(() => _model.Price)" />
                        </div>
                        @if (_canEditPrizes)
                        {
                            <div class="col-md-6 mb-3">
                                <label for="prizeFundOverride" class="form-label">Add your own money to the pot (£)</label>
                                <InputNumber id="prizeFundOverride" class="form-control" @bind-Value="_model.PrizeFundOverride" placeholder="0" />
                                <div class="form-text text-white-50">Optional. Sits on top of the entry fees.</div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="entryDeadline" class="form-label">Entry Deadline</label>
                            <UtcInputDate id="entryDeadline"
                                          @bind-Value="_model.EntryDeadlineUtc"
                                          Class="form-control"
                                          Disabled="@_isPastDeadline" />
                            <StyledValidationMessage For="@(() => _model.EntryDeadlineUtc)" />
                        </div>
                        @if (_entryCodeForDisplay != "Public")
                        {
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Entry Code</label>
                                <div class="entry-code-display">
                                    <div class="pin-digits">
                                        @foreach (var ch in _entryCodeForDisplay!)
                                        {
                                            <span class="pin-digit">@ch</span>
                                        }
                                    </div>
                                    <button type="button" class="entry-code-copy @(_codeCopied ? "is-copied" : string.Empty)" @onclick="CopyEntryCodeAsync" title="Copy entry code">
                                        <span class="bi @(_codeCopied ? "bi-check-lg" : "bi-clipboard")"></span>
                                        <span>@(_codeCopied ? "Copied" : "Copy")</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    </FormSection>

                    <FormSection Title="Scoring">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="pointsForExactScore" class="form-label">Points for Exact Score</label>
                            <InputNumber id="pointsForExactScore" class="form-control" @bind-Value="_model.PointsForExactScore" disabled="@_isScoringLocked" />
                            @if (_isScoringLocked && !_isPastDeadline)
                            {
                                <small class="form-text text-muted">Cannot be changed after members have joined.</small>
                            }
                            <StyledValidationMessage For="@(() => _model.PointsForExactScore)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="pointsForCorrectResult" class="form-label">Points for Correct Result</label>
                            <InputNumber id="pointsForCorrectResult" class="form-control" @bind-Value="_model.PointsForCorrectResult" disabled="@_isScoringLocked" />
                            @if (_isScoringLocked && !_isPastDeadline)
                            {
                                <small class="form-text text-muted">Cannot be changed after members have joined.</small>
                            }
                            <StyledValidationMessage For="@(() => _model.PointsForCorrectResult)" />
                        </div>
                    </div>
                    </FormSection>

                    @if (_league is not null)
                    {
                        @if (_league.HasPrizeScheme)
                        {
                            <FormSection Title="Prizes & boosts" Intro="Prizes and boosts are locked once set.">
                                <PrizeBreakdownPreview Breakdown="_lockedBreakdown" PotLabel="Projected prize pot" />
                            </FormSection>
                        }
                        else if (!_isPastDeadline)
                        {
                            @* Prizes only apply when there is money in the pot. Boosts always apply, so they stay. *@
                            @if (_hasPrizeFund)
                            {
                                <PrizeSchemeEditor Scheme="_scheme"
                                                   SeasonId="_league.SeasonId"
                                                   Price="_model.Price"
                                                   IsTournament="_league.IsTournament"
                                                   CurrentEntrants="_league.MemberCount"
                                                   PrizeFundOverride="_model.PrizeFundOverride" />
                            }
                            else
                            {
                                <FormSection Title="Prizes" Intro="This is a free league, so there are no prizes.">
                                    <div class="message-box-solid info">
                                        Set an entry fee or add your own money to the pot to configure prizes.
                                    </div>
                                </FormSection>
                            }
                            <LeagueBoostSelector Selections="_boostSelections" />
                            <p class="form-text text-white-50 form-section-note">@(_hasPrizeFund ? "Prizes & boosts can only be set once, then they lock." : "Boosts can only be set once, then they lock.")</p>
                        }
                    }

                    @if (_model.Price > 0 && !_isPastDeadline)
                    {
                        <LeagueBankDetailsFields Model="_model" />
                    }

            </ChildContent>
        </BaseFormComponent>
    }
</div>

@code {
    [Parameter] public int LeagueId { get; set; }
    private UpdateLeagueRequest? _model;
    private LeagueDto? _league;
    private PrizeSchemeRequest _scheme = new();
    private readonly List<LeagueBoostSelectionDto> _boostSelections = new();
    private PrizeBreakdownDto? _lockedBreakdown;
    private string? _entryCodeForDisplay;
    private string? _seasonName;
    private bool _isPastDeadline;
    private bool _isPriceLocked;
    private bool _isScoringLocked;
    private bool _codeCopied;

    // Prizes (and so the admin top-up) are editable only while the scheme is unset and entries are open.
    private bool _canEditPrizes => _league is { HasPrizeScheme: false } && !_isPastDeadline;

    // Prizes only apply when there is money in the pot: entry fees and/or the admin top-up.
    // Re-evaluates live as the admin edits the entry fee or the top-up, so the editor appears/disappears.
    private bool _hasPrizeFund => _model is not null && (_model.Price > 0 || (_model.PrizeFundOverride ?? 0) > 0);

    private async Task CopyEntryCodeAsync()
    {
        if (string.IsNullOrEmpty(_entryCodeForDisplay))
            return;

        _codeCopied = await JS.InvokeAsync<bool>("blazorInterop.copyText", _entryCodeForDisplay);
        if (!_codeCopied)
            return;

        StateHasChanged();
        await Task.Delay(2000);
        _codeCopied = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var league = await Http.GetFromJsonAsync<LeagueDto>($"api/leagues/{LeagueId}");
        if (league != null)
        {
            _league = league;
            _model = new UpdateLeagueRequest
            {
                Name = league.Name,
                Price = league.Price,
                EntryDeadlineUtc = league.EntryDeadlineUtc,
                PointsForExactScore = league.PointsForExactScore,
                PointsForCorrectResult = league.PointsForCorrectResult,
                RequiresMemberApproval = league.RequiresMemberApproval,
                IsListed = league.IsListed
            };
            _entryCodeForDisplay = league.EntryCode;
            _seasonName = league.SeasonName;
            _isPastDeadline = league.EntryDeadlineUtc < DateTime.UtcNow;
            _isPriceLocked = league.MemberCount > 1;
            _isScoringLocked = league.MemberCount > 1;

            if (league.HasPrizeScheme)
                _lockedBreakdown = await Http.GetFromJsonAsync<PrizeBreakdownDto>($"api/leagues/{LeagueId}/prize-breakdown");

            // Pre-fill any existing (decrypted) bank details so saving the form doesn't clear them.
            if (league.Price > 0)
            {
                var bankDetails = await Http.GetFromJsonAsync<LeagueBankDetailsDto>($"api/leagues/{LeagueId}/bank-details");
                if (bankDetails != null)
                {
                    _model.BankAccountName = bankDetails.BankAccountName;
                    _model.BankSortCode = bankDetails.BankSortCode;
                    _model.BankAccountNumber = bankDetails.BankAccountNumber;
                    _model.PaymentReferenceTemplate = bankDetails.PaymentReferenceTemplate;
                }
            }
        }
    }

    private async Task<HttpResponseMessage> HandleUpdateLeagueAsync()
    {
        var response = await Http.PutAsJsonAsync($"api/leagues/{LeagueId}/update", _model);
        if (!response.IsSuccessStatusCode)
            return response;

        // Set the prize scheme / boosts once, only on a schemeless league.
        if (_league is { HasPrizeScheme: false })
        {
            if ((_model!.Price > 0 || (_model.PrizeFundOverride ?? 0) > 0) && _scheme.Categories.Any())
                await Http.PutAsJsonAsync($"api/leagues/{LeagueId}/prize-scheme", _scheme);

            var enabledBoosts = _boostSelections.Where(b => b.IsEnabled).ToList();
            if (enabledBoosts.Any())
                await Http.PutAsJsonAsync($"api/boosts/league/{LeagueId}/rules", new SetLeagueBoostRulesRequest { Selections = enabledBoosts });
        }

        return response;
    }
}