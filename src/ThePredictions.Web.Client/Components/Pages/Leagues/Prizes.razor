@page "/leagues/{LeagueId:int}/prizes"

@attribute [Authorize]

@inject HttpClient Http
@inject NavigationManager NavigationManager

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Prizes
@using ThePredictions.Domain.Common.Enumerations
@using System.Globalization

<PageTitle>Prizes - @_pageData?.LeagueName</PageTitle>

<div class="page-container admin-light">
    <div class="form-container extra-wide">
        @if (_isLoading)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_pageData != null)
        {
            var entriesOpen = DateTime.UtcNow < _pageData.EntryDeadlineUtc;

            <div class="admin-light-header">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <button type="button" class="btn red-button d-flex align-items-center" @onclick="Back">
                        <span class="bi bi-arrow-left-circle-fill me-2"></span>Back
                    </button>
                </div>

                <div class="prize-hero">
                    <span class="bi bi-trophy-fill prize-hero-icon"></span>
                    <h3 class="fw-bold mb-1">
                        @(_pageData.PrizeSettings.Any() ? "Confirmed Winnings" : "Prize Structure")
                    </h3>
                    <p class="prize-hero-league">@_pageData.LeagueName</p>
                    @if (_pageData.PrizeSettings.Any())
                    {
                        <div class="prize-hero-total">
                            @((_pageData.PrizeSettings.Sum(p => p.PrizeAmount)).ToString("C", new CultureInfo("en-GB")))
                        </div>
                        <p class="prize-hero-subtitle">Total Prize Pool</p>
                    }
                </div>
            </div>

            <ApiError Message="@_errorMessage" />

            @if (_pageData.PrizeSettings.Any())
            {
                <div class="card-grid">
                    <div class="card w-100">
                        <div class="header">
                            <h5 class="text-center fw-bold mb-0">Overall Prizes</h5>
                        </div>
                        <div class="body">
                            @foreach (var prize in _pageData.PrizeSettings.Where(p => p.PrizeType == PrizeType.Overall).OrderBy(p => p.Rank))
                            {
                                <div class="prize-row prize-row--placement">
                                    <div class="prize-medal @GetMedalClass(prize.Rank)">
                                        <span class="bi bi-trophy-fill"></span>
                                    </div>
                                    <span class="prize-description">@prize.Rank<span>@FormattingUtilities.GetOrdinal(prize.Rank)</span><span class="d-none d-md-inline"> Place</span></span>
                                    <span class="prize-amount">@prize.PrizeAmount.ToString("C", new CultureInfo("en-GB"))</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card w-100">
                        <div class="header">
                            <h5 class="text-center fw-bold mb-0">Other Prizes</h5>
                        </div>
                        <div class="body">
                            @foreach (var prize in _pageData.PrizeSettings.Where(p => p.PrizeType == PrizeType.Round))
                            {
                                <div class="prize-row">
                                    <div class="prize-icon"><span class="bi bi-calendar3-event"></span></div>
                                    <span class="prize-description">Round<span class="d-none d-md-inline">&nbsp;Winner</span></span>
                                    <span class="prize-amount">@prize.PrizeAmount.ToString("C", new CultureInfo("en-GB"))</span>
                                </div>
                            }
                            @foreach (var prize in _pageData.PrizeSettings.Where(p => p.PrizeType == PrizeType.Monthly))
                            {
                                <div class="prize-row">
                                    <div class="prize-icon"><span class="bi bi-calendar-month"></span></div>
                                    <span class="prize-description">Monthly<span class="d-none d-md-inline">&nbsp;Winner</span></span>
                                    <span class="prize-amount">@prize.PrizeAmount.ToString("C", new CultureInfo("en-GB"))</span>
                                </div>
                            }
                            @foreach (var prize in _pageData.PrizeSettings.Where(p => p.PrizeType == PrizeType.Stages).OrderBy(p => p.Stage).ThenBy(p => p.Rank))
                            {
                                <div class="prize-row">
                                    <div class="prize-icon"><span class="bi bi-diagram-3-fill"></span></div>
                                    <span class="prize-description">@prize.Stage - @prize.Rank<span>@FormattingUtilities.GetOrdinal(prize.Rank)</span></span>
                                    <span class="prize-amount">@prize.PrizeAmount.ToString("C", new CultureInfo("en-GB"))</span>
                                </div>
                            }
                            @foreach (var prize in _pageData.PrizeSettings.Where(p => p.PrizeType == PrizeType.MostExactScores))
                            {
                                <div class="prize-row">
                                    <div class="prize-icon"><span class="bi bi-bullseye"></span></div>
                                    <span class="prize-description">Exact Scores</span>
                                    <span class="prize-amount">@prize.PrizeAmount.ToString("C", new CultureInfo("en-GB"))</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="prize-locked-card">
                    <div class="prize-locked-icon">
                        <span class="bi @(entriesOpen ? "bi-hourglass-split" : "bi-lock-fill")"></span>
                    </div>
                    @if (entriesOpen)
                    {
                        <p class="prize-locked-text">Entries are still open. The figures below are estimated from the current pot and grow as more players join - final prizes are confirmed once the entry deadline passes.</p>
                    }
                    else
                    {
                        <p class="prize-locked-text">Entries are closed and the prize pot is locked in. Winners will appear here once the first results are processed.</p>
                    }

                    <div class="prize-info-grid">
                        <div class="prize-info-item">
                            <span class="prize-info-label">Entry Deadline</span>
                            <span class="prize-info-value"><LocalTime UtcDate="@_pageData.EntryDeadlineUtc"/></span>
                        </div>
                        <div class="prize-info-item">
                            <span class="prize-info-label">@(entriesOpen ? "Current Prize Fund" : "Final Prize Fund")</span>
                            <span class="prize-info-value prize-info-value--green">@((_pageData.Price * _pageData.MemberCount).ToString("C", new CultureInfo("en-GB")))</span>
                        </div>
                        <div class="prize-info-item">
                            <span class="prize-info-label">Members</span>
                            <span class="prize-info-value">@_pageData.MemberCount</span>
                        </div>
                        <div class="prize-info-item">
                            <span class="prize-info-label">Entry Fee</span>
                            <span class="prize-info-value">@(_pageData.Price > 0 ? _pageData.Price.ToString("C", new CultureInfo("en-GB")) : "Free")</span>
                        </div>
                    </div>
                </div>

                @if (_breakdown?.Categories.Any() == true)
                {
                    <div class="card w-100 mt-4">
                        <div class="header">
                            <h5 class="text-center fw-bold mb-0">@(entriesOpen ? "Estimated Prize Breakdown" : "Prize Breakdown")</h5>
                        </div>
                        <div class="body">
                            <PrizeBreakdownPreview Breakdown="_breakdown" PotLabel="@(entriesOpen ? "Estimated prize pot" : "Total prize pot")" />
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    [Parameter] public int LeagueId { get; set; }

    private LeaguePrizesPageDto? _pageData;
    private PrizeBreakdownDto? _breakdown;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _errorMessage = null;
        try
        {
            _pageData = await Http.GetFromJsonAsync<LeaguePrizesPageDto>($"api/leagues/{LeagueId}/prizes");

            if (_pageData != null && !_pageData.PrizeSettings.Any())
            {
                try
                {
                    _breakdown = await Http.GetFromJsonAsync<PrizeBreakdownDto>($"api/leagues/{LeagueId}/prize-breakdown");
                }
                catch
                {
                    _breakdown = null;
                }
            }
        }
        catch
        {
            _errorMessage = "Could not load prize information for this league.";
        }
        _isLoading = false;
    }

    private void Back() => NavigationManager.NavigateTo("/leagues");

    private static string GetMedalClass(int rank) => rank switch
    {
        1 => "medal-gold",
        2 => "medal-silver",
        3 => "medal-bronze",
        _ => ""
    };
}
