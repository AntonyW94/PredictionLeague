@page "/leagues/create"

@attribute [Authorize]

@inject HttpClient Http

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Boosts
@using ThePredictions.Contracts.Prizes

<PageTitle>Create League</PageTitle>

<div class="page-container admin-light">
    @if (_pageData == null)
    {
        <p class="text-center text-white"><em>Loading Create League...</em></p>
    }
    else
    {
        <BaseFormComponent TModel="CreateLeagueRequest"
                           Model="_model"
                           ContainerClass="wide"
                           SubmitAction="HandleCreateLeagueAsync"
                           SuccessRedirectUrl="/leagues"
                           BackUrl="/leagues"
                           SuccessAlertMessage="League created successfully!"
                           BusyText="Creating League...">
            <Header>
                <h3 class="text-center fw-bold mb-4">Create New League</h3>
            </Header>
            <ChildContent>
                    <h5 class="prize-section-heading">League details</h5>

                    <div class="mb-3">
                        <label for="season" class="form-label">Season</label>
                        <InputSelect id="season" class="form-control" @bind-Value="_model.SeasonId" @onchange="OnSeasonSelected">
                            @if (_pageData.Seasons.Count != 1)
                            {
                                <option value="0">-- Select a Season --</option>
                            }

                            @foreach (var season in _pageData.Seasons)
                            {
                                <option value="@season.Id">@season.Name</option>
                            }
                        </InputSelect>
                        <StyledValidationMessage For="@(() => _model.SeasonId)" />
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label">League Name</label>
                        <InputText id="name" class="form-control" @bind-Value="_model.Name" disabled="@ShouldDisableFields" />
                        <StyledValidationMessage For="@(() => _model.Name)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="price" class="form-label">Entry Fee (£)</label>
                            <InputNumber id="price" class="form-control" @bind-Value="_model.Price" placeholder="0.00" disabled="@ShouldDisableFields" />
                            <div class="form-text text-white-50">Enter 0 for a free-to-play league.</div>
                            <StyledValidationMessage For="@(() => _model.Price)" />
                        </div>

                        @if (_model.SeasonId > 0)
                        {
                            <div class="col-md-6 mb-3">
                                <label for="prizeFundOverride" class="form-label">Add your own money to the pot (£)</label>
                                <InputNumber id="prizeFundOverride" class="form-control" @bind-Value="_model.PrizeFundOverride" placeholder="0" />
                                <div class="form-text text-white-50">Optional. Sits on top of the entry fees.</div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="entryDeadline" class="form-label">Entry Deadline</label>
                            <UtcInputDate id="entryDeadline"
                                          @bind-Value="_model.EntryDeadlineUtc"
                                          Class="form-control"
                                          Max="@MaxDate"
                                          Disabled="@ShouldDisableFields" />
                            <div class="form-text text-white-50">Deadline must be before the season starts.</div>
                            <StyledValidationMessage For="@(() => _model.EntryDeadlineUtc)" />
                        </div>
                    </div>

                    <hr class="prize-section-divider" />
                    <h5 class="prize-section-heading">Scoring</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="pointsForExactScore" class="form-label">Points for Exact Score</label>
                            <InputNumber id="pointsForExactScore" class="form-control" @bind-Value="_model.PointsForExactScore" disabled="@ShouldDisableFields" />
                            <div class="form-text text-white-50">Points awarded for predicting the exact score.</div>
                            <StyledValidationMessage For="@(() => _model.PointsForExactScore)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="pointsForCorrectResult" class="form-label">Points for Correct Result</label>
                            <InputNumber id="pointsForCorrectResult" class="form-control" @bind-Value="_model.PointsForCorrectResult" disabled="@ShouldDisableFields" />
                            <div class="form-text text-white-50">Points awarded for predicting the winner/draw.</div>
                            <StyledValidationMessage For="@(() => _model.PointsForCorrectResult)" />
                        </div>
                    </div>

                    @if (_model.SeasonId > 0)
                    {
                        <hr class="prize-section-divider" />
                        <PrizeSchemeEditor @key="_model.SeasonId"
                                           Scheme="_scheme"
                                           SeasonId="_model.SeasonId"
                                           Price="_model.Price"
                                           IsTournament="_isTournament"
                                           PrizeFundOverride="_model.PrizeFundOverride" />
                        <hr class="prize-section-divider" />
                        <LeagueBoostSelector Selections="_boostSelections" />
                    }

                    @if (_model.Price > 0)
                    {
                        <LeagueBankDetailsFields Model="_model" />
                    }
            </ChildContent>
        </BaseFormComponent>
    }
</div>

@code {
    private CreateLeaguePageData? _pageData;
    private readonly CreateLeagueRequest _model = new();
    private PrizeSchemeRequest _scheme = new();
    private readonly List<LeagueBoostSelectionDto> _boostSelections = new();
    private bool _isTournament;
    private bool ShouldDisableFields => _pageData?.Seasons.Count != 1 && _model.SeasonId == 0;
    private string? MaxDate { get; set; }


    protected override async Task OnInitializedAsync()
    {
        _pageData = await Http.GetFromJsonAsync<CreateLeaguePageData>("api/leagues/create-data");

        if (_pageData != null)
        {
            _model.PointsForExactScore = _pageData.DefaultPointsForExactScore;
            _model.PointsForCorrectResult = _pageData.DefaultPointsForCorrectResult;

            if (_pageData.Seasons.Count == 1)
            {
                var singleSeason = _pageData.Seasons.First();
                _model.SeasonId = singleSeason.Id;
                _isTournament = singleSeason.IsTournament;

                UpdateDeadlineAndMaxDate(singleSeason.StartDateUtc);
            }
        }
    }

    private void OnSeasonSelected(ChangeEventArgs e)
    {
        var selectedSeasonId = int.Parse(e.Value?.ToString() ?? "0");
        _model.SeasonId = selectedSeasonId;

        // The competition type changes which prize categories are valid, so reset the draft scheme.
        _scheme = new PrizeSchemeRequest();

        if (selectedSeasonId > 0 && _pageData != null)
        {
            var selectedSeason = _pageData.Seasons.FirstOrDefault(s => s.Id == selectedSeasonId);
            if (selectedSeason != null)
            {
                _isTournament = selectedSeason.IsTournament;
                UpdateDeadlineAndMaxDate(selectedSeason.StartDateUtc);
            }
        }
        else
        {
            MaxDate = null;
        }
    }

    private void UpdateDeadlineAndMaxDate(DateTime seasonStartDateUtc)
    {
        var deadlineUtc = seasonStartDateUtc.AddDays(-1);
      
        _model.EntryDeadlineUtc = deadlineUtc;
        MaxDate = deadlineUtc.ToString("yyyy-MM-ddTHH:mm");
    }

    private async Task<HttpResponseMessage> HandleCreateLeagueAsync()
    {
        // Attach the prize scheme only when the league actually awards prizes.
        _model.PrizeScheme = (_model.Price > 0 || (_model.PrizeFundOverride ?? 0) > 0) && _scheme.Categories.Any()
            ? _scheme
            : null;

        var response = await Http.PostAsJsonAsync("api/leagues/create", _model);
        if (!response.IsSuccessStatusCode)
            return response;

        // Boosts are configured per league after creation; only send them if any were enabled.
        var enabledBoosts = _boostSelections.Where(b => b.IsEnabled).ToList();
        if (enabledBoosts.Any())
        {
            var created = await response.Content.ReadFromJsonAsync<LeagueDto>();
            if (created != null)
                await Http.PutAsJsonAsync($"api/boosts/league/{created.Id}/rules", new SetLeagueBoostRulesRequest { Selections = enabledBoosts });
        }

        return response;
    }
}
