@page "/season-passes"
@attribute [Authorize]
@using System.Globalization
@using ThePredictions.Contracts.SeasonPasses
@using ThePredictions.Web.Client.Services.SeasonPasses
@inject ISeasonPassService SeasonPassService
@inject NavigationManager NavigationManager

<PageTitle>Season Passes</PageTitle>

<div class="page-container page-container--top">
    @if (SeasonId.HasValue)
    {
        @* ---------- Per-season acquire view ---------- *@
        <div class="season-pass-acquire">
            <ApiError Message="@_errorMessage" />

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
            }
            else if (_options is null)
            {
                <div class="empty-state">
                    <i class="bi bi-ticket-perforated empty-state-icon"></i>
                    <p>This season isn't available for a pass right now.</p>
                    <a class="btn purple-accent-button" href="/dashboard">Back to dashboard</a>
                </div>
            }
            else if (_finalisingPayment)
            {
                <div class="season-pass-success">
                    <div class="season-pass-success__banner">
                        <div class="spinner-border mb-3" role="status" aria-hidden="true"></div>
                        <h2 class="season-pass-success__title">Confirming your payment</h2>
                        <p class="season-pass-success__subtitle">This will only take a moment...</p>
                    </div>
                </div>
            }
            else if (_options.AlreadyHeld || _justAcquired)
            {
                <div class="season-pass-success">
                    <div class="season-pass-success__banner">
                        <span class="season-pass-success__badge bi bi-check-lg" aria-hidden="true"></span>
                        <h2 class="season-pass-success__title">You're all set</h2>
                        <p class="season-pass-success__subtitle">
                            Your <strong>@_options.SeasonName</strong> pass is ready. Time to get in the game.
                        </p>
                    </div>
                    <div class="season-pass-success__body">
                        <h3 class="season-pass-success__heading">What you can do now</h3>
                        <ul class="season-pass-success__list">
                            <li><i class="bi bi-people-fill"></i> Join or create unlimited leagues</li>
                            <li><i class="bi bi-pencil-square"></i> Make predictions every round</li>
                            <li><i class="bi bi-lightning-charge-fill"></i> Use boosts to climb the table faster</li>
                        </ul>
                        <div class="season-pass-success__actions">
                            <a class="btn green-button" href="/dashboard">Go to dashboard</a>
                            <a class="btn blue-light-button" href="/leagues/create">Create a league</a>
                        </div>
                    </div>
                </div>
            }
            else if (_paymentPending)
            {
                <div class="season-pass-success">
                    <div class="season-pass-success__banner">
                        <span class="season-pass-success__badge bi bi-hourglass-split" aria-hidden="true"></span>
                        <h2 class="season-pass-success__title">Payment received</h2>
                        <p class="season-pass-success__subtitle">
                            Thanks! We're setting up your <strong>@_options.SeasonName</strong> pass - this usually only takes a few seconds.
                        </p>
                    </div>
                    <div class="season-pass-success__body">
                        <div class="season-pass-success__actions">
                            <button class="btn green-button" @onclick="RefreshAsync">Check again</button>
                            <a class="btn blue-light-button" href="/dashboard">Go to dashboard</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @if (_checkoutCancelled)
                {
                    <div class="season-pass-cancelled-banner">
                        <i class="bi bi-x-circle-fill"></i>
                        <span>Checkout cancelled - you haven't been charged. You can try again below.</span>
                    </div>
                }

                <div class="season-pass-hero season-pass-hero--detail">
                    <span class="season-pass-hero__crest @(string.IsNullOrEmpty(_options.CompetitionLogoUrl) ? "season-pass-crest--empty" : "")">
                        @if (!string.IsNullOrEmpty(_options.CompetitionLogoUrl))
                        {
                            <img src="@_options.CompetitionLogoUrl" alt="@_options.SeasonName logo" />
                        }
                        else
                        {
                            <i class="bi bi-trophy-fill"></i>
                        }
                    </span>
                    <h2 class="season-pass-hero__title">@_options.SeasonName</h2>
                    <p class="season-pass-hero__lead">
                        @if (_options.EntryOpen)
                        {
                            <text>Your Season Pass to take part - join or create leagues, make predictions and compete on the leaderboards all season. It's also what keeps The Predictions completely ad-free.</text>
                        }
                        else
                        {
                            <text>Entry has closed, so you can no longer get a pass. Here's a look at what it involved.</text>
                        }
                    </p>
                    <div class="season-pass-chips season-pass-chips--hero">
                        @if (_options.EntryOpen)
                        {
                            <span class="season-pass-chip season-pass-chip--price">@DetailPriceChip</span>
                            @if (_options.PlayerCount > 0)
                            {
                                <span class="season-pass-chip"><i class="bi bi-people-fill"></i> @PlayingLabel(_options.PlayerCount)</span>
                            }
                            @if (CountdownLabel(_options.NextEntryDeadlineUtc) is { } countdown)
                            {
                                <span class="season-pass-chip"><i class="bi bi-clock-fill"></i> @countdown</span>
                            }
                        }
                        else
                        {
                            <span class="season-pass-chip">Finished</span>
                            @if (_options.PlayerCount > 0)
                            {
                                <span class="season-pass-chip"><i class="bi bi-people-fill"></i> @PlayedLabel(_options.PlayerCount)</span>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_options.CompetitionDescription))
                {
                    <div class="season-pass-about">
                        <h3 class="season-pass-about__heading"><i class="bi bi-info-circle-fill"></i> Good to know</h3>
                        <ul class="season-pass-about__list">
                            @foreach (var line in _options.CompetitionDescription.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>@line.Trim()</li>
                            }
                        </ul>
                    </div>
                }

                @if (_options.EntryOpen)
                {
                    <h3 class="text-center fw-bold mt-5 mb-3">Get your pass</h3>
                    <div class="season-pass-cards">
                        <div class="season-pass-card">
                            <div class="season-pass-card__tier">Standard</div>
                            <div class="season-pass-card__price">@StandardPriceLabel</div>
                            <ul class="season-pass-card__features">
                                <li><i class="bi bi-check-lg"></i> Join or create unlimited leagues</li>
                                <li><i class="bi bi-check-lg"></i> Make predictions every round</li>
                                <li><i class="bi bi-check-lg"></i> Use prediction boosts</li>
                                <li><i class="bi bi-check-lg"></i> Live match score updates</li>
                                <li><i class="bi bi-check-lg"></i> Leaderboards &amp; standings</li>
                                <li><i class="bi bi-check-lg"></i> Email reminders</li>
                                <li><i class="bi bi-check-lg"></i> No adverts, ever</li>
                            </ul>
                            @if (CanAcquireStandardFree)
                            {
                                <button class="btn green-button w-100" @onclick="AcquireAsync" disabled="@_isBusy">
                                    @(_isBusy ? "Getting your pass..." : "Get your pass")
                                </button>
                            }
                            else
                            {
                                <button class="btn green-button w-100" @onclick="BuyAsync" disabled="@_isBusy">
                                    @(_isBusy ? "Redirecting to payment..." : $"Get your pass - {StandardPriceLabel}")
                                </button>
                                <p class="season-pass-card__secure"><i class="bi bi-lock-fill"></i> Secure payment via Stripe - one-off, no auto-renewal</p>
                            }
                        </div>

                        @if (_options.PremiumPrice.HasValue)
                        {
                            <div class="season-pass-card season-pass-card--premium">
                                <span class="season-pass-card__badge">Most popular</span>
                                <div class="season-pass-card__tier">Premium</div>
                                <div class="season-pass-card__price">@PremiumPriceLabel</div>
                                <ul class="season-pass-card__features">
                                    <li><i class="bi bi-check-lg"></i> Everything in Standard</li>
                                    <li><i class="bi bi-stars"></i> SMS deadline reminders</li>
                                </ul>
                                <button class="btn purple-accent-button w-100" disabled>Card payment coming soon</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="season-pass-closed-banner">
                        <i class="bi bi-lock-fill"></i>
                        <span>Entry for this season has closed</span>
                    </div>
                }

                @if (_teams.Count > 0)
                {
                    <div class="season-pass-teams season-pass-teams--footnote">
                        <p class="season-pass-teams__heading">@_teams.Count teams this season</p>
                        <div class="season-pass-teams__grid">
                            @foreach (var team in _teams)
                            {
                                <div class="season-pass-team">
                                    @if (!string.IsNullOrEmpty(team.LogoUrl))
                                    {
                                        <img src="@team.LogoUrl" alt="@team.Name" />
                                    }
                                    <span>@team.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        @* ---------- Hub view: held + available ---------- *@
        <div class="season-pass-hub">
            <div class="season-pass-hero">
                <span class="season-pass-hero__icon bi bi-ticket-perforated-fill" aria-hidden="true"></span>
                <h2 class="season-pass-hero__title">Season Passes</h2>
                <p class="season-pass-hero__lead">Your ticket to a competition - join its leagues, make predictions and climb the leaderboards all season. Your first season is a free trial; after that, each season has a Standard or Premium pass.</p>
            </div>

            <section class="season-pass-hub__section">
                <h3 class="season-pass-hub__heading">How it works</h3>
                <div class="season-pass-steps">
                    <div class="season-pass-step">
                        <span class="season-pass-step__num">1</span>
                        <div class="season-pass-step__body">
                            <span class="season-pass-step__title">Choose a season</span>
                            <span class="season-pass-step__text">Tap any season below to see what it includes.</span>
                        </div>
                    </div>
                    <div class="season-pass-step">
                        <span class="season-pass-step__num">2</span>
                        <div class="season-pass-step__body">
                            <span class="season-pass-step__title">Get your pass</span>
                            <span class="season-pass-step__text">Your first season is a free trial. After that, choose Standard or Premium.</span>
                        </div>
                    </div>
                    <div class="season-pass-step">
                        <span class="season-pass-step__num">3</span>
                        <div class="season-pass-step__body">
                            <span class="season-pass-step__title">Start playing</span>
                            <span class="season-pass-step__text">Join or create a league and make your first prediction.</span>
                        </div>
                    </div>
                </div>
            </section>

            <ApiError Message="@_errorMessage" />

            @if (_isLoading)
            {
                <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
            }
            else
            {
                @if (_mine.Count > 0)
                {
                    <section class="season-pass-hub__section">
                        <h3 class="season-pass-hub__heading">Your passes</h3>
                        <div class="season-pass-rows">
                            @foreach (var pass in _mine)
                            {
                                <div class="season-pass-row season-pass-row--held">
                                    <span class="season-pass-crest @(string.IsNullOrEmpty(pass.CompetitionLogoUrl) ? "season-pass-crest--empty" : "")">
                                        @if (!string.IsNullOrEmpty(pass.CompetitionLogoUrl))
                                        {
                                            <img src="@pass.CompetitionLogoUrl" alt="" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-trophy-fill"></i>
                                        }
                                    </span>
                                    <div class="season-pass-row__info">
                                        <span class="season-pass-row__name">@pass.SeasonName</span>
                                        <span class="season-pass-row__meta">@pass.Tier@(pass.HasSmsReminders ? " - SMS reminders" : "")</span>
                                    </div>
                                    <span class="season-pass-row__held"><i class="bi bi-check-circle-fill"></i> Held</span>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (_available.Count > 0)
                {
                    var feature = _available[0];
                    var rest = _available.Skip(1).ToList();
                    <section class="season-pass-hub__section">
                        <h3 class="season-pass-hub__heading">Available</h3>

                        <a class="season-pass-feature" href="@($"/season-passes?seasonId={feature.SeasonId}")">
                            <span class="season-pass-feature__crest @(string.IsNullOrEmpty(feature.CompetitionLogoUrl) ? "season-pass-crest--empty" : "")">
                                @if (!string.IsNullOrEmpty(feature.CompetitionLogoUrl))
                                {
                                    <img src="@feature.CompetitionLogoUrl" alt="" />
                                }
                                else
                                {
                                    <i class="bi bi-trophy-fill"></i>
                                }
                            </span>
                            <div class="season-pass-feature__body">
                                <div class="season-pass-chips">
                                    <span class="season-pass-chip season-pass-chip--price">@PriceChip(feature)</span>
                                    @if (feature.PlayerCount > 0)
                                    {
                                        <span class="season-pass-chip"><i class="bi bi-people-fill"></i> @PlayingLabel(feature.PlayerCount)</span>
                                    }
                                    @if (CountdownLabel(feature.NextEntryDeadlineUtc) is { } countdown)
                                    {
                                        <span class="season-pass-chip season-pass-chip--urgent"><i class="bi bi-clock-fill"></i> @countdown</span>
                                    }
                                </div>
                                <span class="season-pass-feature__name">@feature.SeasonName</span>
                                <span class="season-pass-feature__cta">Get your pass <i class="bi bi-arrow-right"></i></span>
                            </div>
                        </a>

                        @if (rest.Count > 0)
                        {
                            <div class="season-pass-rows">
                                @foreach (var available in rest)
                                {
                                    <a class="season-pass-row season-pass-row--link" href="@($"/season-passes?seasonId={available.SeasonId}")">
                                        <span class="season-pass-crest @(string.IsNullOrEmpty(available.CompetitionLogoUrl) ? "season-pass-crest--empty" : "")">
                                            @if (!string.IsNullOrEmpty(available.CompetitionLogoUrl))
                                            {
                                                <img src="@available.CompetitionLogoUrl" alt="" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-trophy-fill"></i>
                                            }
                                        </span>
                                        <div class="season-pass-row__info">
                                            <span class="season-pass-row__name">@available.SeasonName</span>
                                            <div class="season-pass-chips season-pass-chips--sm">
                                                <span class="season-pass-chip season-pass-chip--price">@PriceChip(available)</span>
                                                @if (available.PlayerCount > 0)
                                                {
                                                    <span class="season-pass-chip"><i class="bi bi-people-fill"></i> @PlayingLabel(available.PlayerCount)</span>
                                                }
                                                @if (CountdownLabel(available.NextEntryDeadlineUtc) is { } countdownRow)
                                                {
                                                    <span class="season-pass-chip season-pass-chip--urgent"><i class="bi bi-clock-fill"></i> @countdownRow</span>
                                                }
                                            </div>
                                        </div>
                                        <span class="season-pass-row__cta">View <i class="bi bi-chevron-right"></i></span>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                }

                @if (_past.Count > 0)
                {
                    <section class="season-pass-hub__section">
                        <h3 class="season-pass-hub__heading">Past seasons</h3>
                        <p class="season-pass-hub__note">Entry has closed for these - here's what you missed.</p>
                        <div class="season-pass-rows">
                            @foreach (var past in _past)
                            {
                                <a class="season-pass-row season-pass-row--link" href="@($"/season-passes?seasonId={past.SeasonId}")">
                                    <span class="season-pass-crest season-pass-crest--muted @(string.IsNullOrEmpty(past.CompetitionLogoUrl) ? "season-pass-crest--empty" : "")">
                                        @if (!string.IsNullOrEmpty(past.CompetitionLogoUrl))
                                        {
                                            <img src="@past.CompetitionLogoUrl" alt="" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-trophy-fill"></i>
                                        }
                                    </span>
                                    <div class="season-pass-row__info">
                                        <span class="season-pass-row__name">@past.SeasonName</span>
                                        <div class="season-pass-chips season-pass-chips--sm">
                                            <span class="season-pass-chip season-pass-chip--finished">Finished</span>
                                            @if (past.PlayerCount > 0)
                                            {
                                                <span class="season-pass-chip"><i class="bi bi-people-fill"></i> @PlayedLabel(past.PlayerCount)</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="season-pass-row__cta">View <i class="bi bi-chevron-right"></i></span>
                                </a>
                            }
                        </div>
                    </section>
                }

                @if (_mine.Count == 0 && _available.Count == 0 && _past.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-ticket-perforated empty-state-icon"></i>
                        <p>You're all set - there are no season passes to acquire right now.</p>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int? SeasonId { get; set; }

    [SupplyParameterFromQuery(Name = "checkout")]
    public string? Checkout { get; set; }

    private bool _isLoading = true;
    private bool _isBusy;
    private bool _justAcquired;
    private bool _finalisingPayment;
    private bool _paymentPending;
    private bool _checkoutCancelled;
    private string? _errorMessage;

    private SeasonPassOptionsDto? _options;
    private List<SeasonTeamDto> _teams = [];
    private List<MySeasonPassDto> _mine = [];
    private List<AvailableSeasonPassDto> _available = [];
    private List<PastSeasonPassDto> _past = [];

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _justAcquired = false;
        _paymentPending = false;
        _checkoutCancelled = false;

        try
        {
            if (SeasonId.HasValue)
            {
                _options = await SeasonPassService.GetOptionsAsync(SeasonId.Value);
                _teams = _options is null ? [] : await SeasonPassService.GetSeasonTeamsAsync(SeasonId.Value);
                _isLoading = false;

                if (_options is not null && IsCheckout("success") && !_options.AlreadyHeld)
                    await FinalisePaymentAsync();
                else if (IsCheckout("cancelled"))
                    _checkoutCancelled = true;
            }
            else
            {
                _mine = await SeasonPassService.GetMyPassesAsync();
                _available = await SeasonPassService.GetAvailablePassesAsync();
                _past = await SeasonPassService.GetPastPassesAsync();
            }
        }
        catch
        {
            _errorMessage = "Could not load season passes. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool IsCheckout(string value) => string.Equals(Checkout, value, StringComparison.OrdinalIgnoreCase);

    private async Task FinalisePaymentAsync()
    {
        // The pass is created by the Stripe webhook (server-to-server), which can land a moment after
        // the browser returns from checkout. Poll briefly for it before deciding it's still pending.
        _finalisingPayment = true;
        StateHasChanged();

        for (var attempt = 0; attempt < 6 && _options?.AlreadyHeld != true; attempt++)
        {
            await Task.Delay(1500);
            _options = await SeasonPassService.GetOptionsAsync(SeasonId!.Value);
        }

        _finalisingPayment = false;
        _paymentPending = _options?.AlreadyHeld != true;
    }

    private async Task RefreshAsync()
    {
        if (!SeasonId.HasValue)
            return;

        _paymentPending = false;
        _isLoading = true;

        _options = await SeasonPassService.GetOptionsAsync(SeasonId.Value);

        _isLoading = false;
        _paymentPending = _options is not null && !_options.AlreadyHeld;
    }

    private async Task BuyAsync()
    {
        if (!SeasonId.HasValue)
            return;

        _isBusy = true;
        _errorMessage = null;

        var (url, errorMessage) = await SeasonPassService.CreateCheckoutAsync(SeasonId.Value);
        if (!string.IsNullOrEmpty(url))
        {
            NavigationManager.NavigateTo(url, forceLoad: true);
            return;
        }

        _errorMessage = errorMessage ?? "Could not start checkout. Please try again.";
        _isBusy = false;
    }

    private bool CanAcquireStandardFree => _options is not null && (!_options.RequiresPayment || _options.IsTrialEligible);

    private string StandardPriceLabel
    {
        get
        {
            if (_options is null)
                return string.Empty;

            if (!_options.RequiresPayment)
                return "Free";

            if (_options.IsTrialEligible)
                return "Free (your first season)";

            return _options.StandardPrice!.Value.ToString("C", new CultureInfo("en-GB"));
        }
    }

    private string PremiumPriceLabel =>
        _options?.PremiumPrice is { } price ? price.ToString("C", new CultureInfo("en-GB")) : string.Empty;

    private string DetailPriceChip
    {
        get
        {
            if (_options is null)
                return string.Empty;

            if (!_options.RequiresPayment)
                return "Free";

            if (_options.IsTrialEligible)
                return "Free trial";

            return _options.StandardPrice!.Value.ToString("C", new CultureInfo("en-GB"));
        }
    }

    private static string PriceChip(AvailableSeasonPassDto pass)
    {
        if (!pass.RequiresPayment)
            return "Free";

        if (pass.IsTrialEligible)
            return "Free trial";

        return pass.StandardPrice!.Value.ToString("C", new CultureInfo("en-GB"));
    }

    private static string PlayingLabel(int playerCount) =>
        playerCount == 1 ? "1 playing" : $"{playerCount} playing";

    private static string PlayedLabel(int playerCount) =>
        playerCount == 1 ? "1 played" : $"{playerCount} played";

    private static string? CountdownLabel(DateTime? deadlineUtc)
    {
        if (deadlineUtc is not { } deadline)
            return null;

        var remaining = deadline - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
            return null;

        if (remaining.TotalDays < 1)
            return "Closes today";

        var days = (int)remaining.TotalDays;
        return days == 1 ? "Closes in 1 day" : $"Closes in {days} days";
    }

    private async Task AcquireAsync()
    {
        if (!SeasonId.HasValue)
            return;

        _isBusy = true;
        _errorMessage = null;

        var (success, errorMessage) = await SeasonPassService.AcquireAsync(SeasonId.Value);
        if (success)
            _justAcquired = true;
        else
            _errorMessage = errorMessage;

        _isBusy = false;
    }
}
