@inject NavigationManager NavigationManager
@inject IDashboardStateService DashboardState
@inject IBrowserService BrowserService
@inject IJSRuntime JsRuntime
@inject HttpClient Http

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Prizes
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Services.Browser
@using ThePredictions.Web.Client.Services.Dashboard

@implements IAsyncDisposable

<svg style="width:0;height:0;position:absolute;visibility:hidden;" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="grad-gold" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#C9B037" />
            <stop offset="40%" stop-color="#F2E29F" /> <stop offset="60%" stop-color="#AA8825" />
            <stop offset="100%" stop-color="#7A631A" />
        </linearGradient>

        <linearGradient id="grad-silver" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#9CA3AF" />
            <stop offset="40%" stop-color="#F9FAFB" /> <stop offset="60%" stop-color="#6B7280" />
            <stop offset="100%" stop-color="#374151" />
        </linearGradient>

        <linearGradient id="grad-bronze" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#8B5A2B" />
            <stop offset="40%" stop-color="#EBCBA6" /> <stop offset="60%" stop-color="#8B5A2B" />
            <stop offset="100%" stop-color="#5C3A1A" />
        </linearGradient>

        <linearGradient id="grad-blue" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#3B82F6" />
            <stop offset="40%" stop-color="#93C5FD" /> <stop offset="60%" stop-color="#2563EB" />
            <stop offset="100%" stop-color="#1E40AF" />
        </linearGradient>

        <linearGradient id="grad-red" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#EF4444" />
            <stop offset="40%" stop-color="#FCA5A5" /> <stop offset="60%" stop-color="#B91C1C" />
            <stop offset="100%" stop-color="#7F1D1D" />
        </linearGradient>

        <linearGradient id="rim-gold" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFF8D1" /> <stop offset="100%" stop-color="#C9B037" />
        </linearGradient>

        <linearGradient id="rim-silver" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFFFFF" />
            <stop offset="100%" stop-color="#9CA3AF" />
        </linearGradient>

        <linearGradient id="rim-bronze" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFE8CC" />
            <stop offset="100%" stop-color="#A67C52" />
        </linearGradient>

        <linearGradient id="rim-blue" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#E0F2FE" />
            <stop offset="100%" stop-color="#3B82F6" />
        </linearGradient>

        <linearGradient id="rim-red" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FEE2E2" />
            <stop offset="100%" stop-color="#EF4444" />
        </linearGradient>

        <filter id="shield-shadow" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="2" stdDeviation="1.5" flood-color="#000" flood-opacity="0.5" />
        </filter>
    </defs>
</svg>

<div class="section h-100">
    <h3 class="text-white text-center fw-bold mb-4">My Leagues</h3>

    <ApiError Message="@DashboardState.MyLeaguesErrorMessage" />

    @if (DashboardState.IsMyLeaguesLoading)
    {
        <div class="d-flex justify-content-center align-items-center flex-grow-1">
            <div class="spinner-border text-white" role="status">
                <span class="visually-hidden">Loading my leagues...</span>
            </div>
        </div>
    }
    else if (!DashboardState.MyLeagues.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
            <i class="bi bi-trophy empty-state-icon"></i>
            <p class="text-white-50 mt-2 mb-0 text-center">You haven't joined any leagues yet.</p>
        </div>
    }
    else if (!VisibleLeagues.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
            <i class="bi bi-archive empty-state-icon"></i>
            <p class="text-white-50 mt-2 mb-0 text-center">All your leagues are archived.</p>
            @if (ArchivedLeagueCount > 0)
            {
                <button type="button" class="archive-toggle-link mt-3" @onclick="ToggleShowArchived">
                    @($"Show {ArchivedLeagueCount} archived {(ArchivedLeagueCount == 1 ? "league" : "leagues")}")
                </button>
            }
        </div>
    }
    else
    {
        <div class="carousel-wrapper @(_showTwoItems ? "carousel--multi-item" : "")">
            <div class="carousel-container" @ontouchstart="HandleTouchStart" @ontouchmove="HandleTouchMove" @ontouchend="HandleTouchEnd">
                @if (NumberOfDots > 1)
                {
                    <button class="carousel-btn" @onclick="ShowPrevious" disabled="@(_currentIndex == 0)">
                        <span class="bi bi-chevron-left"></span>
                    </button>
                }

                <div class="carousel-track-wrapper" id="my-leagues-track-wrapper">
                    <div class="carousel-track" style="@_trackStyle">
                        @foreach (var league in VisibleLeagues)
                        {
                            <div class="carousel-item-wrapper">
                                <div class="carousel-item-content">
                                    <div class="card slide">
                                        <div class="header">
                                            <h5 class="fw-bold text-white mb-0">@league.Name</h5>
                                            <small class="text-white-50 fw-bold">@league.SeasonName</small>
                                        </div>

                                        <div class="body pt-2 space-between">
                                            @if (league.IsFinished)
                                            {
                                                var profitLoss = league.PrizeMoneyWon - league.EntryFee;

                                                <div class="glass-panel hero-rank-container">
                                                    <div class="text-center w-100">
                                                        <div class="text-uppercase text-white fw-bold mb-2 text-sm">
                                                            <i class="bi bi-trophy-fill me-1"></i>Season Complete
                                                        </div>

                                                        @if (league.Rank.HasValue && league.MemberCount.HasValue)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-center">
                                                                <div class="d-flex align-items-center gap-1">
                                                                    <div class="rank-shield-container">
                                                                        @{ var finishedColour = GetShieldColour(league.Rank, league.MemberCount); }
                                                                        <svg viewBox="0 0 24 24" class="rank-shield-icon" filter="url(#shield-shadow)">
                                                                            <path d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z" fill="url(#grad-@finishedColour)" stroke="url(#rim-@finishedColour)" />
                                                                        </svg>
                                                                        <span class="rank-shield-text">
                                                                            @league.Rank
                                                                        </span>
                                                                    </div>
                                                                    <div class="text-white-50 fw-bold fs-6">/ @league.MemberCount</div>
                                                                </div>
                                                            </div>
                                                            <small class="text-white-50 d-block mt-2">Final Position</small>
                                                        }
                                                    </div>
                                                </div>

                                                @if (league.IsFree)
                                                {
                                                    <div class="row g-2 mb-3 flex-grow-1">
                                                        <div class="col-12">
                                                            <div class="glass-panel financial-row">
                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Rounds Won</small>
                                                                    <div class="fw-bold text-white fs-5">
                                                                        @league.RoundsWon
                                                                    </div>
                                                                </div>

                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Months Won</small>
                                                                    <div class="fw-bold text-white fs-5">
                                                                        @league.MonthsWon
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="row g-2 mb-3 flex-grow-1">
                                                        <div class="col-12">
                                                            <div class="glass-panel financial-row">
                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Total Won</small>
                                                                    <div class="fw-bold text-green-600 fs-5">
                                                                        @((MarkupString)$"&pound;{league.PrizeMoneyWon:0.00}")
                                                                    </div>
                                                                </div>

                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Profit / Loss</small>
                                                                    <div class="fw-bold fs-5 @(profitLoss >= 0 ? "text-green-600" : "text-red")">
                                                                        @(profitLoss >= 0 ? "+" : "-")@((MarkupString)$"&pound;{Math.Abs(profitLoss):0.00}")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else if (IsPreDeadline(league))
                                            {
                                                var remaining = league.EntryDeadlineUtc!.Value - DateTime.UtcNow;

                                                <div class="glass-panel hero-rank-container">
                                                    <div class="text-center w-100">
                                                        <div class="text-uppercase text-white fw-bold mb-2 text-sm">
                                                            <i class="bi bi-hourglass-split me-1"></i>Entries Open
                                                        </div>
                                                        <div class="preseason-card-countdown">
                                                            <div class="preseason-card-countdown__unit">
                                                                <span class="preseason-card-countdown__value text-green-600">@remaining.Days.ToString("D2")</span>
                                                                <span class="preseason-card-countdown__label text-white-50">Days</span>
                                                            </div>
                                                            <span class="preseason-card-countdown__sep text-white-50">:</span>
                                                            <div class="preseason-card-countdown__unit">
                                                                <span class="preseason-card-countdown__value text-green-600">@remaining.Hours.ToString("D2")</span>
                                                                <span class="preseason-card-countdown__label text-white-50">Hrs</span>
                                                            </div>
                                                            <span class="preseason-card-countdown__sep text-white-50">:</span>
                                                            <div class="preseason-card-countdown__unit">
                                                                <span class="preseason-card-countdown__value text-green-600">@remaining.Minutes.ToString("D2")</span>
                                                                <span class="preseason-card-countdown__label text-white-50">Mins</span>
                                                            </div>
                                                            <span class="preseason-card-countdown__sep text-white-50">:</span>
                                                            <div class="preseason-card-countdown__unit">
                                                                <span class="preseason-card-countdown__value text-green-600">@remaining.Seconds.ToString("D2")</span>
                                                                <span class="preseason-card-countdown__label text-white-50">Secs</span>
                                                            </div>
                                                        </div>
                                                        <small class="text-white-50 d-block mt-2">Entries close @league.EntryDeadlineUtc.Value.ToString("dd MMM yyyy")</small>
                                                    </div>
                                                </div>

                                                <div class="row g-2 mb-3 flex-grow-1">
                                                    <div class="col-12">
                                                        <div class="glass-panel financial-row">
                                                            <div class="financial-col">
                                                                <small class="d-block text-uppercase fw-bold text-2xs">Players</small>
                                                                <div class="fw-bold text-white fs-5">@league.MemberCount</div>
                                                            </div>

                                                            <div class="financial-col">
                                                                <small class="d-block text-uppercase fw-bold text-2xs">@(league.IsFree ? "Entry" : "Estimated Pot")</small>
                                                                @if (league.IsFree)
                                                                {
                                                                    <div class="fw-bold text-white fs-5">Free</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="fw-bold text-green-600 fs-5">@((MarkupString)$"&pound;{league.TotalPrizeFund:0.00}")</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (!league.IsFree && _breakdowns.TryGetValue(league.Id, out var breakdown))
                                                {
                                                    <div class="glass-panel preseason-card-prizes mb-3">
                                                        @foreach (var category in breakdown.Categories.Where(c => c.SubPot > 0))
                                                        {
                                                            <div class="preseason-card-prize-row">
                                                                <small class="text-white-50 text-uppercase fw-bold text-2xs">@category.DisplayName</small>
                                                                <span class="fw-bold text-green-600">@((MarkupString)$"&pound;{category.SubPot:0}")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (league.IsFree)
                                                {
                                                    <div class="glass-panel preseason-card-prizes mb-3">
                                                        @if (league.SeasonStartDateUtc.HasValue)
                                                        {
                                                            <div class="preseason-card-prize-row">
                                                                <small class="text-white-50 text-uppercase fw-bold text-2xs">Kicks Off</small>
                                                                <span class="fw-bold text-white">@league.SeasonStartDateUtc.Value.ToString("dd MMM yyyy")</span>
                                                            </div>
                                                        }
                                                        <div class="preseason-card-prize-row">
                                                            <small class="text-white-50 text-uppercase fw-bold text-2xs">Format</small>
                                                            <span class="fw-bold text-white">@(league.CompetitionType == 1 ? "Tournament" : "League")</span>
                                                        </div>
                                                        <div class="preseason-card-prize-row">
                                                            <small class="text-white-50 text-uppercase fw-bold text-2xs">Entry Fee</small>
                                                            <span class="fw-bold text-white">Free</span>
                                                        </div>
                                                        <div class="preseason-card-prize-row">
                                                            <small class="text-white-50 text-uppercase fw-bold text-2xs">Playing For</small>
                                                            <span class="fw-bold text-white">Bragging rights</span>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else if (league.CurrentRound is null)
                                            {
                                                <div class="text-center py-3 flex-grow-1 d-flex flex-column justify-content-center">
                                                    <i class="bi bi-hourglass-split text-purple-300" style="font-size: 2.5rem;"></i>
                                                    <p class="text-white fw-bold mt-3 mb-1">Not started yet</p>
                                                    @if (league.SeasonStartDateUtc.HasValue)
                                                    {
                                                        <small class="text-white-50">Kicks off @league.SeasonStartDateUtc.Value.ToString("dd MMM yyyy")</small>
                                                    }
                                                    <div class="d-flex justify-content-center gap-4 mt-3">
                                                        <div class="text-center">
                                                            <div class="fw-bold text-white fs-5">@league.MemberCount</div>
                                                            <small class="text-white-50 text-uppercase text-2xs fw-bold">Players</small>
                                                        </div>
                                                        @if (league.TotalPrizeFund > 0)
                                                        {
                                                            <div class="text-center">
                                                                <div class="fw-bold text-green-600 fs-5">@((MarkupString)$"&pound;{league.TotalPrizeFund:0.00}")</div>
                                                                <small class="text-white-50 text-uppercase text-2xs fw-bold">Prize Pot</small>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="glass-panel hero-rank-container">
                                                    <div class="text-center w-100">
                                                        <div class="text-uppercase text-white fw-bold mb-2 text-sm">Overall Rank</div>

                                                        <div class="d-flex align-items-center justify-content-center">
                                                            <RankChangeArrow
                                                                PreviousRank="@league.PreRoundOverallRank"
                                                                CurrentRank="@league.Rank.GetValueOrDefault()"
                                                                IsVisible="@(league.RoundStatus == nameof(RoundStatus.InProgress) && league.PreRoundOverallRank.HasValue && league.Rank.HasValue)" />

                                                            @if (league.Rank.HasValue && league.MemberCount.HasValue)
                                                            {
                                                                <div class="d-flex align-items-center gap-1">
                                                                    <div class="rank-shield-container">
                                                                        @{ var overallColour = GetShieldColour(league.Rank, league.MemberCount); }
                                                                        <svg viewBox="0 0 24 24" class="rank-shield-icon" filter="url(#shield-shadow)">
                                                                            <path d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z" fill="url(#grad-@overallColour)" stroke="url(#rim-@overallColour)"/>
                                                                        </svg>
                                                                        <span class="rank-shield-text">
                                                                            @league.Rank
                                                                        </span>
                                                                    </div>
                                                                    <div class="text-white-50 fw-bold fs-6">/ @league.MemberCount</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row g-2 mb-3 flex-grow-1">
                                                    <div class="col-6 d-flex">
                                                        <div class="glass-panel secondary-rank-box w-100">
                                                            <small class="text-uppercase text-white fw-bold d-block mb-1 text-xs">@league.CurrentRound</small>
                                                            @if (league.RoundStatus == nameof(RoundStatus.Published))
                                                            {
                                                                <div class="d-flex flex-column align-items-center justify-content-center">
                                                                    <i class="bi bi-hourglass-split text-purple-300" style="font-size: 1.8rem;"></i>
                                                                    <small class="text-white-50 text-2xs mt-1">
                                                                        @if (league.RoundStartDateUtc.HasValue)
                                                                        {
                                                                            @($"Starts {league.RoundStartDateUtc.Value:dd MMM}")
                                                                        }
                                                                        else
                                                                        {
                                                                            @("Awaiting kick-off")
                                                                        }
                                                                    </small>
                                                                </div>
                                                            }
                                                            else if (league.RoundRank.HasValue)
                                                            {
                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                    <RankChangeArrow
                                                                        PreviousRank="@league.StableRoundRank"
                                                                        CurrentRank="@league.RoundRank.GetValueOrDefault()"
                                                                        IsVisible="@(league.RoundStatus == nameof(RoundStatus.InProgress) && league.InProgressCount > 0 && league.CompletedCount > 0 && league.StableRoundRank.HasValue)" />

                                                                    <div class="rank-shield-container small">
                                                                        @{ var roundColour = GetShieldColour(league.RoundRank, league.MemberCount); }
                                                                        <svg viewBox="0 0 24 24" class="rank-shield-icon" filter="url(#shield-shadow)">
                                                                            <path d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z" fill="url(#grad-@roundColour)" stroke="url(#rim-@roundColour)" />
                                                                        </svg>
                                                                        <span class="rank-shield-text">
                                                                            @league.RoundRank
                                                                        </span>
                                                                    </div>
                                                                    <div class="text-white-50 fw-bold fs-6">/ @league.MemberCount</div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-white-50">-</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="col-6 d-flex">
                                                        <div class="glass-panel secondary-rank-box w-100">
                                                            <small class="text-uppercase text-white fw-bold d-block mb-1 text-xs">@league.CurrentMonth</small>
                                                            @if (league.RoundStatus == nameof(RoundStatus.Published) && !league.PreRoundMonthRank.HasValue)
                                                            {
                                                                <div class="d-flex flex-column align-items-center justify-content-center">
                                                                    <i class="bi bi-hourglass-split text-purple-300" style="font-size: 1.8rem;"></i>
                                                                    <small class="text-white-50 text-2xs mt-1">
                                                                        @if (league.RoundStartDateUtc.HasValue)
                                                                        {
                                                                            @($"Starts {league.RoundStartDateUtc.Value:dd MMM}")
                                                                        }
                                                                        else
                                                                        {
                                                                            @("Awaiting kick-off")
                                                                        }
                                                                    </small>
                                                                </div>
                                                            }
                                                            else if (league.MonthRank.HasValue)
                                                            {
                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                    <RankChangeArrow
                                                                        PreviousRank="@league.PreRoundMonthRank"
                                                                        CurrentRank="@league.MonthRank.GetValueOrDefault()"
                                                                        IsVisible="@(league.RoundStatus == nameof(RoundStatus.InProgress) && league.PreRoundMonthRank.HasValue)" />

                                                                    <div class="rank-shield-container small">
                                                                        @{ var monthColour = GetShieldColour(league.MonthRank, league.MemberCount); }
                                                                        <svg viewBox="0 0 24 24" class="rank-shield-icon" filter="url(#shield-shadow)">
                                                                            <path d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z" fill="url(#grad-@monthColour)" stroke="url(#rim-@monthColour)" />
                                                                        </svg>
                                                                        <span class="rank-shield-text">
                                                                            @league.MonthRank
                                                                        </span>
                                                                    </div>
                                                                    <div class="text-white-50 fw-bold fs-6">/ @league.MemberCount</div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-white-50">-</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (league.TotalPrizeFund > 0)
                                                {
                                                    <div class="row g-2 mb-3">
                                                        <div class="col-12">
                                                            <div class="glass-panel financial-row">
                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Won So Far</small>
                                                                    <div class="fw-bold text-green-600 fs-5">
                                                                        @((MarkupString)$"&pound;{league.PrizeMoneyWon:0.00}")
                                                                    </div>
                                                                </div>

                                                                <div class="financial-col">
                                                                    <small class="d-block text-uppercase fw-bold text-2xs">Pot Remaining</small>
                                                                    <div class="fw-bold text-white fs-5">
                                                                        @((MarkupString)$"&pound;{league.PrizeMoneyRemaining:0.00}")
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }

                                            <div class="my-leagues-card-actions">
                                                @{
                                                    var isFinishedOrArchived = league.IsFinished || league.IsArchivedByUser;
                                                    var primaryLabel = isFinishedOrArchived ? "View Recap" : "View Dashboard";
                                                }
                                                <button class="btn purple-accent-button w-100" @onclick="() => ViewLeagueDashboard(league.Id)">
                                                    @primaryLabel
                                                </button>
                                                @if (isFinishedOrArchived)
                                                {
                                                    var archiveLabel = league.IsArchivedByUser ? "Unarchive League" : "Archive League";
                                                    var archiveIcon = league.IsArchivedByUser ? "bi-arrow-counterclockwise" : "bi-archive";
                                                    <button class="btn archive-season-button w-100"
                                                            aria-label="@archiveLabel"
                                                            @onclick="() => ToggleArchive(league)">
                                                        <i class="bi @archiveIcon me-2"></i>@archiveLabel
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (NumberOfDots > 1)
                {
                    <button class="carousel-btn" @onclick="ShowNext" disabled="@IsAtEnd()">
                        <span class="bi bi-chevron-right"></span>
                    </button>
                }
            </div>

            @if (NumberOfDots > 1)
            {
                <div class="carousel-dots">
                    @for (var i = 0; i < NumberOfDots; i++)
                    {
                        var dotIndex = i;
                        <span class="carousel-dot @(i == _currentIndex ? "active" : "")" @onclick="() => GoToSlide(dotIndex)"></span>
                    }
                </div>
            }
        </div>
    }

    @if (ArchivedLeagueCount > 0)
    {
        <div class="archive-toggle-row">
            <button type="button" class="archive-toggle-link" @onclick="ToggleShowArchived">
                @if (_showArchived)
                {
                    <i class="bi bi-chevron-up me-1"></i>
                    @($"Hide {ArchivedLeagueCount} archived {(ArchivedLeagueCount == 1 ? "league" : "leagues")}")
                }
                else
                {
                    <i class="bi bi-archive me-1"></i>
                    @($"Show {ArchivedLeagueCount} archived {(ArchivedLeagueCount == 1 ? "league" : "leagues")}")
                }
            </button>
        </div>
    }
</div>

@code {
    private int _currentIndex;
    private double _touchStartX;
    private string _trackStyle = "transform: translateX(0%);";
    private bool _isTabletOrAbove;
    private bool _isDesktop;
    private bool _showArchived;
    private System.Timers.Timer? _countdownTimer;
    private readonly Dictionary<int, PrizeBreakdownDto> _breakdowns = new();

    [Parameter] public bool IsHalfWidth { get; set; }

    // Two cards fit side by side only when the tile is wide enough. It's wide on any
    // tablet+ screen, except when it shares the lg row with Available Leagues: there it
    // stacks to full width below lg (two cards fit) but is genuinely half width on
    // desktop (lg+), where only one full-width card should show.
    private bool _showTwoItems => IsHalfWidth ? (_isTabletOrAbove && !_isDesktop) : _isTabletOrAbove;

    private List<MyLeagueDto> VisibleLeagues =>
        _showArchived
            ? DashboardState.MyLeagues.ToList()
            : DashboardState.MyLeagues.Where(l => !l.IsArchivedByUser).ToList();

    private int ArchivedLeagueCount => DashboardState.MyLeagues.Count(l => l.IsArchivedByUser);

    protected override async Task OnInitializedAsync()
    {
        DashboardState.OnStateChange += StateHasChanged;
        _isTabletOrAbove = await BrowserService.IsTabletOrAbove();
        _isDesktop = await BrowserService.IsDesktop();

        if (!DashboardState.MyLeagues.Any())
            await DashboardState.LoadMyLeaguesAsync();

        await LoadPrizeBreakdownsAsync();
        StartCountdown();
    }

    private static bool IsPreDeadline(MyLeagueDto league) =>
        !league.IsFinished && league.EntryDeadlineUtc is { } deadline && DateTime.UtcNow < deadline;

    private async Task LoadPrizeBreakdownsAsync()
    {
        foreach (var league in DashboardState.MyLeagues.Where(l => IsPreDeadline(l) && !l.IsFree))
        {
            try
            {
                var breakdown = await Http.GetFromJsonAsync<PrizeBreakdownDto>($"api/leagues/{league.Id}/prize-breakdown");
                if (breakdown is not null && breakdown.Categories.Any(c => c.SubPot > 0))
                    _breakdowns[league.Id] = breakdown;
            }
            catch
            {
                // No prize summary if the breakdown can't be loaded.
            }
        }

        StateHasChanged();
    }

    private void StartCountdown()
    {
        if (_countdownTimer is not null || !DashboardState.MyLeagues.Any(IsPreDeadline))
            return;

        _countdownTimer = new System.Timers.Timer(1000) { AutoReset = true };
        _countdownTimer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        _countdownTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VisibleLeagues.Any())
        {
            await UpdateCarouselHeightAsync();
        }
    }

    private int NumberOfDots
    {
        get
        {
            var visible = VisibleLeagues;
            if (!visible.Any())
                return 0;

            var leaguesPerPage = _showTwoItems ? 2 : 1;

            if (visible.Count <= leaguesPerPage)
                return 0;

            return visible.Count - leaguesPerPage + 1;
        }
    }

    private async Task ToggleShowArchived()
    {
        _showArchived = !_showArchived;
        _currentIndex = 0;
        await UpdateTrackStyle();
    }

    private async Task ToggleArchive(MyLeagueDto league)
    {
        await DashboardState.SetLeagueArchivedAsync(league.Id, !league.IsArchivedByUser);
        _currentIndex = 0;
        await UpdateTrackStyle();
    }

    private void HandleTouchStart(TouchEventArgs e)
    {
        _touchStartX = e.Touches[0].ClientX;
    }

    private static void HandleTouchMove(TouchEventArgs e)
    {
    }

    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        var touchEndX = e.ChangedTouches[0].ClientX;
        var diffX = _touchStartX - touchEndX;

        if (!(Math.Abs(diffX) > 50))
            return;

        if (diffX > 0)
            await ShowNext();
        else
            await ShowPrevious();
    }

    private async Task GoToSlide(int index)
    {
        if (index < 0 || index >= NumberOfDots)
            return;

        _currentIndex = index;
        await UpdateTrackStyle();
    }

    private async Task ShowPrevious()
    {
        if (_currentIndex <= 0)
            return;

        _currentIndex--;
        await UpdateTrackStyle();
    }

    private async Task ShowNext()
    {
        if (IsAtEnd())
            return;

        _currentIndex++;
        await UpdateTrackStyle();
    }

    private async Task UpdateTrackStyle()
    {
        var percentageToMove = _showTwoItems ? 50 : 100;
        _trackStyle = $"transform: translateX(-{_currentIndex * percentageToMove}%);";
        await UpdateCarouselHeightAsync();
    }

    private async Task UpdateCarouselHeightAsync()
    {
        var itemsPerPage = _showTwoItems ? 2 : 1;
        await JsRuntime.InvokeVoidAsync("blazorInterop.updateCarouselHeight", "my-leagues-track-wrapper", _currentIndex, itemsPerPage);
    }

    private bool IsAtEnd()
    {
        var leaguesPerPage = _showTwoItems ? 2 : 1;
        return _currentIndex >= VisibleLeagues.Count - leaguesPerPage;
    }

    private void ViewLeagueDashboard(int leagueId)
    {
        NavigationManager.NavigateTo($"/leagues/{leagueId}/dashboard");
    }

    private static string GetShieldColour(long? rank, int? memberCount)
    {
        switch (rank)
        {
            case null:
                return "blue";

            case 1:
                return "gold";

            case 2:
                return "silver";

            case 3:
                return "bronze";
        }

        if (memberCount > 4 && rank > memberCount.Value * 0.75)
            return "red";

        return "blue";
    }

    public ValueTask DisposeAsync()
    {
        DashboardState.OnStateChange -= StateHasChanged;
        _countdownTimer?.Stop();
        _countdownTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
