@using ThePredictions.Contracts.Dashboard
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Services.Leagues
@using ThePredictions.Web.Client.Services.Theme

@inject ILeagueService LeagueService
@inject IThemeService ThemeService
@inject IJSRuntime JsRuntime

<div class="card slide @(Wide ? "round-card--wide" : "")">
    <div class="header">
        <h5 class="fw-bold text-white">@Round.SeasonName</h5>
        <small class="text-white-50 fw-bold">@RoundLabel</small>
    </div>

    <div class="body">
        <dl class="mb-0 detail-list">
            <div class="detail-row centered">
                @if (HasLiveMatch)
                {
                    <div class="badge-group badge-group--blue pulsing-blue">
                        <span class="badge-icon" title="In Progress"><i class="bi bi-play-fill"></i></span>
                        <span>In Progress</span>
                    </div>
                }
                else if (NextPredictionDeadlineUtc is { } nextDeadline)
                {
                    @if ((nextDeadline - DateTime.UtcNow).TotalHours < 24)
                    {
                        <CountdownTimer DeadlineUtc="nextDeadline" />
                    }
                    else
                    {
                        <div class="badge-group badge-group--red">
                            <span class="badge-icon" title="Deadline"><i class="bi bi-alarm"></i></span>
                            <LocalTime UtcDate="@nextDeadline"/>
                        </div>
                    }
                }
                else
                {
                    <div class="badge-group badge-group--blue">
                        <span class="badge-icon" title="In Progress"><i class="bi bi-play-fill"></i></span>
                        <span>In Progress</span>
                    </div>
                }
            </div>
        </dl>

        @if (Round.Matches.Any())
        {
            <div class="match-preview">
                <div class="match-preview-grid">
                @foreach (var match in Round.Matches)
                {
                    if (!match.AreTeamsConfirmed)
                    {
                        @* A knockout slot whose teams are not known yet. It takes the same four lines as a
                           confirmed fixture - question marks where the badges go, the placeholder names on
                           the names line - so a part-drawn round reads as one list rather than two. *@
                        <div class="match-preview-row match-preview-row--tbc">
                            <div class="match-preview-meta">
                                <span class="match-preview-outcome">
                                    <TargetIcon Outcome="match.Outcome" ShowPending="true" />
                                </span>
                                <span class="match-preview-kickoff">
                                    <LocalTime UtcDate="match.MatchDateTimeUtc" Format="ddd dd MMM HH:mm" />
                                </span>
                                <span class="match-preview-actual match-preview-actual--awaiting" title="Not started">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                </span>
                            </div>
                            <div class="match-preview-fixture">
                                <div class="match-preview-side match-preview-side--home">
                                    <span class="match-preview-tbc-logo"><i class="bi bi-question-circle"></i></span>
                                    <span class="match-preview-name">@(match.PlaceholderHomeName ?? "TBC")</span>
                                </div>
                                <div class="match-preview-scores">
                                    <span class="match-preview-vs">v</span>
                                </div>
                                <div class="match-preview-side match-preview-side--away">
                                    <span class="match-preview-tbc-logo"><i class="bi bi-question-circle"></i></span>
                                    <span class="match-preview-name">@(match.PlaceholderAwayName ?? "TBC")</span>
                                </div>
                            </div>
                            @if (HasOwnLockTime(match))
                            {
                                <MatchLockLine LockUtc="match.CustomLockTimeUtc!.Value" />
                            }
                            <PredictionSplitBar Home="match.HomeCount"
                                                Draw="match.DrawCount"
                                                Away="match.AwayCount"
                                                Revealed="match.IsPredictionRevealed" />
                        </div>

                        continue;
                    }

                    @* Three fixed blocks, whatever state the match is in - the meta line, the fixture
                       (each side's badge and name in one column, either side of the predicted score),
                       then the prediction split. The tile therefore keeps one height for its whole life
                       instead of growing as each match locks, kicks off and finishes. *@
                    <div class="match-preview-row @GetMatchBackgroundClass(match) @GetMatchPulsingClass(match)">
                        <div class="match-preview-meta">
                            <span class="match-preview-outcome">
                                <TargetIcon Outcome="match.Outcome" ShowPending="true" />
                            </span>
                            <span class="match-preview-kickoff">
                                <LocalTime UtcDate="match.MatchDateTimeUtc" Format="ddd dd MMM HH:mm" />
                            </span>
                            @if (!HasActualScore(match))
                            {
                                @* Holds the result slot before kick-off. A clock rather than a score, so the
                                   slot reads as "nothing here yet" instead of as a nil-nil draw. *@
                                <span class="match-preview-actual match-preview-actual--awaiting" title="Not started">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                </span>
                            }
                            else
                            {
                                <span class="match-preview-actual">
                                    @if (match.Status == MatchStatus.InProgress)
                                    {
                                        <span class="match-preview-actual-status">
                                            <span class="match-live-dot" title="Live"></span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="match-preview-actual-status match-preview-actual-status--ft">FT</span>
                                    }
                                    <span class="match-preview-actual-score">@($"{match.ActualHomeScore} - {match.ActualAwayScore}")</span>
                                </span>
                            }
                        </div>
                        <div class="match-preview-fixture">
                            <div class="match-preview-side match-preview-side--home">
                                <img src="@(match.HomeTeamLogoUrl ?? "images/placeholders/team-badge-unknown.svg")"
                                     class="match-preview-logo"
                                     alt="Home"
                                     loading="lazy"
                                     onerror="this.onerror=null; this.src='images/placeholders/team-badge-unknown.svg';" />
                                <span class="match-preview-name">@(match.HomeTeamShortName ?? "Home")</span>
                            </div>
                            <div class="match-preview-scores">
                                <span class="match-preview-score">@(match.PredictedHomeScore?.ToString() ?? "-")</span>
                                <span class="match-preview-vs">@(HasPrediction(match) ? "-" : "v")</span>
                                <span class="match-preview-score">@(match.PredictedAwayScore?.ToString() ?? "-")</span>
                            </div>
                            <div class="match-preview-side match-preview-side--away">
                                <img src="@(match.AwayTeamLogoUrl ?? "images/placeholders/team-badge-unknown.svg")"
                                     class="match-preview-logo"
                                     alt="Away"
                                     loading="lazy"
                                     onerror="this.onerror=null; this.src='images/placeholders/team-badge-unknown.svg';" />
                                <span class="match-preview-name">@(match.AwayTeamShortName ?? "Away")</span>
                            </div>
                        </div>
                        @if (HasOwnLockTime(match))
                        {
                            <MatchLockLine LockUtc="match.CustomLockTimeUtc!.Value" />
                        }
                        <PredictionSplitBar Home="match.HomeCount"
                                            Draw="match.DrawCount"
                                            Away="match.AwayCount"
                                            UserChoice="@GetUserChoice(match)"
                                            Revealed="match.IsPredictionRevealed" />
                    </div>
                }
                </div>
            </div>
        }
    </div>
    <div class="footer">
        @if (!IsClosedForPredictions)
        {
            <NavLink href="@($"/predictions/{Round.Id}")" class="btn green-button">
                @if (Round.HasUserPredicted)
                {
                    <span class="bi bi-pencil-fill me-2"></span>
                    <span>Edit Predictions</span>
                }
                else
                {
                    <span class="bi bi-pencil me-2"></span>
                    <span>Predict Now</span>
                }
            </NavLink>
        }
        else if (Round.OutcomeSummary != null)
        {
            <div class="outcome-summary">
                <span class="outcome-item outcome-item--exact" title="Exact score">
                    <TargetIcon Outcome="PredictionOutcome.ExactScore" />
                    <span>@Round.OutcomeSummary.ExactScoreCount</span>
                </span>
                <span class="outcome-separator">·</span>
                <span class="outcome-item outcome-item--correct" title="Correct result">
                    <TargetIcon Outcome="PredictionOutcome.CorrectResult" />
                    <span>@Round.OutcomeSummary.CorrectResultCount</span>
                </span>
                <span class="outcome-separator">·</span>
                <span class="outcome-item outcome-item--incorrect" title="Incorrect">
                    <TargetIcon Outcome="PredictionOutcome.Incorrect" />
                    <span>@Round.OutcomeSummary.IncorrectCount</span>
                </span>
            </div>
        }

        @if (Round.HasUserPredicted)
        {
            <button type="button" class="btn purple-button" @onclick="SharePredictionsAsync" disabled="@_isSharing">
                @if (_isSharing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Preparing...</span>
                }
                else
                {
                    <span class="bi bi-share-fill me-2"></span>
                    <span>Share</span>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ActiveRoundDto Round { get; set; } = null!;

    /// <summary>
    /// True when this card is the sole active round shown full-width on a large desktop. Keeps the footer
    /// call-to-action from stretching the whole width; the four-column match layout is handled by the
    /// card-width container query in round-cards.css.
    /// </summary>
    [Parameter]
    public bool Wide { get; set; }

    private bool _isSharing;

    // Fetches a server-rendered PNG of the user's predictions for this round and hands it to the
    // native share sheet (Web Share API), falling back to a download on browsers without file
    // sharing. Best-effort: any failure or a user-cancelled share sheet is a silent no-op.
    private async Task SharePredictionsAsync()
    {
        if (_isSharing)
            return;

        _isSharing = true;

        try
        {
            var image = await LeagueService.GetShareCardAsync(Round.Id, ThemeService.CurrentTheme);

            if (image is null || image.Length == 0)
                return;

            var base64 = Convert.ToBase64String(image);
            var fileName = $"predictions-round-{Round.Id}.png";
            var shareText = $"My {RoundLabel} predictions for {Round.SeasonName}";

            await JsRuntime.InvokeAsync<string>("blazorInterop.sharePredictions", base64, fileName, "My Predictions", shareText);
        }
        catch
        {
            // Sharing is best-effort; never surface an error on the dashboard tile.
        }
        finally
        {
            _isSharing = false;
        }
    }

    // True only when a match is actually being played right now. The header shows the pulsing "In Progress"
    // badge for this; in the gap between batches (previous batch finished, next batch not yet under way) it
    // shows the next batch's deadline instead, since predictions are open and nothing is live.
    private bool HasLiveMatch => Round.Matches.Any(m => m.Status == MatchStatus.InProgress);

    // Whether the round can still be predicted. Keyed off the latest per-match lock, not the round deadline,
    // so a combined round (for example semi-finals plus the final and third-place playoff) keeps showing the
    // Predict / Edit button while its later matches are still open even though the round deadline has passed.
    private bool IsClosedForPredictions => Round.LatestPredictionDeadlineUtc <= DateTime.UtcNow;

    // The next batch to lock: the earliest per-match effective deadline still in the future (a match's own
    // CustomLockTimeUtc, or the round deadline when it has none), or null once everything has locked.
    private DateTime? NextPredictionDeadlineUtc
    {
        get
        {
            var now = DateTime.UtcNow;
            DateTime? next = null;

            foreach (var match in Round.Matches)
            {
                if (!match.AreTeamsConfirmed || match.Status == MatchStatus.Postponed)
                    continue;

                var effectiveDeadline = match.CustomLockTimeUtc ?? Round.DeadlineUtc;

                if (effectiveDeadline > now && (next == null || effectiveDeadline < next.Value))
                    next = effectiveDeadline;
            }

            return next;
        }
    }

    private string RoundLabel =>
        Round.IsTournament && !string.IsNullOrWhiteSpace(Round.RoundDisplayName)
            ? Round.RoundDisplayName
            : $"Round {Round.RoundNumber}";

    private static string GetMatchBackgroundClass(ActiveRoundMatchDto match)
    {
        return match.Outcome switch
        {
            PredictionOutcome.ExactScore => "match-outcome-exact",
            PredictionOutcome.CorrectResult => "match-outcome-correct-result",
            PredictionOutcome.Incorrect => "match-outcome-incorrect",
            _ => "" // Pending or null - use default background
        };
    }

    // Whether this match locks at a moment the card header is not already showing. Most matches lock with
    // the round, so a lock line on every tile would just repeat the round deadline ten times over; a combined
    // round (semi-finals plus the final, say) is where a match keeps its own time, and that is worth calling
    // out. Once it has locked the time is history, so the line goes.
    private bool HasOwnLockTime(ActiveRoundMatchDto match)
    {
        return !match.IsPredictionRevealed
            && match.CustomLockTimeUtc is { } lockUtc
            && lockUtc != Round.DeadlineUtc;
    }

    // Whether the player has a prediction on this match at all. Drives the separator between the two
    // predicted scores: a "-" reads as a scoreline, so an unpredicted fixture gets a "v" instead and
    // the row cannot be mistaken for a nil-nil.
    private static bool HasPrediction(ActiveRoundMatchDto match)
    {
        return match is { PredictedHomeScore: not null, PredictedAwayScore: not null };
    }

    private static bool HasActualScore(ActiveRoundMatchDto match)
    {
        return match is { ActualHomeScore: not null, ActualAwayScore: not null }
            && match.Status is MatchStatus.InProgress or MatchStatus.Completed;
    }

    // The logged-in user's own pick for this match ("H"/"D"/"A"), or null if they did not predict.
    // The card already carries the current user's own predicted score, so no user id is needed here.
    private static string? GetUserChoice(ActiveRoundMatchDto match)
    {
        if (match.PredictedHomeScore == null || match.PredictedAwayScore == null)
            return null;

        if (match.PredictedHomeScore > match.PredictedAwayScore)
            return "H";

        if (match.PredictedHomeScore < match.PredictedAwayScore)
            return "A";

        return "D";
    }

    private static string GetMatchPulsingClass(ActiveRoundMatchDto match)
    {
        if (match.Status != MatchStatus.InProgress)
            return "";

        return match.Outcome switch
        {
            PredictionOutcome.ExactScore => "pulsing-green",
            PredictionOutcome.CorrectResult => "pulsing-orange",
            PredictionOutcome.Incorrect => "pulsing-red",
            _ => ""
        };
    }
}
