@inject IDashboardStateService DashboardState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

@implements IDisposable

@inherits BaseLeaderboardComponent

@using ThePredictions.Contracts.Leaderboards
@using ThePredictions.Web.Client.Services.Dashboard

<div class="section h-100 section--constrained">
    <h3 class="text-white text-center fw-bold mb-4">Standings</h3>

    <ApiError Message="@DashboardState.LeaderboardsErrorMessage" />

    @if (DashboardState.IsLeaderboardsLoading)
    {
        <div class="d-flex justify-content-center align-items-center flex-grow-1">
            <div class="spinner-border text-white" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!DashboardState.Leaderboards.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
            <i class="bi bi-bar-chart-line empty-state-icon"></i>
            <p class="text-white-50 mt-2 mb-0 text-center">No active leaderboards.</p>
        </div>
    }
    else if (!VisibleLeaderboards.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
            <i class="bi bi-archive empty-state-icon"></i>
            <p class="text-white-50 mt-2 mb-0 text-center">All your standings are archived.</p>
            @if (ArchivedLeaderboardCount > 0)
            {
                <button type="button" class="archive-toggle-link mt-3" @onclick="ToggleShowArchived">
                    @($"Show {ArchivedLeaderboardCount} archived {(ArchivedLeaderboardCount == 1 ? "league" : "leagues")}")
                </button>
            }
        </div>
    }
    else
    {
        <div class="carousel-wrapper">
            <div class="carousel-container" @ontouchstart="HandleTouchStart" @ontouchmove="HandleTouchMove" @ontouchend="HandleTouchEnd">
                @if (VisibleLeaderboards.Count > 1)
                {
                    <button class="carousel-btn" @onclick="ShowPrevious" disabled="@(_currentIndex == 0)">
                        <span class="bi bi-chevron-left"></span>
                    </button>
                }

                <div class="carousel-track-wrapper" id="leaderboards-track-wrapper">
                <div class="carousel-track" style="@_trackStyle">
                    @foreach (var leaderboard in VisibleLeaderboards)
                    {
                        <div class="carousel-item-wrapper">
                            <div class="carousel-item-content">
                                <div class="card slide">
                                    <div class="header w-100">
                                        <h5 class="text-white fw-bold text-center">@leaderboard.LeagueName</h5>
                                        <small class="text-white-50 text-center fw-bold">@leaderboard.SeasonName</small>
                                    </div>
                                    <div class="body leaderboard-body justify-start w-100">
                                        <div id="leaderboard-scroll-@leaderboard.LeagueId" class="leaderboard-scroll-container">
                                            <table class="leaderboard-table leaderboard-table--dashboard table-striped-purple light text-white">
                                                <thead>
                                                    <tr>
                                                        @if (leaderboard.Entries.First().IsRoundInProgress)
                                                        {
                                                            <th class="rank-change-col"></th>
                                                        }
                                                        <th class="rank-col">#</th>
                                                        <th class="player-name-col">Player</th>
                                                        <th class="points-col">Points</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var entry in leaderboard.Entries)
                                                    {
                                                        <tr class="@(GetUserHighlightClass(entry.UserId)) test @entry.UserId">
                                                            @if (entry.IsRoundInProgress)
                                                            {
                                                                <td class="rank-change-col">
                                                                    <RankChangeArrow PreviousRank="@entry.SnapshotRank"
                                                                                     CurrentRank="@entry.Rank"
                                                                                     IsVisible="@entry.IsRoundInProgress" />
                                                                </td>
                                                            }
                                                            <td class="rank-col fw-bold">@entry.Rank</td>
                                                            <td class="player-name-col fw-bold">@entry.PlayerName</td>
                                                            <td class="points-col fw-bold">@entry.TotalPoints</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="footer">
                                        @{
                                            var isFinishedOrArchived = leaderboard.IsFinished || leaderboard.IsArchivedByUser;
                                        }
                                        <button class="btn purple-accent-button w-100" @onclick="() => ViewLeagueDashboard(leaderboard.LeagueId)">
                                            View Dashboard
                                        </button>
                                        @if (isFinishedOrArchived)
                                        {
                                            var archiveLabel = leaderboard.IsArchivedByUser ? "Unarchive League" : "Archive League";
                                            var archiveIcon = leaderboard.IsArchivedByUser ? "bi-arrow-counterclockwise" : "bi-archive";
                                            <button class="btn archive-season-button w-100"
                                                    aria-label="@archiveLabel"
                                                    @onclick="() => ToggleArchive(leaderboard)">
                                                <i class="bi @archiveIcon me-2"></i>@archiveLabel
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                </div>

                @if (VisibleLeaderboards.Count > 1)
                {
                    <button class="carousel-btn" @onclick="ShowNext" disabled="@(_currentIndex >= VisibleLeaderboards.Count - 1)">
                        <span class="bi bi-chevron-right"></span>
                    </button>
                }
            </div>

            @if (VisibleLeaderboards.Count > 1)
            {
                <div class="carousel-dots">
                    @for (var i = 0; i < VisibleLeaderboards.Count; i++)
                    {
                        var index = i;
                        <span class="carousel-dot @(index == _currentIndex ? "active" : "")" @onclick="() => GoToSlide(index)"></span>
                    }
                </div>
            }
        </div>
    }

    @if (ArchivedLeaderboardCount > 0)
    {
        <div class="archive-toggle-row">
            <button type="button" class="archive-toggle-link" @onclick="ToggleShowArchived">
                @if (_showArchived)
                {
                    <i class="bi bi-chevron-up me-1"></i>
                    @($"Hide {ArchivedLeaderboardCount} archived {(ArchivedLeaderboardCount == 1 ? "league" : "leagues")}")
                }
                else
                {
                    <i class="bi bi-archive me-1"></i>
                    @($"Show {ArchivedLeaderboardCount} archived {(ArchivedLeaderboardCount == 1 ? "league" : "leagues")}")
                }
            </button>
        </div>
    }
</div>

@code {
    private int _currentIndex;
    private double _touchStartX;
    private string _trackStyle = "transform: translateX(0%);";
    private bool _showArchived;

    // Archived standings are hidden by default and, when revealed, appended after the active
    // ones so the carousel always opens on a live league rather than a completed one.
    private List<LeagueLeaderboardDto> VisibleLeaderboards =>
        _showArchived
            ? DashboardState.Leaderboards.Where(l => !l.IsArchivedByUser)
                .Concat(DashboardState.Leaderboards.Where(l => l.IsArchivedByUser))
                .ToList()
            : DashboardState.Leaderboards.Where(l => !l.IsArchivedByUser).ToList();

    private int ArchivedLeaderboardCount => DashboardState.Leaderboards.Count(l => l.IsArchivedByUser);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        DashboardState.OnStateChange += StateHasChanged;
        await DashboardState.LoadLeaderboardsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && VisibleLeaderboards.Any())
        {
            foreach (var leaderboard in VisibleLeaderboards)
            {
                await JsRuntime.InvokeVoidAsync("blazorInterop.scrollToUserRow", $"leaderboard-scroll-{leaderboard.LeagueId}");
            }
        }
    }

    private void ToggleShowArchived()
    {
        _showArchived = !_showArchived;
        _currentIndex = 0;
        UpdateTrackStyle();
    }

    private async Task ToggleArchive(LeagueLeaderboardDto leaderboard)
    {
        await DashboardState.SetLeagueArchivedAsync(leaderboard.LeagueId, !leaderboard.IsArchivedByUser);
        _currentIndex = 0;
        UpdateTrackStyle();
    }

    private void HandleTouchStart(TouchEventArgs e) => _touchStartX = e.Touches[0].ClientX;
    private static void HandleTouchMove(TouchEventArgs e) { }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        var touchEndX = e.ChangedTouches[0].ClientX;
        var diffX = _touchStartX - touchEndX;

        if (!(Math.Abs(diffX) > 50))
            return;

        if (diffX > 0)
            ShowNext();
        else
            ShowPrevious();
    }

    private void GoToSlide(int index)
    {
        _currentIndex = index;
        UpdateTrackStyle();
    }

    private void ShowPrevious()
    {
        if (_currentIndex <= 0)
            return;

        _currentIndex--;
        UpdateTrackStyle();
    }

    private void ShowNext()
    {
        if (_currentIndex >= VisibleLeaderboards.Count - 1)
            return;

        _currentIndex++;
        UpdateTrackStyle();
    }

    private void UpdateTrackStyle()
    {
        _trackStyle = $"transform: translateX(-{_currentIndex * 100}%);";
    }

    private void ViewLeagueDashboard(int leagueId)
    {
        NavigationManager.NavigateTo($"/leagues/{leagueId}/dashboard");
    }

    public void Dispose()
    {
        DashboardState.OnStateChange -= StateHasChanged;
    }
}