@inject ILeagueService LeagueService
@inject IDashboardStateService DashboardState
@inject IPayoutService PayoutService
@inject NavigationManager Navigation

@using ThePredictions.Contracts.Leagues
@using ThePredictions.Contracts.Prizes
@using ThePredictions.Web.Client.Services.Dashboard
@using ThePredictions.Web.Client.Services.Leagues
@using ThePredictions.Web.Client.Services.Payouts

<div class="modal fade" id="joinPrivateLeagueModal" data-test-id="join-private-modal" tabindex="-1" aria-labelledby="joinPrivateLeagueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered @(_step == Step.Confirm ? "modal-lg" : string.Empty)">
        <div class="modal-content themed-modal">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="joinPrivateLeagueModalLabel">@Title</h5>
                <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (_needsSeasonPass)
                {
                    @* Not an error: they have done nothing wrong, they simply have not bought into this season yet. *@
                    <div class="alert alert-info" role="alert">
                        <p class="mb-2 fw-bold">You need a Season Pass first</p>
                        <p class="mb-3">A Season Pass covers you for every league in that season. Get one and you can come
                            straight back to join this league.</p>
                        <button type="button" class="btn purple-accent-button" @onclick="GoToSeasonPasses">Get a Season Pass</button>
                    </div>
                }
                else
                {
                    <ApiError Message="@_errorMessage" />
                }

                @if (_step == Step.Loading)
                {
                    @if (_errorMessage is null)
                    {
                        <div class="text-center py-4"><span class="spinner-border" role="status"></span></div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" class="btn neutral-button" @onclick="Close">Close</button>
                        </div>
                    }
                }
                else if (_step == Step.Code)
                {
                    <EditForm Model="_model" OnValidSubmit="HandleContinueAsync">
                        <FluentValidationValidator />
                        <div class="mb-3">
                            <label for="entryCode" class="form-label">Entry Code</label>
                            <InputText id="entryCode" class="form-control" data-test-id="join-entry-code" @bind-Value="_model.EntryCode" placeholder="Enter 6-character code" />
                            <StyledValidationMessage For="@(() => _model.EntryCode)" />
                        </div>

                        <div class="d-flex justify-content-end align-items-center mt-4">
                            <button type="button" class="btn neutral-button me-2" @onclick="Close">
                                <span class="bi bi-x-circle me-2"></span>Cancel
                            </button>
                            <button type="submit" class="btn green-button" data-test-id="join-continue" disabled="@_isBusy">
                                @if (_isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Finding league...</span>
                                }
                                else
                                {
                                    <span>Continue</span>
                                    <span class="bi bi-arrow-right-circle ms-2"></span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
                else if (_step == Step.Confirm && _preview is not null)
                {
                    <div class="join-preview" data-test-id="join-preview">
                        <h4 class="fw-bold mb-1">@_preview.LeagueName</h4>
                        <p class="text-muted mb-3">Run by @_preview.AdministratorName</p>

                        <div class="prize-preview-stats">
                            <div class="prize-preview-stat">
                                <span class="prize-preview-stat-label">Entry fee</span>
                                <span class="prize-preview-stat-value">@(_preview.EntryCost > 0 ? $"£{_preview.EntryCost:0}" : "Free")</span>
                            </div>
                            <div class="prize-preview-stat">
                                <span class="prize-preview-stat-label">Players so far</span>
                                <span class="prize-preview-stat-value">@_preview.EntrantCount</span>
                            </div>
                            @if (_preview.EntryCost > 0)
                            {
                                <div class="prize-preview-stat">
                                    <span class="prize-preview-stat-label">Current prize pot</span>
                                    <span class="prize-preview-stat-value">£@_preview.CurrentPrizePot.ToString("0")</span>
                                </div>
                            }
                            else
                            {
                                <div class="prize-preview-stat">
                                    <span class="prize-preview-stat-label">Season</span>
                                    <span class="prize-preview-stat-value">@_preview.SeasonName</span>
                                </div>
                            }
                            <div class="prize-preview-stat">
                                <span class="prize-preview-stat-label">Entry deadline</span>
                                <span class="prize-preview-stat-value">@(_preview.EntryDeadlineUtc is { } deadline ? deadline.ToLocalTime().ToString("d MMM yyyy, HH:mm") : "Not set")</span>
                            </div>
                        </div>

                        @if (_preview.DeadlinePassed)
                        {
                            <div class="message-box-solid warning mb-3">The entry deadline for this league has passed, so you can no longer join.</div>
                        }

                        @if (_preview.HasPrizes)
                        {
                            <PrizeBreakdownPreview Breakdown="_preview.Breakdown"
                                                   ShowDeltas="!_preview.DeadlinePassed"
                                                   PotLabel="@(_preview.DeadlinePassed ? "Prize pot" : "Prize pot if you join")" />

                            @if (!_preview.DeadlinePassed && _preview.Attribution.Any())
                            {
                                <div class="prize-attribution mt-3">
                                    @foreach (var line in _preview.Attribution)
                                    {
                                        <div>@line</div>
                                    }
                                </div>
                            }
                        }
                        else if (_preview.EntryCost > 0)
                        {
                            <div class="message-box-solid info">
                                This league has a <strong>£@_preview.EntryCost.ToString("0")</strong> entry fee but no prize split set, so arrange any prizes with the admin directly.
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">This is a free-to-play league - just for the bragging rights.</p>
                        }

                        @if (_preview.Payment is not null)
                        {
                            <div class="mt-3">
                                <LeaguePaymentPanel Info="_preview.Payment" />
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="button" class="btn neutral-button" @onclick="BackAsync" disabled="@_isBusy">
                                <span class="bi bi-arrow-left-circle me-2"></span>@(IsPublic ? "Cancel" : "Back")
                            </button>
                            <button type="button" class="btn green-button" data-test-id="join-confirm" disabled="@(_isBusy || _preview.DeadlinePassed)" @onclick="ConfirmJoinAsync">
                                @if (_isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Requesting...</span>
                                }
                                else
                                {
                                    <span class="bi bi-check-circle me-2"></span>
                                    <span>Confirm &amp; request to join</span>
                                }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="mb-3" data-test-id="join-sent">
                        <span class="bi bi-check-circle-fill text-green-600 me-2"></span>
                        Your request to join has been sent to the league admin.
                    </p>

                    @if (_joinedLeagueId is not null)
                    {
                        <LeaguePaymentPanel LeagueId="_joinedLeagueId.Value" AlreadyPaidHint="true" />
                    }

                    @if (_hasPayoutDetails)
                    {
                        <div class="message-box-solid warning mt-3">
                            You have saved payout details. If this league pays prizes, its admin will be able to see them
                            to pay your winnings once you're approved. You can review or remove them on your
                            <a href="/account/payout-details">Payout details</a> page.
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" class="btn green-button" @onclick="Close">Done</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private enum Step { Loading, Code, Confirm, Sent }

    private readonly JoinLeagueRequest _model = new()
    {
        EntryCode = string.Empty
    };

    private Step _step = Step.Code;
    private bool _isBusy;
    private string? _errorMessage;
    private bool _needsSeasonPass;
    private PrizePreviewDto? _preview;
    private int? _joinedLeagueId;
    private bool _hasPayoutDetails;

    /// <summary>When set, the modal joins a public league directly (no entry code) and skips the code step.</summary>
    [Parameter] public int? LeagueId { get; set; }

    /// <summary>
    /// A code already in hand, which skips the code step the way an id does.
    /// </summary>
    /// <remarks>
    /// Set when somebody is brought back here after buying a Season Pass, so they do not have to find the league and type
    /// its code a second time.
    /// </remarks>
    [Parameter] public string? EntryCode { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsPublic => LeagueId.HasValue;

    private string Title => _step switch
    {
        Step.Confirm => "Confirm and join",
        Step.Sent => "Request sent",
        Step.Loading => "Join league",
        _ => "Join Private League"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!IsPublic && string.IsNullOrWhiteSpace(EntryCode))
            return;

        // A league we can already identify - by id, or by a code handed back to us - so fetch the preview straight away
        // and jump to the confirm step.
        _step = Step.Loading;

        if (!IsPublic)
            _model.EntryCode = EntryCode!;

        var (preview, errorMessage) = IsPublic
            ? await LeagueService.GetJoinPreviewByIdAsync(LeagueId!.Value)
            : await LeagueService.GetJoinPreviewAsync(EntryCode!);

        if (preview is not null)
        {
            _preview = preview;
            _step = Step.Confirm;
        }
        else
        {
            _errorMessage = errorMessage;
        }
    }

    private async Task HandleContinueAsync()
    {
        _isBusy = true;
        _errorMessage = null;

        var (preview, errorMessage) = await LeagueService.GetJoinPreviewAsync(_model.EntryCode);

        if (preview is not null)
        {
            _preview = preview;
            _step = Step.Confirm;
        }
        else
        {
            _errorMessage = errorMessage;
        }

        _isBusy = false;
    }

    private async Task BackAsync()
    {
        // Public joins have no code step to go back to, so Back just closes.
        if (IsPublic)
        {
            await Close();
            return;
        }

        _step = Step.Code;
        _preview = null;
        _errorMessage = null;
    }

    private async Task ConfirmJoinAsync()
    {
        _isBusy = true;
        _errorMessage = null;
        _needsSeasonPass = false;

        bool success;
        string? errorMessage;
        bool needsSeasonPass;
        int? joinedLeagueId;

        try
        {
            if (IsPublic)
            {
                (success, errorMessage, needsSeasonPass) = await LeagueService.JoinPublicLeagueAsync(LeagueId!.Value);
                joinedLeagueId = LeagueId;
            }
            else
            {
                (success, errorMessage, joinedLeagueId, needsSeasonPass) = await LeagueService.JoinPrivateLeagueAsync(_model.EntryCode);
            }
        }
        catch
        {
            // The request never came back at all - a dropped connection, a timeout, the API restarting
            // mid-deploy. The service only translates error RESPONSES, so without this the exception
            // escapes the handler and the modal sits on "Requesting..." for good: no message, both
            // buttons disabled, nothing to do but reload the page.
            _errorMessage = "We could not reach the server. Please check your connection and try again.";
            _isBusy = false;
            return;
        }

        _needsSeasonPass = needsSeasonPass;

        if (!success)
        {
            _errorMessage = errorMessage;
            _isBusy = false;
            return;
        }

        _joinedLeagueId = joinedLeagueId;

        // Confirm the join the moment it lands. The refreshes below only update the panels behind this
        // modal, and waiting for them held the player on "Requesting..." for four more round trips after
        // they had already joined.
        //
        // StateHasChanged is required, not decorative: Blazor renders an async handler once at its first
        // await and once when the whole thing finishes, so without this the new step would not appear
        // until the refreshes below had completed anyway.
        _step = Step.Sent;
        _isBusy = false;
        StateHasChanged();

        await RefreshAfterJoinAsync();
    }

    /// <summary>
    /// Brings the dashboard behind the modal up to date once a join has been confirmed.
    /// </summary>
    /// <remarks>
    /// Best effort by design. The join has already succeeded and been reported, so a failure here must not
    /// be turned into an error message that contradicts it - the panels reload on the next dashboard visit
    /// regardless.
    /// </remarks>
    private async Task RefreshAfterJoinAsync()
    {
        try
        {
            await DashboardState.LoadMyLeaguesAsync();
            await DashboardState.LoadAvailableLeaguesAsync();
            await DashboardState.LoadPendingRequestsAsync();

            _hasPayoutDetails = (await PayoutService.GetMyPayoutDetailsAsync())?.HasDetails ?? false;
        }
        catch
        {
            // Nothing worth telling the player: they have joined, and the panels catch up on their own.
        }
    }

    /// <summary>
    /// Off to buy a pass, remembering the league so that finishing there can offer to bring them back to it.
    /// </summary>
    private void GoToSeasonPasses()
    {
        DashboardState.RememberPendingJoin(new PendingJoin(
            LeagueId,
            IsPublic ? null : _model.EntryCode,
            _preview?.LeagueName ?? "your league"));

        Navigation.NavigateTo("/season-passes");
    }

    private async Task Close()
    {
        _model.EntryCode = string.Empty;
        _errorMessage = null;
        _needsSeasonPass = false;
        _isBusy = false;
        _step = Step.Code;
        _preview = null;
        _joinedLeagueId = null;
        _hasPayoutDetails = false;
        await OnClose.InvokeAsync();
    }
}
