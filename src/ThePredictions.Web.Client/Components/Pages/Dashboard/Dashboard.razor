@using ThePredictions.Web.Client.Services.Dashboard
@using ThePredictions.Web.Client.Services.Live
@using ThePredictions.Contracts.Onboarding

@page "/dashboard"

@attribute [Authorize]
@inject IDashboardStateService DashboardState
@inject LiveScorePollingService Poller
@inject IPageVisibilityService Visibility
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorizing>
        <div class="app-loading-container">
            <div class="spinner"></div>
            <p>Authorising...</p>
        </div>
    </Authorizing>
    <Authorized>
        <div class="page-container page-container--fits-content">
            @{
                var showPendingMembers = !DashboardState.IsPendingMembersLoading && DashboardState.IsAdminOfOpenLeague;
                var showPendingRequests = DashboardState.PendingRequests.Any() || DashboardState.IsPendingRequestsLoading;
                var showBothAlertTiles = showPendingMembers && showPendingRequests;
                var hasCompanionTile = showPendingMembers || showPendingRequests;
                var activeRoundsHalfWidth = hasCompanionTile && !showBothAlertTiles;
                var activeRoundsClass = activeRoundsHalfWidth ? "col-lg-6 mb-4" : "col-lg-12 mb-4";
                var showAvailableLeagues = DashboardState.IsAvailableLeaguesLoading || DashboardState.AvailableLeagues.Any() || DashboardState.HasAvailablePrivateLeagues;
                var myLeaguesClass = showAvailableLeagues ? "col-lg-6 mb-4 mb-md-0" : "col-lg-12 mb-4 mb-lg-0";
                var showAdminTab = showPendingMembers || showPendingRequests;

                var onboarding = DashboardState.OnboardingChecklist;
                var onboardingTakeover = onboarding is { RequiredComplete: false };
                var showOnboardingChecklist = onboarding is { HasOutstandingSteps: true };
                var onboardingHasPass = onboarding?.Steps.Any(s => s.Key == OnboardingStepKeys.GetPass && s.State == "Completed") ?? false;
            }

            @if (onboardingTakeover)
            {
                <div class="dashboard-container" data-test-id="dashboard">
                    @if (onboardingHasPass)
                    {
                        <OnboardingChecklist />
                        <div class="row">
                            <div class="col-lg-6 mb-4">
                                <MyLeaguesTile IsHalfWidth="true" />
                            </div>
                            <div class="col-lg-6 mb-4">
                                <AvailableLeaguesTile />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row justify-content-center">
                            <div class="col-lg-8 col-xl-7">
                                <OnboardingChecklist />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
            <div class="dashboard-container dashboard--tab-@_activeTab" data-test-id="dashboard">
                @if (showOnboardingChecklist)
                {
                    <OnboardingChecklist />
                }
                else
                {
                    <DashboardPrompts Prompts="DashboardState.Prompts" />
                }
                <div class="dashboard-tabs d-lg-none">
                    <button type="button" class="dashboard-tab @(_activeTab == "play" ? "dashboard-tab--active" : "")" @onclick='() => _activeTab = "play"'>
                        <span class="bi bi-lightning-fill"></span>
                        <span>Play</span>
                    </button>
                    <button type="button" class="dashboard-tab @(_activeTab == "leagues" ? "dashboard-tab--active" : "")" @onclick='() => _activeTab = "leagues"'>
                        <span class="bi bi-trophy-fill"></span>
                        <span>Leagues</span>
                    </button>
                    <button type="button" class="dashboard-tab @(_activeTab == "standings" ? "dashboard-tab--active" : "")" @onclick='() => _activeTab = "standings"'>
                        <span class="bi bi-bar-chart-fill"></span>
                        <span>Standings</span>
                    </button>
                    @if (showAdminTab)
                    {
                        <button type="button" class="dashboard-tab @(_activeTab == "admin" ? "dashboard-tab--active" : "")" @onclick='() => _activeTab = "admin"'>
                            <span class="bi bi-gear-fill"></span>
                            <span>Admin</span>
                        </button>
                    }
                </div>

                <div class="row align-items-stretch">
                    <div class="col-xxl-8">
                        @if (showBothAlertTiles)
                        {
                            <div class="row">
                                <div class="col-lg-6 mb-4" data-tab="admin">
                                    <PendingMembersTile />
                                </div>
                                <div class="col-lg-6 mb-4" data-tab="admin">
                                    <PendingRequestsTile />
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="@activeRoundsClass" data-tab="play">
                                <ActiveRoundsTile IsHalfWidth="activeRoundsHalfWidth" />
                            </div>

                            @if (!showBothAlertTiles && showPendingMembers)
                            {
                                <div class="col-lg-6 mb-4" data-tab="admin">
                                    <PendingMembersTile />
                                </div>
                            }
                            else if (!showBothAlertTiles && showPendingRequests)
                            {
                                <div class="col-lg-6 mb-4" data-tab="admin">
                                    <PendingRequestsTile />
                                </div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-lg-12 mb-4" data-tab="play">
                                <BadgesTile />
                            </div>
                        </div>

                        <div class="row">
                            <div class="@myLeaguesClass" data-tab="leagues">
                                <MyLeaguesTile IsHalfWidth="showAvailableLeagues" />
                            </div>

                            @if (showAvailableLeagues)
                            {
                                <div class="col-lg-6 mb-4 mb-md-0" data-tab="leagues">
                                    <AvailableLeaguesTile />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-xxl-4 mt-4 mt-xxl-0" data-tab="standings">
                        <LeaderboardsTile />
                    </div>
                </div>
            </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly string[] AllowedTabs = ["play", "leagues", "standings", "admin"];

    private string _activeTab = "play";

    // Lets emails/links open a specific tab, e.g. /dashboard?tab=admin (used by the join-request email).
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DashboardState.OnStateChange += OnStateChanged;

        if (!string.IsNullOrWhiteSpace(Tab) && AllowedTabs.Contains(Tab))
            _activeTab = Tab;

        await Task.WhenAll(
            DashboardState.LoadMyLeaguesAsync(),
            DashboardState.LoadAvailableLeaguesAsync(),
            DashboardState.LoadAvailableSeasonPassesAsync(),
            DashboardState.LoadOnboardingAsync(),
            DashboardState.LoadLeaderboardsAsync(),
            DashboardState.LoadActiveRoundsAsync(),
            DashboardState.LoadPendingRequestsAsync(),
            DashboardState.LoadPendingMembersAsync()
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Visibility.InitialiseAsync();
        EnsurePolling();
    }

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
            EnsurePolling();
        });
    }

    // Poll for live scores/standings only while a round is in progress; the poll
    // loop itself pauses while the tab is hidden and stops once nothing is live.
    private void EnsurePolling()
    {
        if (DashboardState.IsAnyRoundLive)
        {
            Poller.Start(() => DashboardState.IsAnyRoundLive, _ => DashboardState.RefreshLiveDataAsync());
        }
        else
        {
            Poller.Stop();
        }
    }

    public ValueTask DisposeAsync()
    {
        DashboardState.OnStateChange -= OnStateChanged;
        Poller.Stop();
        return ValueTask.CompletedTask;
    }
}