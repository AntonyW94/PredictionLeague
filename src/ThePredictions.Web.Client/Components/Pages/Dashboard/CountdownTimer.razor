@implements IAsyncDisposable
@using ThePredictions.Web.Client.Services.Time
@inject ICountdownTickService Ticks

<div class="badge-group badge-group--red">
    <span class="badge-icon" title="Deadline">
        <i class="bi bi-alarm"></i>
    </span>
    <span>
        @_timeRemaining
    </span>
</div>

@code {
    [Parameter, EditorRequired]
    public DateTime DeadlineUtc { get; set; }

    private string _timeRemaining = "";

    protected override async Task OnInitializedAsync()
    {
        UpdateDisplay();

        await Ticks.SubscribeAsync(OnTick);
    }

    private void OnTick()
    {
        UpdateDisplay();
        StateHasChanged();
    }

    private void UpdateDisplay()
    {
        var remaining = DeadlineUtc - DateTime.UtcNow;
        _timeRemaining = remaining.TotalSeconds <= 0 ? "Deadline Passed" : $"{(int)remaining.TotalHours:D2}:{remaining.Minutes:D2}:{remaining.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        await Ticks.UnsubscribeAsync(OnTick);
    }
}
