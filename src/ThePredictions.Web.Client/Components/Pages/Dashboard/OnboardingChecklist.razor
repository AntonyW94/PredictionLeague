@inject IDashboardStateService DashboardState
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable
@using ThePredictions.Contracts.Onboarding
@using ThePredictions.Web.Client.Services.Dashboard

@{
    var checklist = DashboardState.OnboardingChecklist;
}

@if (checklist is not null && checklist.HasOutstandingSteps)
{
    var visibleSteps = checklist.Steps.Where(s => s.State != "Skipped").ToList();
    var doneCount = visibleSteps.Count(s => s.State == "Completed");
    var percent = visibleSteps.Count == 0 ? 0 : (int)Math.Round(100.0 * doneCount / visibleSteps.Count);
    var stepNumber = 0;

    <div class="onboarding-card">
        <div class="onboarding-card__banner">
            @if (checklist.RequiredComplete)
            {
                <button type="button" class="onboarding-card__dismiss" @onclick="DismissAsync" aria-label="Dismiss">
                    <span class="bi bi-x-lg"></span>
                </button>
            }
            <div class="onboarding-card__banner-top">
                <span class="onboarding-card__badge bi @(checklist.RequiredComplete ? "bi-trophy-fill" : "bi-rocket-takeoff-fill")" aria-hidden="true"></span>
                <div class="onboarding-card__heading">
                    @if (checklist.RequiredComplete)
                    {
                        <h3 class="onboarding-card__title">You're all set</h3>
                        <p class="onboarding-card__subtitle">Nice one@(string.IsNullOrWhiteSpace(_firstName) ? "" : $", {_firstName}") - you're in the game. Finish these optional extras whenever you fancy.</p>
                    }
                    else
                    {
                        <h3 class="onboarding-card__title">Welcome@(string.IsNullOrWhiteSpace(_firstName) ? "" : $", {_firstName}")</h3>
                        <p class="onboarding-card__subtitle">Predict the scores, beat your mates, climb the table. Let's get you playing - it only takes a minute.</p>
                    }
                </div>
            </div>

            <div class="onboarding-progress">
                <div class="onboarding-progress__track">
                    <div class="onboarding-progress__fill" style="width: @(percent)%"></div>
                </div>
                <span class="onboarding-progress__label">@doneCount of @visibleSteps.Count done</span>
            </div>
        </div>

        <ul class="onboarding-steps onboarding-card__body">
            @foreach (var step in visibleSteps)
            {
                stepNumber++;
                var number = stepNumber;
                <li class="onboarding-step onboarding-step--@step.State.ToLowerInvariant()">
                    <span class="onboarding-step__marker" aria-hidden="true">
                        @if (step.State == "Completed")
                        {
                            <span class="bi bi-check-lg"></span>
                        }
                        else if (step.State == "Locked")
                        {
                            <span class="bi bi-lock-fill"></span>
                        }
                        else
                        {
                            @number
                        }
                    </span>

                    <div class="onboarding-step__main">
                        <div class="onboarding-step__body">
                            <span class="onboarding-step__title">
                                @step.Title
                                @if (!step.Required)
                                {
                                    <span class="onboarding-step__optional">Optional</span>
                                }
                            </span>
                            <span class="onboarding-step__hint">@StepHint(step.Key)</span>
                        </div>

                        @if (step.State == "Active")
                        {
                            <span class="onboarding-step__actions">
                                @if (step.Skippable)
                                {
                                    <button type="button" class="btn btn-sm onboarding-step__skip" @onclick="() => SkipAsync(step.Key)">Skip</button>
                                }

                                @if (step.Key == OnboardingStepKeys.JoinLeague)
                                {
                                    <button type="button" class="btn green-button btn-sm" @onclick="ShowJoinModalAsync">Join with a code</button>
                                    <a class="btn blue-light-button btn-sm" href="/leagues/create">Create a league</a>
                                }
                                else
                                {
                                    <a class="btn green-button btn-sm" href="@step.ActionHref">@step.ActionLabel</a>
                                }
                            </span>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
}

@if (_showJoinModal)
{
    <JoinPrivateLeagueModal OnClose="HideJoinModalAsync" />
}

@code {
    private bool _showJoinModal;
    private string? _firstName;

    protected override async Task OnInitializedAsync()
    {
        DashboardState.OnStateChange += StateHasChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _firstName = authState.User.FindFirst("FirstName")?.Value;
    }

    private static string StepHint(string key) => key switch
    {
        OnboardingStepKeys.GetPass => "Your free ticket to play this season.",
        OnboardingStepKeys.JoinLeague => "Go head-to-head with friends, or join a public league.",
        OnboardingStepKeys.AddMobile => "Add your mobile number to finish setting up your account.",
        OnboardingStepKeys.AddPayoutDetails => "So league admins can pay your winnings straight to your bank.",
        _ => string.Empty
    };

    private async Task SkipAsync(string stepKey)
    {
        await DashboardState.SkipOnboardingStepAsync(stepKey);
    }

    private async Task DismissAsync()
    {
        await DashboardState.DismissOnboardingAsync();
    }

    private async Task ShowJoinModalAsync()
    {
        _showJoinModal = true;
        await Task.Delay(50);
        await JsRuntime.InvokeVoidAsync("blazorInterop.showModal", "joinPrivateLeagueModal");
    }

    private async Task HideJoinModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("blazorInterop.hideModal", "joinPrivateLeagueModal");
        _showJoinModal = false;
        await DashboardState.LoadOnboardingAsync();
    }

    public void Dispose()
    {
        DashboardState.OnStateChange -= StateHasChanged;
    }
}
