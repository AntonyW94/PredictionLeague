@page "/admin/seasons/{SeasonId:int}/rounds"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

@using ThePredictions.Contracts.Admin.Rounds
@using ThePredictions.Domain.Common.Enumerations

<PageTitle>Manage Rounds</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Manage Rounds</h3>
            <button class="btn d-flex align-items-center green-button" @onclick="AddRound">
                <span class="bi bi-plus-circle-fill"></span>
                <span class="d-none d-md-inline ms-2">Add Round</span>
            </button>
        </div>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_rounds == null && string.IsNullOrEmpty(_errorMessage))
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_rounds?.Any() == false)
        {
            <div class="empty-state">
                <span class="bi bi-calendar3 empty-state-icon"></span>
                <p class="empty-state-title">No rounds yet</p>
                <p class="empty-state-text">Rounds for this season will appear here.</p>
            </div>
        }
        else if (_rounds != null)
        {
            <div class="member-list">
                @foreach (var round in _rounds)
                {
                    <div class="member-row">
                        <div class="member-info">
                            <span class="member-name">Round @round.RoundNumber</span>
                            <span class="member-date">
                                <LocalTime UtcDate="@round.StartDateUtc" Format="dd MMM yyyy" />
                                <span class="d-none d-md-inline"> — Deadline: <LocalTime UtcDate="@round.DeadlineUtc" Format="dd MMM, HH:mm" /></span>
                            </span>
                            <span class="season-status-pills">
                                <span class="season-status-pill @GetStatusClass(round.Status)">@round.Status.GetDescription()</span>
                                <span class="season-status-pill" style="background: var(--purple-100); color: var(--purple-300)">@round.MatchCount matches</span>
                            </span>
                        </div>
                        <div class="season-row-actions">
                            <button class="btn btn-sm green-button" @onclick="() => EditRound(round.Id)" title="Edit Round">
                                <span class="bi bi-pencil-fill"></span><span class="d-none d-lg-inline ms-1">Edit</span>
                            </button>
                            <button class="btn btn-sm blue-light-button" @onclick="() => EnterResults(round.Id)" title="Enter Results">
                                <span class="bi bi-clipboard2-check-fill"></span><span class="d-none d-lg-inline ms-1">Results</span>
                            </button>
                            @if (round.Status is RoundStatus.Published or RoundStatus.InProgress)
                            {
                                <button class="btn btn-sm blue-light-button" @onclick="() => ViewCompletion(round.Id)" title="See who is missing predictions">
                                    <span class="bi bi-list-check"></span><span class="d-none d-lg-inline ms-1">Completion</span>
                                </button>
                            }
                            @if (round.Status == RoundStatus.Completed)
                            {
                                <button class="btn btn-sm purple-button" @onclick="() => ResendDigest(round.Id, round.RoundNumber)" disabled="@_isResending" title="Re-send the results digest email">
                                    <span class="bi bi-envelope-arrow-up-fill"></span><span class="d-none d-lg-inline ms-1">Resend digest</span>
                                </button>
                                <button class="btn btn-sm purple-button" @onclick="() => ResendPrizeEmails(round.Id, round.RoundNumber)" disabled="@_isResending" title="Re-send the prize-won emails">
                                    <span class="bi bi-trophy-fill"></span><span class="d-none d-lg-inline ms-1">Resend prizes</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="mt-4">
            <button class="btn red-button d-flex align-items-center" @onclick="Back">
                <span class="bi bi-arrow-left-circle-fill me-2"></span>Back to Season
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int SeasonId { get; set; }
    private List<RoundDto>? _rounds;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isResending;

    protected override async Task OnInitializedAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            _rounds = await Http.GetFromJsonAsync<List<RoundDto>>($"api/admin/rounds/by-season/{SeasonId}");
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while loading the rounds for this season.";
        }
    }

    private static string GetStatusClass(RoundStatus status) => status switch
    {
        RoundStatus.Draft => "draft",
        RoundStatus.Published => "published",
        RoundStatus.InProgress => "in-progress",
        RoundStatus.Completed => "completed",
        _ => ""
    };

    private void AddRound() => NavigationManager.NavigateTo($"/admin/seasons/{SeasonId}/rounds/create");
    private void EditRound(int roundId) => NavigationManager.NavigateTo($"/admin/rounds/edit/{roundId}");
    private void Back() => NavigationManager.NavigateTo($"/admin/seasons/edit/{SeasonId}");
    private void EnterResults(int roundId) => NavigationManager.NavigateTo($"/admin/rounds/{roundId}/results");
    private void ViewCompletion(int roundId) => NavigationManager.NavigateTo($"/admin/rounds/{roundId}/completion");

    private async Task ResendDigest(int roundId, int roundNumber)
    {
        _errorMessage = null;
        _successMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Re-send the results digest email for Round {roundNumber} to everyone who predicted?");
        if (!confirmed)
            return;

        _isResending = true;

        try
        {
            var response = await Http.PostAsync($"api/admin/rounds/{roundId}/resend-digest", null);
            if (response.IsSuccessStatusCode)
                _successMessage = $"Results digest re-send triggered for Round {roundNumber}.";
            else
                _errorMessage = "Failed to re-send the results digest.";
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while re-sending the results digest.";
        }
        finally
        {
            _isResending = false;
        }
    }

    private async Task ResendPrizeEmails(int roundId, int roundNumber)
    {
        _errorMessage = null;
        _successMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Re-send the prize-won emails for Round {roundNumber} to every winner in this season?");
        if (!confirmed)
            return;

        _isResending = true;

        try
        {
            var response = await Http.PostAsync($"api/admin/rounds/{roundId}/resend-prize-emails", null);
            if (response.IsSuccessStatusCode)
                _successMessage = $"Prize-won email re-send triggered for Round {roundNumber}.";
            else
                _errorMessage = "Failed to re-send the prize-won emails.";
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while re-sending the prize-won emails.";
        }
        finally
        {
            _isResending = false;
        }
    }
}
