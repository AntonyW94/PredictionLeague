@page "/admin/rounds/{RoundId:int}/completion"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@inject HttpClient Http
@inject IJSRuntime JsRuntime

@using System.Net.Http.Json
@using ThePredictions.Contracts.Rounds

<PageTitle>Prediction Completion</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">Prediction Completion</h3>
                @if (_completion != null)
                {
                    <p class="text-muted mb-0">@_completion.RoundName @(_completion.DeadlinePassed ? "- deadline passed" : "")</p>
                }
            </div>
            @if (_completion != null && _incomplete.Any() && !_completion.DeadlinePassed)
            {
                <button class="btn green-button d-flex align-items-center" disabled="@_isSending" @onclick="RemindAllIncomplete">
                    @if (_isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <span class="bi bi-envelope-fill me-2"></span>
                    }
                    <span>Remind all incomplete</span>
                </button>
            }
        </div>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_isLoading)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_completion != null)
        {
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="showAll" checked="@_showAll" @onchange="ToggleShowAll" />
                <label class="form-check-label" for="showAll">Show players who have completed the round too</label>
            </div>

            @if (!_visiblePlayers.Any())
            {
                <div class="empty-state">
                    <span class="bi bi-check-circle empty-state-icon"></span>
                    <p class="empty-state-title">Everyone is up to date</p>
                    <p class="empty-state-text">All participants have completed their predictions for this round.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Status</th>
                                <th>Missing fixtures</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in _visiblePlayers)
                            {
                                var remindedRecently = player.LastRemindedUtc.HasValue
                                    && (DateTime.UtcNow - player.LastRemindedUtc.Value) < TimeSpan.FromHours(6);
                                <tr>
                                    <td>
                                        <div class="fw-bold">@player.PlayerName</div>
                                        <small class="text-muted">@player.Email</small>
                                    </td>
                                    <td class="text-nowrap">
                                        @if (player.MissingCount == 0)
                                        {
                                            <span class="badge bg-success">Complete (@player.PredictedCount/@_completion.PredictableMatchCount)</span>
                                        }
                                        else if (player.HasEnteredNothing)
                                        {
                                            <span class="badge bg-danger">None (0/@_completion.PredictableMatchCount)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Partial (@player.PredictedCount/@_completion.PredictableMatchCount)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (player.MissingFixtures.Any())
                                        {
                                            @string.Join(", ", player.MissingFixtures.Select(f => $"{f.HomeTeam} v {f.AwayTeam}"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (player.MissingCount == 0 || _completion.DeadlinePassed)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (remindedRecently)
                                        {
                                            <span class="text-muted small" title="Reminded at @player.LastRemindedUtc!.Value.ToLocalTime().ToString("dd MMM HH:mm")">Reminded</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm blue-light-button" disabled="@_isSending" @onclick="() => RemindPlayer(player)">
                                                <span class="bi bi-envelope-fill me-1"></span>Remind
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public int RoundId { get; set; }

    private RoundCompletionDto? _completion;
    private List<RoundCompletionPlayerDto> _incomplete = [];
    private List<RoundCompletionPlayerDto> _visiblePlayers = [];
    private bool _showAll;
    private bool _isLoading = true;
    private bool _isSending;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _completion = await Http.GetFromJsonAsync<RoundCompletionDto>(
                $"api/admin/rounds/{RoundId}/completion");

            _incomplete = _completion?.Players.Where(p => p.MissingCount > 0).ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception)
        {
            _errorMessage = "Could not load prediction completion for this round.";
        }
    }

    private void ApplyFilter()
    {
        _visiblePlayers = _showAll
            ? _completion?.Players.ToList() ?? []
            : _incomplete;
    }

    private void ToggleShowAll(ChangeEventArgs e)
    {
        _showAll = (bool)(e.Value ?? false);
        ApplyFilter();
    }

    private async Task RemindPlayer(RoundCompletionPlayerDto player)
    {
        await SendRemindersAsync([player.UserId]);
    }

    private async Task RemindAllIncomplete()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Send a prediction reminder to {_incomplete.Count} incomplete player(s)?");
        if (!confirmed)
            return;

        await SendRemindersAsync(_incomplete.Select(p => p.UserId).ToList());
    }

    private async Task SendRemindersAsync(List<string> userIds)
    {
        _isSending = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/admin/rounds/{RoundId}/reminders",
                new SendPredictionRemindersRequest(userIds));

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SendPredictionRemindersResultDto>();
                _successMessage = BuildResultMessage(result);
                await LoadAsync();
            }
            else
            {
                _errorMessage = "Could not send reminders. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Could not send reminders. Please try again.";
        }
        finally
        {
            _isSending = false;
        }
    }

    private static string BuildResultMessage(SendPredictionRemindersResultDto? result)
    {
        if (result == null)
            return "Reminders processed.";

        var message = $"Sent {result.SentCount} reminder(s).";
        if (result.SkippedRecentlyRemindedCount > 0)
            message += $" {result.SkippedRecentlyRemindedCount} skipped (reminded recently).";
        if (result.SkippedNoLongerMissingCount > 0)
            message += $" {result.SkippedNoLongerMissingCount} skipped (no longer missing).";

        return message;
    }
}
