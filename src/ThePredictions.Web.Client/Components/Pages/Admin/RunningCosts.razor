@page "/admin/running-costs"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@using System.Globalization
@using ThePredictions.Contracts.Admin.RunningCosts
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Services.RunningCosts
@inject IRunningCostService RunningCostService

<PageTitle>Running costs</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <h3 class="fw-bold mb-2">Running costs</h3>
        <p class="form-text text-white-50 mb-4">
            Record the website's running costs so the recommended-price calculator can base suggestions on real costs.
            Set an end date if a cost is one-off or stops on a known date.
        </p>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
        }
        else
        {
            <div class="form-container mb-4">
                <h5 class="fw-bold mb-3">@(_editingId is null ? "Add a cost" : "Edit cost")</h5>
                <EditForm Model="_model" OnValidSubmit="HandleSaveAsync">
                    <FluentValidationValidator />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="_model.Name" placeholder="e.g. Fasthosts hosting" />
                            <StyledValidationMessage For="@(() => _model.Name)" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="amount" class="form-label">Amount (£)</label>
                            <InputNumber id="amount" class="form-control" @bind-Value="_model.Amount" />
                            <StyledValidationMessage For="@(() => _model.Amount)" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="frequency" class="form-label">Frequency</label>
                            <InputSelect id="frequency" class="form-control" @bind-Value="_model.Frequency">
                                <option value="@CostFrequency.Monthly">Monthly</option>
                                <option value="@CostFrequency.Annual">Annual</option>
                                <option value="@CostFrequency.OneOff">One-off</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="startDate" class="form-label">Start date</label>
                            <InputDate id="startDate" class="form-control" @bind-Value="_model.StartDateUtc" />
                            <StyledValidationMessage For="@(() => _model.StartDateUtc)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="endDate" class="form-label">End date (optional)</label>
                            <InputDate id="endDate" class="form-control" @bind-Value="_model.EndDateUtc" />
                            <StyledValidationMessage For="@(() => _model.EndDateUtc)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes (optional)</label>
                        <InputText id="notes" class="form-control" @bind-Value="_model.Notes" />
                        <StyledValidationMessage For="@(() => _model.Notes)" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        @if (_editingId is not null)
                        {
                            <button type="button" class="btn red-button" @onclick="CancelEdit">Cancel</button>
                        }
                        <button type="submit" class="btn green-button" disabled="@_isBusy">
                            @(_isBusy ? "Saving..." : _editingId is null ? "Add cost" : "Save changes")
                        </button>
                    </div>
                </EditForm>
            </div>

            @if (_costs.Count == 0)
            {
                <p class="text-center text-white-50 py-3">No running costs recorded yet.</p>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Amount</th>
                            <th>Frequency</th>
                            <th>End date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cost in _costs)
                        {
                            <tr>
                                <td>@cost.Name @(string.IsNullOrWhiteSpace(cost.Notes) ? "" : $"({cost.Notes})")</td>
                                <td>@cost.Amount.ToString("C", Uk)</td>
                                <td>@FormatFrequency(cost.Frequency)</td>
                                <td>@(cost.EndDateUtc is { } end ? end.ToString("d MMM yyyy") : "Ongoing")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm green-button me-1" @onclick="() => StartEdit(cost)">Edit</button>
                                    <button class="btn btn-sm red-button" @onclick="() => DeleteAsync(cost.Id)" disabled="@_isBusy">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Uk = new("en-GB");
    private List<RunningCostDto> _costs = [];
    private SaveRunningCostRequest _model = NewModel();
    private int? _editingId;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private static SaveRunningCostRequest NewModel() => new()
    {
        Frequency = CostFrequency.Annual,
        StartDateUtc = DateTime.UtcNow.Date
    };

    private async Task LoadAsync()
    {
        _isLoading = true;
        _costs = await RunningCostService.GetAllAsync();
        _isLoading = false;
    }

    private async Task HandleSaveAsync()
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        var (success, error) = _editingId is null
            ? await RunningCostService.CreateAsync(_model)
            : await RunningCostService.UpdateAsync(_editingId.Value, _model);

        if (success)
        {
            _successMessage = _editingId is null ? "Cost added." : "Cost updated.";
            CancelEdit();
            await LoadAsync();
        }
        else
        {
            _errorMessage = error;
        }

        _isBusy = false;
    }

    private void StartEdit(RunningCostDto cost)
    {
        _editingId = cost.Id;
        _model = new SaveRunningCostRequest
        {
            Name = cost.Name,
            Amount = cost.Amount,
            Frequency = Enum.Parse<CostFrequency>(cost.Frequency),
            StartDateUtc = cost.StartDateUtc,
            EndDateUtc = cost.EndDateUtc,
            Notes = cost.Notes
        };
        _successMessage = null;
        _errorMessage = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _model = NewModel();
    }

    private async Task DeleteAsync(int id)
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        if (await RunningCostService.DeleteAsync(id))
        {
            if (_editingId == id)
                CancelEdit();

            await LoadAsync();
        }
        else
        {
            _errorMessage = "Could not delete that cost. Please try again.";
        }

        _isBusy = false;
    }

    private static string FormatFrequency(string frequency) => frequency switch
    {
        nameof(CostFrequency.OneOff) => "One-off",
        _ => frequency
    };
}
