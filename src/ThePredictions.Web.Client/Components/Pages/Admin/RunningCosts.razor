@page "/admin/running-costs"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@using System.Globalization
@using ThePredictions.Contracts.Admin.RunningCosts
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.Services.RunningCosts
@inject IRunningCostService RunningCostService
@inject IJSRuntime JsRuntime

<PageTitle>Running costs</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <PageHero Title="Running costs" Icon="bi-receipt">
            Record the website's running costs so the recommended-price calculator can base suggestions on real costs.
            Set an end date if a cost is one-off or stops on a known date.
        </PageHero>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
        }
        else
        {
            <div class="d-flex justify-content-end mb-3">
                <button class="btn d-flex align-items-center green-button" @onclick="ShowAddModalAsync">
                    <span class="bi bi-plus-circle-fill"></span>
                    <span class="d-none d-md-inline ms-2">Add cost</span>
                </button>
            </div>

            @if (_costs.Count == 0)
            {
                <div class="empty-state">
                    <span class="bi bi-receipt empty-state-icon"></span>
                    <p class="empty-state-title">No running costs yet</p>
                    <p class="empty-state-text">Add a cost so the recommended-price calculator can base suggestions on real figures.</p>
                </div>
            }
            else
            {
                <div class="member-list">
                @foreach (var cost in _costs)
                {
                    <div class="member-row">
                        <div class="member-info">
                            <span class="member-name text-truncate">@cost.Name</span>
                            @if (!string.IsNullOrWhiteSpace(cost.Notes))
                            {
                                <span class="member-date">@cost.Notes</span>
                            }
                        </div>
                        <div class="d-flex flex-column align-items-end text-end flex-shrink-0">
                            <span class="member-name">@cost.Amount.ToString("C", Uk)</span>
                            <span class="member-date">@FormatFrequency(cost.Frequency) · @(cost.EndDateUtc is { } end ? end.ToString("d MMM yyyy") : "Ongoing")</span>
                        </div>
                        <div class="member-actions">
                            <button class="btn btn-sm green-button" @onclick="() => ShowEditModalAsync(cost)" title="Edit">
                                <span class="bi bi-pencil-fill"></span>
                                <span class="d-none d-md-inline ms-1">Edit</span>
                            </button>
                            <button class="btn btn-sm red-button" @onclick="() => DeleteAsync(cost)" disabled="@_isBusy" title="Delete">
                                <span class="bi bi-trash-fill"></span>
                                <span class="d-none d-md-inline ms-1">Delete</span>
                            </button>
                        </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="runningCostModal" tabindex="-1" aria-labelledby="runningCostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="runningCostModalLabel">@(_editingId is null ? "Add a cost" : "Edit cost")</h5>
                <button type="button" class="btn-close" @onclick="CloseModalAsync" aria-label="Close"></button>
            </div>
            <EditForm Model="_model" OnValidSubmit="HandleSaveAsync">
                <FluentValidationValidator />

                <div class="modal-body">
                    <ApiError Message="@_modalError" />

                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <InputText id="name" class="form-control" @bind-Value="_model.Name" placeholder="e.g. Fasthosts hosting" />
                        <StyledValidationMessage For="@(() => _model.Name)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="amount" class="form-label">Amount (£)</label>
                            <InputNumber id="amount" class="form-control" @bind-Value="_model.Amount" />
                            <StyledValidationMessage For="@(() => _model.Amount)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="frequency" class="form-label">Frequency</label>
                            <InputSelect id="frequency" class="form-control" @bind-Value="_model.Frequency">
                                <option value="@CostFrequency.Monthly">Monthly</option>
                                <option value="@CostFrequency.Annual">Annual</option>
                                <option value="@CostFrequency.OneOff">One-off</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="startDate" class="form-label">Start date</label>
                            <InputDate id="startDate" class="form-control" @bind-Value="_model.StartDateUtc" />
                            <StyledValidationMessage For="@(() => _model.StartDateUtc)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="endDate" class="form-label">End date (optional)</label>
                            <InputDate id="endDate" class="form-control" @bind-Value="_model.EndDateUtc" />
                            <StyledValidationMessage For="@(() => _model.EndDateUtc)" />
                        </div>
                    </div>

                    <div class="mb-1">
                        <label for="notes" class="form-label">Notes (optional)</label>
                        <InputText id="notes" class="form-control" @bind-Value="_model.Notes" />
                        <StyledValidationMessage For="@(() => _model.Notes)" />
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn red-button" @onclick="CloseModalAsync">
                        <span class="bi bi-x-circle me-2"></span>Cancel
                    </button>
                    <button type="submit" class="btn green-button" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span class="bi bi-check-circle me-2"></span>
                            <span>@(_editingId is null ? "Add cost" : "Save changes")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private const string ModalId = "runningCostModal";
    private static readonly CultureInfo Uk = new("en-GB");
    private List<RunningCostDto> _costs = [];
    private SaveRunningCostRequest _model = NewModel();
    private int? _editingId;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _modalError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private static SaveRunningCostRequest NewModel() => new()
    {
        Frequency = CostFrequency.Annual,
        StartDateUtc = DateTime.UtcNow.Date
    };

    private async Task LoadAsync()
    {
        _isLoading = true;
        _costs = await RunningCostService.GetAllAsync();
        _isLoading = false;
    }

    private async Task ShowAddModalAsync()
    {
        _editingId = null;
        _model = NewModel();
        _modalError = null;
        await JsRuntime.InvokeVoidAsync("blazorInterop.showModal", ModalId);
    }

    private async Task ShowEditModalAsync(RunningCostDto cost)
    {
        _editingId = cost.Id;
        _model = new SaveRunningCostRequest
        {
            Name = cost.Name,
            Amount = cost.Amount,
            Frequency = Enum.Parse<CostFrequency>(cost.Frequency),
            StartDateUtc = cost.StartDateUtc,
            EndDateUtc = cost.EndDateUtc,
            Notes = cost.Notes
        };
        _modalError = null;
        await JsRuntime.InvokeVoidAsync("blazorInterop.showModal", ModalId);
    }

    private async Task CloseModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("blazorInterop.hideModal", ModalId);
        _editingId = null;
        _model = NewModel();
        _modalError = null;
    }

    private async Task HandleSaveAsync()
    {
        _isBusy = true;
        _modalError = null;

        var (success, error) = _editingId is null
            ? await RunningCostService.CreateAsync(_model)
            : await RunningCostService.UpdateAsync(_editingId.Value, _model);

        if (success)
        {
            _successMessage = _editingId is null ? "Cost added." : "Cost updated.";
            _errorMessage = null;
            await CloseModalAsync();
            await LoadAsync();
        }
        else
        {
            _modalError = error;
        }

        _isBusy = false;
    }

    private async Task DeleteAsync(RunningCostDto cost)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "blazorInterop.showConfirm",
            $"Delete '{cost.Name}'?",
            "This cannot be undone.",
            "Delete",
            "Cancel");

        if (!confirmed)
            return;

        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        if (await RunningCostService.DeleteAsync(cost.Id))
        {
            _successMessage = "Cost deleted.";
            await LoadAsync();
        }
        else
        {
            _errorMessage = "Could not delete that cost. Please try again.";
        }

        _isBusy = false;
    }

    private static string FormatFrequency(string frequency) => frequency switch
    {
        nameof(CostFrequency.OneOff) => "One-off",
        _ => frequency
    };
}
