@page "/admin/users"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JsRuntime

@using ThePredictions.Contracts.Admin.Users
@using ThePredictions.Contracts.Onboarding
@using ThePredictions.Domain.Common.Enumerations
@using ThePredictions.Web.Client.ViewModels.Admin.Users
@using System.Security.Claims
@using System.Text.Json.Nodes

<PageTitle>User Management</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Users</h3>
        </div>

        <ApiError Message="@_errorMessage" />

        @if (_users == null)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            var adminCount = _users.Count(user => user.IsAdmin);
            var playerCount = _users.Count - adminCount;

            <div class="admin-tabs-mobile">
                <select @onchange="OnMobileTabChanged" value="@_criteria.Tab.ToString()">
                    <option value="All">All (@_users.Count)</option>
                    <option value="Admin">Admin (@adminCount)</option>
                    <option value="Player">Player (@playerCount)</option>
                </select>
            </div>

            <div class="admin-tabs">
                <button class="admin-tab @(_criteria.Tab == UserListTab.All ? "active" : "")" @onclick="() => SetTab(UserListTab.All)">
                    All
                    <span class="match-count-badge">@_users.Count</span>
                </button>
                <button class="admin-tab @(_criteria.Tab == UserListTab.Admin ? "active" : "")" @onclick="() => SetTab(UserListTab.Admin)">
                    Admin
                    @if (adminCount > 0)
                    {
                        <span class="match-count-badge" style="background: var(--red)">@adminCount</span>
                    }
                </button>
                <button class="admin-tab @(_criteria.Tab == UserListTab.Player ? "active" : "")" @onclick="() => SetTab(UserListTab.Player)">
                    Player
                    @if (playerCount > 0)
                    {
                        <span class="match-count-badge" style="background: var(--blue-700)">@playerCount</span>
                    }
                </button>
            </div>

            var displayedUsers = _criteria.Apply(_users);

            <div class="user-toolbar">
                <button type="button" class="user-toolbar-toggle" @onclick="ToggleFilters">
                    <span class="bi bi-sliders2"></span>
                    <span>Sort &amp; filter</span>
                    @if (_criteria.HasNonDefaultControls)
                    {
                        <span class="user-toolbar-dot" title="Filters active"></span>
                    }
                    <span class="bi @(_filtersExpanded ? "bi-chevron-up" : "bi-chevron-down") user-toolbar-caret"></span>
                </button>

                @if (_filtersExpanded)
                {
                    <div class="user-filter-panel">
                        <div class="user-filter-search">
                            <span class="bi bi-search"></span>
                            <input type="text" class="form-control" placeholder="Search name or email…" value="@_criteria.SearchTerm" @oninput="OnSearchChanged" />
                        </div>
                        <div class="user-filter-row">
                            <label class="user-filter-label" for="user-sort">Sort by</label>
                            <select id="user-sort" class="form-select" value="@_criteria.SortField.ToString()" @onchange="OnSortFieldChanged">
                                <option value="@nameof(UserListSortField.Name)">Name</option>
                                <option value="@nameof(UserListSortField.LeaguesCreated)">Leagues created</option>
                                <option value="@nameof(UserListSortField.LeaguesJoined)">Leagues joined</option>
                                <option value="@nameof(UserListSortField.Badges)">Badges earned</option>
                                <option value="@nameof(UserListSortField.Setup)">Setup progress</option>
                                <option value="@nameof(UserListSortField.PassSpend)">Pass spend</option>
                                <option value="@nameof(UserListSortField.EntrySpend)">Entry spend</option>
                                <option value="@nameof(UserListSortField.TotalSpend)">Total spend</option>
                                <option value="@nameof(UserListSortField.Winnings)">Winnings</option>
                            </select>
                            <button type="button" class="user-sort-dir" @onclick="ToggleSortDirection" title="@(_criteria.SortDescending ? "Descending" : "Ascending")">
                                <span class="bi @(_criteria.SortDescending ? "bi-sort-down" : "bi-sort-up")"></span>
                                <span>@(_criteria.SortDescending ? "Desc" : "Asc")</span>
                            </button>
                        </div>
                        <div class="user-filter-row user-filter-row-between">
                            <div class="user-filter-chips">
                                <button type="button" class="user-toggle-chip @(_criteria.NoCurrentPassOnly ? "active" : "")" @onclick="ToggleNoCurrentPassOnly" data-test-id="admin-user-filter-no-pass">
                                    <span class="bi bi-slash-circle"></span> No current pass
                                </button>
                                <button type="button" class="user-toggle-chip @(_criteria.SetupIncompleteOnly ? "active" : "")" @onclick="ToggleSetupIncompleteOnly">
                                    <span class="bi bi-hourglass"></span> Setup incomplete
                                </button>
                                <button type="button" class="user-toggle-chip @(_criteria.UnpaidWinnersOnly ? "active" : "")" @onclick="ToggleUnpaidWinnersOnly" data-test-id="admin-user-filter-unpaid">
                                    <span class="bi bi-exclamation-triangle-fill"></span> Owed money, no details
                                </button>
                                <button type="button" class="user-toggle-chip @(_criteria.DormantOnly ? "active" : "")" @onclick="ToggleDormantOnly">
                                    <span class="bi bi-moon-stars-fill"></span> Dormant
                                </button>
                            </div>
                            @if (_criteria.HasNonDefaultControls)
                            {
                                <button type="button" class="user-filter-clear" @onclick="ClearFilters">Clear</button>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (_criteria.HasActiveFilters)
            {
                <div class="user-results-count">Showing @displayedUsers.Count of @_criteria.InTab(_users).Count()</div>
            }

            @if (displayedUsers.Count == 0)
            {
                <div class="member-empty">No users match the current filters.</div>
            }
            else
            {
                <div class="member-list user-card-list">
                    @foreach (var user in displayedUsers)
                    {
                        var isLoggedInUser = _currentUserId == user.Id;

                        <div class="member-row user-row" data-test-id="admin-user-row">
                            <UserAvatar FullName="@user.FullName" />
                            <div class="member-info">
                                <div class="user-card-head">
                                    <div class="user-identity">
                                        <div class="user-name-line">
                                            <span class="member-name">@user.FullName</span>
                                            <span class="user-role @(user.IsAdmin ? "user-role-admin" : "")">@(user.IsAdmin ? "Admin" : "Player")</span>
                                        </div>
                                        <div class="user-email-line">
                                            <span class="user-email">@user.Email</span>
                                        </div>
                                    </div>

                                    <div class="user-menu-wrap">
                                        <button class="user-kebab" @onclick="() => ToggleMenu(user.Id)" disabled="@isLoggedInUser" title="Actions" data-test-id="admin-user-menu">
                                            <span class="bi bi-three-dots-vertical"></span>
                                        </button>
                                        @if (_openMenuUserId == user.Id)
                                        {
                                            <div class="user-menu-backdrop" @onclick="CloseMenu"></div>
                                            <div class="user-menu">
                                                <button class="user-menu-item" @onclick="() => ChangeRole(user)">
                                                    <span class="bi bi-person-badge-fill"></span> Change role
                                                </button>
                                                <button class="user-menu-item user-menu-item-danger" @onclick="() => PrepareToDeleteUser(user)" data-test-id="admin-user-delete">
                                                    <span class="bi bi-trash-fill"></span> Delete user
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @*
                                    The two pass questions, then anything actually wrong. A dash for something merely
                                    absent lives in the setup band below; red here is reserved for a problem.
                                *@
                                <div class="user-status-line">
                                    @if (user.HasCurrentSeasonPass)
                                    {
                                        <span class="status-pill pill-pass-on" data-test-id="admin-user-current-pass">
                                            <span class="bi bi-check-circle-fill"></span> @CurrentPassWording(user)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill pill-pass-off" data-test-id="admin-user-no-current-pass">
                                            <span class="bi bi-slash-circle"></span> No current pass
                                        </span>
                                    }

                                    @if (user.HasEverPurchasedSeasonPass)
                                    {
                                        <span class="status-pill pill-paid">
                                            <span class="bi bi-cash-stack"></span> Paid before
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill pill-unpaid">Never paid</span>
                                    }

                                    @if (user.IsDormant)
                                    {
                                        <span class="status-pill pill-warn">
                                            <span class="bi bi-moon-stars-fill"></span> Dormant
                                        </span>
                                    }

                                    @if (!user.EmailConfirmed)
                                    {
                                        <span class="status-pill pill-warn" title="Email address not confirmed">
                                            <span class="bi bi-patch-exclamation-fill"></span> Email not confirmed
                                        </span>
                                    }

                                    @if (user.IsOwedMoneyWithNowhereToSendIt)
                                    {
                                        <span class="status-pill pill-danger" title="Has won money but has saved no payout details">
                                            <span class="bi bi-exclamation-triangle-fill"></span> Cannot be paid
                                        </span>
                                    }
                                </div>

                                <div class="user-panels">
                                    @Panel(user, UserDetailSection.Memberships, user.LeaguesJoinedApproved, "Leagues joined", user.LeaguesJoinedPending)
                                    @Panel(user, UserDetailSection.AdministeredLeagues, user.LeaguesCreated, "Leagues created")
                                    @Panel(user, UserDetailSection.SeasonPasses, user.SeasonPasses.Count, "Season passes", currentCount: user.CurrentPassSeasonNames.Count)
                                    @Panel(user, UserDetailSection.Badges, user.BadgeCount, "Badges earned")
                                </div>

                                <div class="user-setup-band">
                                    <button class="setup-progress" type="button" @onclick="() => OpenDetail(user, UserDetailSection.Onboarding)" data-test-id="admin-user-setup">
                                        <span class="setup-label">Setup</span>
                                        <span class="setup-segments">
                                            @foreach (var step in user.Onboarding.Steps)
                                            {
                                                <span class="setup-seg @SegmentClass(step.State)" title="@step.Title (@step.State)"></span>
                                            }
                                        </span>
                                        <span class="setup-progress-count @(user.OnboardingStepsCompleted == 0 ? "setup-progress-count-none" : "")">
                                            @user.OnboardingStepsCompleted of @user.OnboardingStepCount
                                        </span>
                                    </button>
                                    <span class="setup-divider"></span>
                                    <span class="flag-group">
                                        <span class="setup-label">Sign in</span>
                                        @Flag(user.HasLocalPassword, "Password")
                                        @Flag(user.SocialProviders.Contains("Google"), "Google")
                                    </span>
                                    <span class="setup-divider"></span>
                                    <span class="flag-group">
                                        @Flag(user.TermsAccepted, "Terms", redWhenAbsent: true)
                                        @Flag(user.MarketingOptIn, "Marketing")
                                    </span>
                                </div>

                                @if (user.TotalSpend > 0 || user.TotalWinnings > 0)
                                {
                                    <div class="user-money-strip">
                                        @MoneyCell(user, UserDetailSection.SeasonPasses, "Passes", user.SeasonPassSpend)
                                        <span class="money-op">+</span>
                                        @MoneyCell(user, UserDetailSection.Memberships, "Entries", user.LeagueEntrySpend)
                                        <span class="money-op">=</span>
                                        <span class="money-cell money-cell-static">
                                            <span class="money-label">Spent</span>
                                            <span class="money-value">@FormatMoney(user.TotalSpend)</span>
                                        </span>
                                        <span class="money-spacer"></span>
                                        @MoneyCell(user, UserDetailSection.Prizes, "Won", user.TotalWinnings, won: true)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (_detailUser is not null)
{
    <UserDetailModal User="_detailUser" Section="_detailSection" OnClose="CloseDetailAsync" />
}

@code {
    private List<UserDto>? _users;
    private string? _errorMessage;
    private string? _currentUserId;
    private UserListCriteria _criteria = UserListCriteria.Default;
    private bool _filtersExpanded;
    private string? _openMenuUserId;

    private UserDto? _detailUser;
    private UserDetailSection _detailSection;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadUsers();
    }

    /// <summary>
    /// One clickable count. Flat and inert at zero, because there is nothing behind it to open.
    /// </summary>
    /// <remarks>
    /// <paramref name="pendingCount"/> and <paramref name="currentCount"/> are the two chips a count can carry - requests
    /// awaiting approval, and passes for a season still running. Both are omitted at zero rather than shown as "+0".
    /// </remarks>
    private RenderFragment Panel(UserDto user, UserDetailSection section, int count, string label, int pendingCount = 0, int currentCount = 0)
    {
        if (count == 0)
        {
            return @<span class="user-panel panel-empty">
                <span class="panel-primary panel-primary-zero">0</span>
                <span class="panel-label">@label</span>
            </span>;
        }

        return @<button class="user-panel" type="button" @onclick="() => OpenDetail(user, section)">
            <span class="panel-primary">
                @count
                @if (pendingCount > 0)
                {
                    <span class="panel-chip chip-pending" title="@pendingCount awaiting approval">+@pendingCount</span>
                }
                @if (currentCount > 0)
                {
                    <span class="panel-chip chip-current">@currentCount current</span>
                }
            </span>
            <span class="panel-label">@label</span>
        </button>;
    }

    /// <summary>
    /// One money figure. Clickable when there is something behind it.
    /// </summary>
    private RenderFragment MoneyCell(UserDto user, UserDetailSection section, string label, decimal amount, bool won = false)
    {
        if (amount <= 0)
        {
            return @<span class="money-cell money-cell-static">
                <span class="money-label">@label</span>
                <span class="money-value money-value-zero">@FormatMoney(amount)</span>
            </span>;
        }

        return @<button class="money-cell" type="button" @onclick="() => OpenDetail(user, section)">
            <span class="money-label">@label</span>
            <span class="money-value @(won ? "money-value-won" : "")">@FormatMoney(amount)</span>
        </button>;
    }

    /// <summary>
    /// A tick for present, a dash for absent.
    /// </summary>
    /// <remarks>
    /// A red cross would say something is wrong, and for most of these nothing is: signing in with Google rather than a
    /// password is a choice, and not opting in to marketing is the lawful default. Red is passed in only for the terms
    /// record, where an account with no stored proof of consent is a real problem.
    /// </remarks>
    private static RenderFragment Flag(bool present, string label, bool redWhenAbsent = false) =>
        @<span class="flag @(present ? "flag-on" : redWhenAbsent ? "flag-bad" : "flag-off")">
            <span class="bi @(present ? "bi-check-lg" : redWhenAbsent ? "bi-x-lg" : "bi-dash")"></span> @label
        </span>;

    /// <summary>
    /// Which season the pass is for, or how many when more than one season is running at once - which happens whenever a
    /// tournament overlaps a league season.
    /// </summary>
    private static string CurrentPassWording(UserDto user) => user.CurrentPassSeasonNames.Count switch
    {
        0 => "Current pass",
        1 => $"Pass · {user.CurrentPassSeasonNames[0]}",
        var count => $"{count} current passes"
    };

    private static string SegmentClass(string state) => state switch
    {
        OnboardingStepStates.Completed => "seg-done",
        OnboardingStepStates.Active => "seg-active",
        OnboardingStepStates.Locked => "seg-locked",
        _ => "seg-skipped"
    };

    private async Task OpenDetail(UserDto user, UserDetailSection section)
    {
        _detailUser = user;
        _detailSection = section;
        _openMenuUserId = null;

        // The markup has to exist before Bootstrap is asked to show it, and the render that creates it has not happened
        // yet at this point. Same wait as the league join and add-member modals.
        await Task.Yield();

        await JsRuntime.InvokeVoidAsync("blazorInterop.showModal", UserDetailModal.ModalId);
    }

    private async Task CloseDetailAsync()
    {
        await JsRuntime.InvokeVoidAsync("blazorInterop.hideModal", UserDetailModal.ModalId);
        _detailUser = null;
    }

    private void SetTab(UserListTab tab)
    {
        _criteria = _criteria with { Tab = tab };
    }

    private void OnMobileTabChanged(ChangeEventArgs e)
    {
        SetTab(Enum.TryParse<UserListTab>(e.Value?.ToString(), out var tab) ? tab : UserListTab.All);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _criteria = _criteria with { SearchTerm = e.Value?.ToString() };
    }

    private void OnSortFieldChanged(ChangeEventArgs e)
    {
        var field = Enum.TryParse<UserListSortField>(e.Value?.ToString(), out var parsed) ? parsed : UserListSortField.Name;

        _criteria = _criteria with { SortField = field };
    }

    private void ToggleFilters()
    {
        _filtersExpanded = !_filtersExpanded;
    }

    private void ToggleDormantOnly()
    {
        _criteria = _criteria with { DormantOnly = !_criteria.DormantOnly };
    }

    private void ToggleNoCurrentPassOnly()
    {
        _criteria = _criteria with { NoCurrentPassOnly = !_criteria.NoCurrentPassOnly };
    }

    private void ToggleSetupIncompleteOnly()
    {
        _criteria = _criteria with { SetupIncompleteOnly = !_criteria.SetupIncompleteOnly };
    }

    private void ToggleUnpaidWinnersOnly()
    {
        _criteria = _criteria with { UnpaidWinnersOnly = !_criteria.UnpaidWinnersOnly };
    }

    private void ToggleSortDirection()
    {
        _criteria = _criteria with { SortDescending = !_criteria.SortDescending };
    }

    private void ClearFilters()
    {
        _criteria = _criteria.Cleared();
    }

    private void ToggleMenu(string userId)
    {
        _openMenuUserId = _openMenuUserId == userId ? null : userId;
    }

    private void CloseMenu()
    {
        _openMenuUserId = null;
    }

    private static string FormatMoney(decimal amount) => amount % 1 == 0
        ? $"£{amount:N0}"
        : $"£{amount:N2}";

    private async Task LoadUsers()
    {
        _errorMessage = null;
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserDto>>("api/admin/users");
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while loading the user list. Please try again later.";
        }
    }

    private async Task ChangeRole(UserDto user)
    {
        _openMenuUserId = null;
        _errorMessage = null;

        var currentRole = user.IsAdmin ? nameof(ApplicationUserRole.Administrator) : nameof(ApplicationUserRole.Player);
        var newRole = await JsRuntime.InvokeAsync<string?>("blazorInterop.showRoleChangeConfirm", new object[] { user.FullName, currentRole });

        if (!string.IsNullOrEmpty(newRole) && newRole != currentRole)
        {
            try
            {
                var response = await Http.PostAsJsonAsync($"api/admin/users/{user.Id}/role", new { NewRole = newRole });
                if (response.IsSuccessStatusCode)
                {
                    await LoadUsers();
                }
                else
                {
                    _errorMessage = "An error occurred while changing the user's role.";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"An unexpected error occurred: {ex.Message}";
            }

            StateHasChanged();
        }
    }

    private async Task PrepareToDeleteUser(UserDto user)
    {
        _openMenuUserId = null;
        _errorMessage = null;

        try
        {
            // One call rather than two. It answers both questions the dialog needs - what the delete
            // destroys, and whether any leagues have to change hands first - and the dialog cannot be
            // drawn until both are known anyway.
            var impact = await Http.GetFromJsonAsync<UserDeletionImpactDto>($"api/admin/users/{user.Id}/deletion-impact");

            if (impact == null)
            {
                _errorMessage = "Could not work out what deleting this account would remove. Please try again.";
                StateHasChanged();
                return;
            }

            var title = $"Delete '{user.FullName}'?";
            var impactLines = UserDeletionImpactSummary.Describe(impact).ToArray();

            if (impact.LeaguesAdministered > 0)
            {
                var newAdminId = await JsRuntime.InvokeAsync<string?>("blazorInterop.showReassignLeagueConfirm", new object[] { title, _users!, user.Id, impactLines });

                if (!string.IsNullOrEmpty(newAdminId))
                {
                    await ExecuteDelete(user.Id, newAdminId);
                }
            }
            else
            {
                var confirmed = await JsRuntime.InvokeAsync<bool>("blazorInterop.showDeleteUserConfirm", new object[] { title, impactLines });

                if (confirmed)
                {
                    await ExecuteDelete(user.Id, null);
                }
            }
        }
        catch
        {
            _errorMessage = "Could not work out what deleting this account would remove. Please try again.";
            StateHasChanged();
        }
    }

    private async Task ExecuteDelete(string userId, string? newAdministratorId)
    {
        try
        {
            var request = new DeleteUserRequest { NewAdministratorId = newAdministratorId };
            var response = await Http.PostAsJsonAsync($"api/admin/users/{userId}/delete", request);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                var errorNode = await response.Content.ReadFromJsonAsync<JsonNode>();
                _errorMessage = errorNode?["message"]?.ToString() ?? "An error occurred while deleting the user.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
        }

        StateHasChanged();
    }
}
