@page "/admin/competitions"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@inject HttpClient Http
@inject NavigationManager NavigationManager

@using ThePredictions.Contracts.Admin.Competitions
@using ThePredictions.Domain.Common.Enumerations

<PageTitle>Manage Competitions</PageTitle>

<div class="page-container admin-light">
    <div class="admin-table-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Manage Competitions</h3>
            <button class="btn d-flex align-items-center green-button" @onclick='() => NavigationManager.NavigateTo("/admin/competitions/create")'>
                <span class="bi bi-plus-circle-fill"></span>
                <span class="d-none d-md-inline ms-2">Create Competition</span>
            </button>
        </div>

        @if (_competitions == null)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!_competitions.Any())
        {
            <div class="empty-state">
                <span class="bi bi-trophy empty-state-icon"></span>
                <p class="empty-state-title">No competitions yet</p>
                <p class="empty-state-text">Create a competition before adding its seasons.</p>
            </div>
        }
        else
        {
            <div class="team-list-grid">
                @foreach (var competition in _competitions)
                {
                    <div class="member-row team-list-row" @onclick="() => EditCompetition(competition.Id)">
                        @if (!string.IsNullOrWhiteSpace(competition.LogoUrl))
                        {
                            <img src="@competition.LogoUrl" alt="@competition.Name" class="team-list-logo" />
                        }
                        else
                        {
                            <span class="bi @(competition.Type == (int)CompetitionType.Tournament ? "bi-trophy" : "bi-table") team-list-logo d-flex align-items-center justify-content-center"></span>
                        }
                        <div class="member-info">
                            <span class="member-name">@competition.Name</span>
                            <span class="member-date">@competition.Code · @(competition.Type == (int)CompetitionType.Tournament ? "Tournament" : "League") · @competition.SeasonCount season@(competition.SeasonCount == 1 ? "" : "s")</span>
                        </div>
                        <span class="bi bi-chevron-right team-list-chevron"></span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<CompetitionDto>? _competitions;

    protected override async Task OnInitializedAsync()
    {
        _competitions = await Http.GetFromJsonAsync<List<CompetitionDto>>("api/admin/competitions");
    }

    private void EditCompetition(int competitionId)
    {
        NavigationManager.NavigateTo($"/admin/competitions/edit/{competitionId}");
    }
}
