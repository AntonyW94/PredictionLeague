@page "/admin/pricing-settings"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@using System.Globalization
@using ThePredictions.Contracts.Admin.PricingSettings
@using ThePredictions.Contracts.Admin.ServiceFees
@using ThePredictions.Web.Client.Services.PricingSettings
@inject IPricingSettingsService PricingSettingsService
@inject IServiceFeeService ServiceFeeService

<PageTitle>Pricing settings</PageTitle>

<div class="page-container admin-light">
    <EditForm Model="_formModel" OnValidSubmit="SaveAsync" class="base-form">
        <PageHero Title="Pricing settings" Icon="bi-sliders">
            These feed the recommended-price calculator on the season screens. They're only a starting suggestion -
            you can always override the price on each season. Rounding is fixed at the nearest 50p.
        </PageHero>

        <ApiError Message="@_errorMessage" />
        <ApiSuccess Message="@_successMessage" />

        @if (_isLoading)
        {
            <div class="form-container">
                <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
            </div>
        }
        else
        {
            <div class="form-container mb-4">
                <h5 class="fw-bold mb-3">Calculator</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="buffer" class="form-label">Buffer (%)</label>
                        <InputNumber id="buffer" class="form-control" @bind-Value="_bufferPercent" />
                        <div class="form-text text-white-50">Added on top of costs (e.g. 15 = aim to cover costs +15%).</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="floor" class="form-label">Minimum price floor (£)</label>
                        <InputNumber id="floor" class="form-control" @bind-Value="_minimumFloor" />
                        <div class="form-text text-white-50">The lowest price the calculator will ever suggest.</div>
                    </div>
                </div>
            </div>

            <div class="form-container mb-4">
                <h5 class="fw-bold mb-1">Provider fees</h5>
                <p class="form-text text-white-50 mb-3">
                    What each provider charges us per transaction. The percentage applies to card payments (Stripe);
                    flat-rate providers (SMS, email) just use the fixed fee.
                </p>

                @if (_fees.Count == 0)
                {
                    <p class="form-text text-white-50 mb-0">No provider fees recorded yet.</p>
                }
                else
                {
                    @foreach (var fee in _fees)
                    {
                        <div class="row align-items-center">
                            <div class="col-12 col-md-4 mb-2 mb-md-3">
                                <span class="form-label mb-0">@FriendlyProvider(fee.Provider)</span>
                            </div>
                            <div class="col-6 col-md-4 mb-3">
                                <label class="form-label">Percentage fee (%)</label>
                                <InputNumber class="form-control" @bind-Value="fee.PercentInput" />
                            </div>
                            <div class="col-6 col-md-4 mb-3">
                                <label class="form-label">Fixed fee (£)</label>
                                <InputNumber class="form-control" @bind-Value="fee.FixedFee" />
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn green-button d-flex align-items-center" disabled="@_isBusy">
                    @if (_isBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span class="bi bi-check-circle me-2"></span>
                        <span>Save settings</span>
                    }
                </button>
            </div>
        }
    </EditForm>
</div>

@code {
    private readonly object _formModel = new();
    private decimal _bufferPercent;
    private decimal _minimumFloor;
    private List<FeeRow> _fees = [];

    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        var settings = await PricingSettingsService.GetAsync();
        if (settings is not null)
        {
            _bufferPercent = TrimZeros(settings.BufferRate * 100);
            _minimumFloor = TrimZeros(settings.MinimumFloor);
        }

        var fees = await ServiceFeeService.GetAllAsync();
        _fees = fees.Select(f => new FeeRow
        {
            Provider = f.Provider,
            PercentInput = TrimZeros(f.PercentFee * 100),
            FixedFee = TrimZeros(f.FixedFee)
        }).ToList();

        _isLoading = false;
    }

    private async Task SaveAsync()
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        var settingsRequest = new UpdatePricingSettingsRequest
        {
            BufferRate = _bufferPercent / 100,
            MinimumFloor = _minimumFloor
        };

        var (settingsOk, settingsError) = await PricingSettingsService.UpdateAsync(settingsRequest);
        if (!settingsOk)
        {
            _errorMessage = settingsError;
            _isBusy = false;
            return;
        }

        foreach (var fee in _fees)
        {
            var (feeOk, feeError) = await ServiceFeeService.UpdateAsync(fee.Provider, new UpdateServiceFeeRequest
            {
                PercentFee = fee.PercentInput / 100,
                FixedFee = fee.FixedFee
            });

            if (!feeOk)
            {
                _errorMessage = feeError;
                _isBusy = false;
                return;
            }
        }

        _successMessage = "Pricing settings saved.";
        _isBusy = false;
    }

    // Drops trailing zeros so a stored 15.0000 shows as 15 and 1.5000 as 1.5 in the inputs.
    private static decimal TrimZeros(decimal value)
        => decimal.Parse(value.ToString("0.############", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);

    private static string FriendlyProvider(string provider) => provider switch
    {
        "Sms" => "SMS",
        "Email" => "Email",
        _ => provider
    };

    private sealed class FeeRow
    {
        public string Provider { get; init; } = string.Empty;
        public decimal PercentInput { get; set; }
        public decimal FixedFee { get; set; }
    }
}
