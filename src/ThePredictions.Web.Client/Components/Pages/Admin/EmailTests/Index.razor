@page "/admin/email-tests"

@attribute [Authorize(Roles = RoleNames.Administrator)]

@inject HttpClient Http

@using ThePredictions.Contracts.Admin.EmailTests
@using ThePredictions.Contracts.Admin.Users

<PageTitle>Email Test Tool</PageTitle>

<div class="page-container admin-light">
    <div class="base-form base-form--extra-wide">
    <PageHero Title="Email Test Tool" Icon="bi-envelope-paper-fill">
        Trigger any Brevo template against your own inbox with realistic, pre-filled values, so you can
        check content and layout without reproducing the whole user flow.
    </PageHero>

    <ApiError Message="@_errorMessage" />
    <ApiSuccess Message="@_successMessage" />

    @if (_loadingTemplates)
    {
        <div class="form-container">
            <div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"></div></div>
        </div>
    }
    else if (_templates is null || _templates.Count == 0)
    {
        <div class="form-container">
            <p class="form-text text-white-50 mb-0">No Brevo templates were found.</p>
        </div>
    }
    else
    {
        <div class="form-container mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Template</h5>
                <button class="btn grey-button d-flex align-items-center" @onclick="RefreshTemplatesAsync" disabled="@_loadingTemplates">
                    <span class="bi bi-arrow-clockwise me-2"></span>Refresh templates
                </button>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label class="form-label" for="template-select">Template</label>
                    <select id="template-select" class="form-select" value="@_selectedTemplateId" @onchange="OnTemplateChangedAsync">
                        <option value="">-- Select a template --</option>
                        @foreach (var template in _templates)
                        {
                            <option value="@template.Id" disabled="@(!template.IsActive)">
                                @template.Name@(template.IsActive ? "" : " (inactive)")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="user-select">Seed defaults from user</label>
                    <select id="user-select" class="form-select" value="@_selectedUserId" @onchange="OnUserChangedAsync">
                        <option value="">-- Generic defaults --</option>
                        @if (_users is not null)
                        {
                            @foreach (var user in _users)
                            {
                                <option value="@user.Id">@user.FullName (@user.Email)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (_selectedTemplate is not null)
        {
            @if (!_selectedTemplate.IsActive)
            {
                <div class="form-container">
                    <p class="form-text text-white-50 mb-0">Template is inactive in Brevo.</p>
                </div>
            }
            else
            {
                <div class="form-container mb-4">
                    <h5 class="fw-bold mb-3">Parameters</h5>

                    @if (_selectedTemplate.ParamNames.Count == 0)
                    {
                        <p class="form-text text-white-50 mb-0">This template has no <code>{{ params.X }}</code> merge tags.</p>
                    }
                    else if (_loadingDefaults)
                    {
                        <div class="d-flex justify-content-center py-4"><div class="spinner-border" role="status"></div></div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var name in _selectedTemplate.ParamNames)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="param-@name">@name</label>
                                    <input id="param-@name" class="form-control"
                                           value="@GetParam(name)"
                                           @oninput="e => SetParam(name, e.Value?.ToString())" />
                                </div>
                            }
                        </div>

                        <p class="form-text text-white-50 mt-2 mb-3">
                            <span class="bi bi-info-circle me-1"></span>
                            Sends to your own email address (the signed-in admin), never the user picked above.
                        </p>

                        <div class="d-flex justify-content-end">
                            <button class="btn green-button d-flex align-items-center" @onclick="SendAsync" disabled="@(_sending || _loadingDefaults)">
                                @if (_sending)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span class="bi bi-send me-2"></span>
                                    <span>Send test email</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            }
        }
    }
    </div>
</div>

@code {
    private List<EmailTestTemplateDto>? _templates;
    private List<UserDto>? _users;

    private long? _selectedTemplateId;
    private string? _selectedUserId;
    private EmailTestTemplateDto? _selectedTemplate;

    private Dictionary<string, string> _paramValues = new(StringComparer.Ordinal);

    private bool _loadingTemplates;
    private bool _loadingDefaults;
    private bool _sending;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTemplatesAsync(), LoadUsersAsync());
    }

    private async Task LoadTemplatesAsync()
    {
        _loadingTemplates = true;
        _errorMessage = null;

        try
        {
            _templates = await Http.GetFromJsonAsync<List<EmailTestTemplateDto>>("api/admin/emailtests/templates") ?? [];
        }
        catch
        {
            _errorMessage = "Failed to load templates from Brevo.";
            _templates = [];
        }
        finally
        {
            _loadingTemplates = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserDto>>("api/admin/users") ?? [];
        }
        catch
        {
            _users = [];
        }
    }

    private async Task RefreshTemplatesAsync()
    {
        await LoadTemplatesAsync();
        if (_selectedTemplate is not null)
            _selectedTemplate = _templates?.FirstOrDefault(t => t.Id == _selectedTemplateId);
    }

    private async Task OnTemplateChangedAsync(ChangeEventArgs e)
    {
        _successMessage = null;
        _errorMessage = null;
        _selectedTemplateId = long.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _selectedTemplate = _templates?.FirstOrDefault(t => t.Id == _selectedTemplateId);
        await LoadDefaultsAsync();
    }

    private async Task OnUserChangedAsync(ChangeEventArgs e)
    {
        _selectedUserId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        await LoadDefaultsAsync();
    }

    private async Task LoadDefaultsAsync()
    {
        if (_selectedTemplate is null || !_selectedTemplate.IsActive || _selectedTemplate.ParamNames.Count == 0)
        {
            _paramValues = new Dictionary<string, string>(StringComparer.Ordinal);
            return;
        }

        _loadingDefaults = true;

        try
        {
            var url = $"api/admin/emailtests/templates/{_selectedTemplateId}/defaults?dataUserId={Uri.EscapeDataString(_selectedUserId ?? string.Empty)}";
            var defaults = await Http.GetFromJsonAsync<EmailTestDefaultsDto>(url);
            _paramValues = defaults?.Defaults is not null
                ? new Dictionary<string, string>(defaults.Defaults, StringComparer.Ordinal)
                : new Dictionary<string, string>(StringComparer.Ordinal);
        }
        catch
        {
            _paramValues = new Dictionary<string, string>(StringComparer.Ordinal);
        }
        finally
        {
            _loadingDefaults = false;
        }
    }

    private string GetParam(string name) => _paramValues.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetParam(string name, string? value) => _paramValues[name] = value ?? string.Empty;

    private async Task SendAsync()
    {
        if (_selectedTemplateId is null)
            return;

        _sending = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var request = new SendTestEmailRequest(_selectedTemplateId.Value, new Dictionary<string, string>(_paramValues, StringComparer.Ordinal));
            var response = await Http.PostAsJsonAsync("api/admin/emailtests/send", request);
            var result = await response.Content.ReadFromJsonAsync<SendTestEmailResultDto>();

            if (result is { Success: true })
                _successMessage = $"Sent to {result.SentTo}. Brevo message ID: {result.MessageId}";
            else
                _errorMessage = result?.Error ?? "The test email could not be sent.";
        }
        catch
        {
            _errorMessage = "The request failed before a result was returned.";
        }
        finally
        {
            _sending = false;
        }
    }
}
