@page "/"

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject ILogger<Home> Logger

@using System.Net.Http.Json
@using ThePredictions.Contracts.Badges
@using ThePredictions.Contracts.Homepage
@using ThePredictions.Domain.Common.Enumerations

<PageTitle>The Predictions — Football Score Predictions</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            @* Already signed in - go straight to the dashboard. Reactive, so it also
               fires if the auth state resolves after the first render. *@
            <RedirectToDashboard />
        </Authorized>
        <NotAuthorized>
            @* 1. Hero *@
            <div class="hero-section text-center diagonal-clip">
                <div class="container py-5">
                    <span class="mb-4 hero-image" role="img" aria-label="The Predictions"></span>
                    <h1 class="display-4 fw-bold text-white">The Ultimate Football Prediction Game</h1>
                    <p class="fs-4 col-md-8 mx-auto">Challenge your friends, prove your football knowledge, and top the leaderboard. Your journey to prediction glory starts here.</p>
                    <div class="hero-cta-group mt-4">
                        <NavLink class="btn btn-lg purple-button hero-cta" href="authentication/register">Register</NavLink>
                        <NavLink class="btn btn-lg blue-light-button hero-cta" href="authentication/login">Login</NavLink>
                    </div>
                </div>
            </div>

            @* 2. How It Works (light) *@
            <div class="home-section-light py-5">
                <div class="container px-4">
                    <h2 class="text-center fw-bold mb-3">How It Works</h2>
                    <p class="text-center home-intro-lead mx-auto mb-5">The Predictions is a season-long game of football knowledge. Predict the scores, climb the leaderboards, and win prizes in your leagues. Here's how to get started in three simple steps.</p>
                    <div class="row g-4 text-center">
                        <div class="col-md-4">
                            <div class="feature-icon mb-3"><i class="bi bi-ticket-perforated"></i></div>
                            <h4 class="fw-bold">1. Get a Season Pass</h4>
                            <p>Pay a single, one-off Season Pass fee to unlock the site for the whole season. That is the only thing you pay us for - it is a game of skill, not gambling.</p>
                        </div>

                        <div class="col-md-4">
                            <div class="feature-icon mb-3"><i class="bi bi-people-fill"></i></div>
                            <h4 class="fw-bold">2. Join Leagues</h4>
                            <p>With your pass you can join as many leagues as you like. Leagues are free to enter, or the admin sets an entry fee that becomes the prize pot - they pay it out in full, we take no cut and never hold the money.</p>
                        </div>

                        <div class="col-md-4">
                            <div class="feature-icon mb-3"><i class="bi bi-trophy-fill"></i></div>
                            <h4 class="fw-bold">3. Predict, Score & Compete</h4>
                            <p>Predict scores each round - 5 points for a perfect score, 3 for the right result. Climb the leaderboards, earn badges, and win prizes in your money leagues.</p>
                        </div>
                    </div>
                </div>
            </div>

            @* 3. Current Competitions (dark — always shown) *@
            <div class="py-5 bg-purple-1000">
                <div class="container px-4">
                    <h2 class="text-center text-white fw-bold mb-5">Current Competitions</h2>

                    @if (_seasons.Any())
                    {
                        <div class="competitions-rotator"
                             @ontouchstart="HandleTouchStart" @ontouchend="HandleTouchEnd">
                            <div class="competitions-track" style="transform: translateX(-@(_currentIndex * 100)%);">
                                @foreach (var season in _seasons)
                                {
                                    <div class="competitions-slide">
                                        <div class="row align-items-center g-5">
                                            <div class="col-lg-5 text-center d-none d-lg-block">
                                                <div class="competitions-slide__icon">
                                                    @if (season.CompetitionType == CompetitionType.Tournament)
                                                    {
                                                        <i class="bi bi-trophy-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-table"></i>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-lg-7 text-white text-center text-lg-start">
                                                <h3 class="competitions-slide__name fw-bold text-white">@season.Name</h3>

                                                <div class="competitions-slide__dates text-white-50 mb-3">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    @season.StartDateUtc.ToString("dd MMM yyyy") — @season.EndDateUtc.ToString("dd MMM yyyy")
                                                </div>

                                                <div class="competitions-slide__status mb-4">
                                                    @if (season.IsInProgress)
                                                    {
                                                        <span class="badge bg-green-600 text-purple-1000 fw-bold px-3 py-2">In Progress</span>
                                                    }
                                                    else if (season.IsUpcoming)
                                                    {
                                                        <span class="badge bg-purple-300 text-white fw-bold px-3 py-2">Starting @season.StartDateUtc.ToString("dd MMM")</span>
                                                    }
                                                </div>

                                                <div class="competitions-stats d-none d-lg-flex">
                                                    <div class="competitions-stat">
                                                        <div class="competitions-stat__value">@season.LeagueCount</div>
                                                        <div class="competitions-stat__label">Leagues</div>
                                                    </div>
                                                    <div class="competitions-stat">
                                                        <div class="competitions-stat__value">@season.PlayerCount</div>
                                                        <div class="competitions-stat__label">Players</div>
                                                    </div>
                                                    @if (season.TotalPrizeFund > 0)
                                                    {
                                                        <div class="competitions-stat">
                                                            <div class="competitions-stat__value">@((MarkupString)$"&pound;{season.TotalPrizeFund:0}")</div>
                                                            <div class="competitions-stat__label">Prize Money</div>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="competitions-slide__cta mt-4" style="visibility: @(season.IsInProgress || season.IsUpcoming ? "visible" : "hidden")">
                                                    @if (season.IsInProgress)
                                                    {
                                                        <NavLink class="btn btn-lg green-button px-5" href="authentication/login">
                                                            Login to Play
                                                        </NavLink>
                                                    }
                                                    else
                                                    {
                                                        <NavLink class="btn btn-lg green-button px-5" href="authentication/register">
                                                            Register to Play
                                                        </NavLink>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (_seasons.Count > 1)
                        {
                            <div class="competitions-dots mt-4 text-center">
                                @for (var i = 0; i < _seasons.Count; i++)
                                {
                                    var dotIndex = i;
                                    <span class="carousel-dot @(i == _currentIndex ? "active" : "")" @onclick="() => GoToSlide(dotIndex)"></span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center">
                            <p class="text-white-50 fs-5 mb-4">Competitions coming soon — register now to be ready!</p>
                            <NavLink class="btn btn-lg green-button px-5" href="authentication/register">
                                Register Now
                            </NavLink>
                        </div>
                    }
                </div>
            </div>

            @* 4. Boosts & Power-Ups (light) *@
            <div class="home-section-light py-5">
                <div class="container px-4">
                    <h2 class="text-center fw-bold mb-5">Boosts & Power-Ups</h2>
                    <div class="row align-items-center g-5">
                        <div class="col-lg-7 text-center text-lg-start">
                            <h3 class="fw-bold">Gain the Edge</h3>
                            <p>Activate the <strong>Double Up</strong> boost on any round to multiply all your points by two. It's the ultimate strategic weapon — time it right and watch yourself rocket up the leaderboard.</p>
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Double your points</strong> for an entire round</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Limited uses</strong> per season — choose wisely</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Outmanoeuvre your rivals</strong> at the perfect moment</li>
                            </ul>
                        </div>
                        <div class="col-lg-5 text-center">
                            <div class="boost-showcase">
                                <div class="boost-showcase__glow"></div>
                                <img src="/images/boosts/double-up-normal.png" alt="Double Up Boost" class="boost-showcase__image" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* 5. Why Join (dark) *@
            <div class="py-5 bg-purple-1000">
                <div class="container px-4">
                    <h2 class="text-center text-white fw-bold mb-5">Why Join The Predictions?</h2>
                    <div class="row align-items-center g-5">
                        <div class="col-lg-6">
                            <img src="https://images.pexels.com/photos/23495488/pexels-photo-23495488.jpeg" class="img-fluid rounded-3 shadow" alt="Friends cheering while watching football on TV" />
                        </div>
                        <div class="col-lg-6 text-white text-center text-lg-start">
                            <h3 class="fw-bold text-white">It's More Than Just a Game</h3>
                            <p>The Predictions adds an extra layer of excitement to every match. It's a season-long battle of wits, luck, and football passion.</p>
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Free to Play:</strong> Join our official public leagues at no cost.</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Private Leagues:</strong> Create your own private league with an entry fee and a custom prize structure.</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill tick-icon me-2"></i><strong>Live Leaderboards:</strong> Track your progress in real-time as the results come in.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            @* 6. Badges showcase (light) *@
            <div class="home-section-light py-5">
                <div class="container px-4">
                    <h2 class="text-center fw-bold mb-3">Collect Badges as You Play</h2>
                    <p class="text-center home-intro-lead mx-auto mb-5">Every round earns you more than points. Unlock badges for your milestones, level them up from bronze to silver to gold, and chase the rare honours - all for free, simply by playing.</p>
                    <div class="home-badges-grid">
                        @foreach (var badge in _showcaseBadges)
                        {
                            <div class="home-badge @(badge.State == "Locked" ? "home-badge--locked" : "")">
                                <BadgeIcon Badge="badge" Size="96" ShowTierStars="true" />
                                <span class="home-badge__name">@badge.Name</span>
                                <span class="home-badge__tag home-badge__tag--@TagClass(badge)">@badge.ProgressLabel</span>
                            </div>
                        }
                    </div>
                    <p class="text-center home-badges-note mx-auto mt-5">Badges are earned automatically as you play - there is nothing extra to buy. Register to start your collection and see how you rank on the badges leaderboard.</p>
                </div>
            </div>

            @* 7. CTA (dark) *@
            <div class="py-5 bg-purple-1000">
                <div class="container text-center text-white">
                    <h2 class="fw-bold text-white">Ready to Prove Your Punditry?</h2>
                    <p class="fs-5 my-4 col-md-8 mx-auto">Create your account, join a league, and start making your predictions today!</p>
                    <NavLink class="btn btn-lg green-button px-5" href="authentication/register">Get Started for Free</NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private List<HomepageSeasonDto> _seasons = [];
    private int _currentIndex;
    private System.Timers.Timer? _autoAdvanceTimer;
    private double _touchStartX;

    // Hand-built sample badges for the marketing showcase. The homepage is anonymous (no API), so
    // these illustrate the real states a player collects: levelled collections climbing bronze ->
    // silver -> gold, one-off badges, a competitive honour, and one still locked. Empty thresholds
    // and a zero LastAwardedUtc are fine - BadgeIcon only reads state, tier, progress and glyph.
    private static readonly IReadOnlyList<BadgeDto> _showcaseBadges =
    [
        new BadgeDto("marksman", "Marksman", "Exact scores in a season", "target", "Collection", "InProgress", 2, 3, [], 0.66, "10 / 15", 10, null),
        new BadgeDto("sharpshooter", "Sharpshooter", "Exact scores in one round", "crosshair", "Collection", "Earned", 3, 3, [], 1, "Best 5", 5, null),
        new BadgeDto("on-fire", "On Fire", "Rounds in a row with an exact score", "flame", "Collection", "InProgress", 1, 3, [], 0.85, "6 / 7", 6, null),
        new BadgeDto("first-blood", "First Blood", "Your first-ever exact score", "bullseye", "Badge", "Earned", 1, 1, [], 1, "Earned", 1, null),
        new BadgeDto("beat-the-crowd", "Beat the Crowd", "Back the minority result and win", "crowd", "Badge", "Earned", 1, 1, [], 1, "Earned", 1, null),
        new BadgeDto("founder", "Founder", "Create your own league", "shield", "Badge", "Earned", 1, 1, [], 1, "Earned", 1, null),
        new BadgeDto("champion", "Champion", "Win a league", "trophy", "Honour", "Earned", 1, 1, [], 1, "Earned", 1, null),
        new BadgeDto("podium", "Podium", "Finish top 3 in a league", "podium", "Honour", "Locked", 0, 1, [], 0, "Locked", 0, null),
    ];

    // Colour the little status line under each showcase badge to match its icon: gold for an honour or
    // a maxed-out multi-tier collection, grey for locked, green for one-off badges and any progress.
    private static string TagClass(BadgeDto badge)
    {
        if (badge.State == "Locked")
            return "locked";

        var done = badge.State == "Earned"
            && (badge.Category == "Honour" || (badge.MaxTier > 1 && badge.Tier >= badge.MaxTier));

        return done ? "done" : "go";
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Home page has been loaded.");

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        await LoadSeasonsAsync();
    }

    private async Task LoadSeasonsAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<HomepageSeasonDto>>("api/homepage/seasons");
            _seasons = result ?? [];

            if (_seasons.Count > 1)
            {
                StartAutoAdvance();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load homepage seasons");
            _seasons = [];
        }
    }

    private void StartAutoAdvance()
    {
        _autoAdvanceTimer = new System.Timers.Timer(5000);
        _autoAdvanceTimer.Elapsed += (_, _) =>
        {
            InvokeAsync(() =>
            {
                _currentIndex = (_currentIndex + 1) % _seasons.Count;
                StateHasChanged();
            });
        };
        _autoAdvanceTimer.AutoReset = true;
        _autoAdvanceTimer.Start();
    }

    private void GoToSlide(int index)
    {
        if (index < 0 || index >= _seasons.Count)
            return;

        _currentIndex = index;
        ResetAutoAdvance();
    }

    private void HandleTouchStart(TouchEventArgs e)
    {
        _touchStartX = e.Touches[0].ClientX;
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        var touchEndX = e.ChangedTouches[0].ClientX;
        var diffX = _touchStartX - touchEndX;

        if (!(Math.Abs(diffX) > 50))
            return;

        if (diffX > 0 && _currentIndex < _seasons.Count - 1)
            _currentIndex++;
        else if (diffX < 0 && _currentIndex > 0)
            _currentIndex--;

        ResetAutoAdvance();
    }

    private void ResetAutoAdvance()
    {
        _autoAdvanceTimer?.Stop();
        _autoAdvanceTimer?.Start();
    }
}
