@using ThePredictions.Contracts.Badges

@* Circular badge face: a track ring, a progress ring that fills toward the next level/target,
   the badge glyph, and optional bronze/silver/gold tier stars. Colours are driven by CSS classes
   (green for progress/earned, medal gold for honours, grey when locked) so both themes work. *@

<span class="tp-badge-icon tp-badge-icon--@Variant @(IsLocked ? "tp-badge-icon--locked" : "")">
    <svg class="tp-badge-icon__face" viewBox="0 0 120 120" style="width: @(Size)px; height: @(Size)px;" role="img" aria-label="@AriaLabel">
        <circle class="tp-badge-icon__disc" cx="60" cy="60" r="40" />
        <circle class="tp-badge-icon__track" cx="60" cy="60" r="50" fill="none" stroke-width="8" />
        @if (!IsLocked)
        {
            <circle class="tp-badge-icon__ring" cx="60" cy="60" r="50" fill="none" stroke-width="8" stroke-linecap="round"
                    stroke-dasharray="@CircumferenceText" stroke-dashoffset="@DashOffsetText" transform="rotate(-90 60 60)" />
        }
        <g class="tp-badge-icon__glyph">@GlyphMarkup</g>
    </svg>

    @if (ShowTierStars && Badge.MaxTier > 1)
    {
        <span class="tp-badge-icon__stars">
            @for (var i = 0; i < Badge.MaxTier; i++)
            {
                var on = i < Badge.Tier;
                var metal = MetalClass(i);
                <svg class="tp-badge-icon__star @(on ? "tp-badge-icon__star--on " + metal : "")" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 L14.6 9 L21 9.5 L16 13.8 L17.6 20 L12 16.5 L6.4 20 L8 13.8 L3 9.5 L9.4 9 Z" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
            }
        </span>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public BadgeDto Badge { get; set; } = default!;

    // Rendered face diameter in pixels. Page cards use 112, the dashboard tile uses 74.
    [Parameter]
    public int Size { get; set; } = 112;

    [Parameter]
    public bool ShowTierStars { get; set; }

    private const double Radius = 50;
    private static readonly double Circumference = 2 * Math.PI * Radius;

    private bool IsLocked => Badge.State == "Locked";

    // Collections take the medal of the tier reached (bronze -> silver -> gold), matching their stars, and
    // green while still working toward the first tier. Honours are gold; one-off badges are green. Locked
    // greys out via the --locked class regardless of variant.
    private string Variant => Badge.Category switch
    {
        "Honour" => "gold",
        "Collection" => Badge.Tier switch
        {
            >= 3 => "gold",
            2 => "silver",
            1 => "bronze",
            _ => "green"
        },
        _ => "green"
    };

    // Earned badges show a full ring; everything else fills to its live progress.
    private double Fraction => IsLocked ? 0 : Badge.State == "Earned" ? 1 : Math.Clamp(Badge.Progress, 0, 1);

    private string CircumferenceText => Circumference.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private string DashOffsetText => (Circumference * (1 - Fraction)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private string AriaLabel
    {
        get
        {
            var stateWord = Badge.State switch
            {
                "Earned" => "earned",
                "InProgress" => "in progress",
                _ => "locked"
            };

            return $"{Badge.Name}, {stateWord}";
        }
    }

    private static string MetalClass(int index) => index switch
    {
        0 => "tp-badge-icon__star--bronze",
        1 => "tp-badge-icon__star--silver",
        _ => "tp-badge-icon__star--gold"
    };

    // Glyph markup is shared with the server-side badge PNG renderer via BadgeGlyphs; every stroke/fill
    // uses currentColor so the parent .tp-badge-icon__glyph colour (set per state in CSS) drives them.
    private MarkupString GlyphMarkup => new(BadgeGlyphs.Svg(Badge.Glyph));
}
