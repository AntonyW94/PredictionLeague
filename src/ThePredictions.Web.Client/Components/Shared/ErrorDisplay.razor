@* Branded, centred error card reused by the 404 (NotFound), 403 (NotAuthorized) and 500
   (error-boundary) states. Renders inside the app's `form-container` card so the text picks up the
   same light/dark theme overrides as the login/register cards (bare text-white would be invisible on
   the light-theme background). Pass ChildContent for custom actions (e.g. a retry button); otherwise
   a "Back to dashboard" link is shown. Icon is a Bootstrap Icons class (e.g. "bi-compass"). *@

<div class="page-container error-page">
    <div class="form-container shadow text-center error-card">
        <div class="error-icon" aria-hidden="true">
            <i class="bi @Icon"></i>
        </div>
        <p class="error-code fw-bold text-green-600">@Code</p>
        <h1 class="text-purple-1000 fw-bold mb-3">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="error-message text-grey-500 mb-4">@Message</p>
        }
        <div class="d-grid gap-2">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                <a href="/" class="btn green-button btn-input-height">
                    <i class="bi bi-house-door me-2"></i>Back to dashboard
                </a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-exclamation-triangle";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
