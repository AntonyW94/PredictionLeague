@using ThePredictions.Contracts.Leagues

<FormSection Title="Entry-fee payment details (optional)"
             Intro="Add your bank details so players can pay the entry fee directly. These are only shown to people who join this league, and The Predictions never handles the money. Leave blank to arrange payment yourself.">
    <div class="mb-3">
        <label for="bankAccountName" class="form-label">Account holder name</label>
        <InputText id="bankAccountName" class="form-control" @bind-Value="Model.BankAccountName" />
        <div class="form-text text-white-50">The name the bank account is in (not the bank's name).</div>
        <StyledValidationMessage For="@(() => Model.BankAccountName)" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="bankSortCode" class="form-label">Sort code</label>
            <DigitsInput Id="bankSortCode" @bind-Value="Model.BankSortCode" MaxDigits="6" GroupSize="2" Placeholder="12-34-56" />
            <StyledValidationMessage For="@(() => Model.BankSortCode)" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="bankAccountNumber" class="form-label">Account number</label>
            <DigitsInput Id="bankAccountNumber" @bind-Value="Model.BankAccountNumber" MaxDigits="8" Placeholder="12345678" />
            <StyledValidationMessage For="@(() => Model.BankAccountNumber)" />
        </div>
    </div>

    <div class="mb-3">
        <label for="paymentReference" class="form-label">Payment reference (optional)</label>
        <InputText id="paymentReference" class="form-control" @bind-Value="Model.PaymentReferenceTemplate" placeholder="e.g. your league name" />
        <div class="form-text text-white-50">Shown to players as the reference to use when they pay. Leave blank to use the player's name.</div>
        <StyledValidationMessage For="@(() => Model.PaymentReferenceTemplate)" />
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired] public IHasBankDetails Model { get; set; } = default!;
}
