@using ThePredictions.Web.Client.Services.Dashboard

@if (Prompts.Count > 0)
{
    <div class="dashboard-prompts">
        @foreach (var prompt in Prompts)
        {
            <div class="dashboard-prompt">
                <div class="dashboard-prompt__body">
                    <span class="dashboard-prompt__icon bi @prompt.Icon" aria-hidden="true"></span>
                    <span class="dashboard-prompt__message">
                        @if (!string.IsNullOrEmpty(prompt.Highlight) && prompt.Message.Contains(prompt.Highlight, StringComparison.Ordinal))
                        {
                            var index = prompt.Message.IndexOf(prompt.Highlight, StringComparison.Ordinal);
                            @prompt.Message[..index]<strong class="dashboard-prompt__highlight">@prompt.Highlight</strong>@prompt.Message[(index + prompt.Highlight.Length)..]
                        }
                        else
                        {
                            @prompt.Message
                        }
                    </span>
                </div>
                <a class="dashboard-prompt__action" href="@prompt.ActionHref">@prompt.ActionLabel</a>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DashboardPrompt> Prompts { get; set; } = [];
}
