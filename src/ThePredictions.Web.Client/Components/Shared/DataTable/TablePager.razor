@using ThePredictions.Contracts.Common

@*
    Page size picker, "showing X to Y of Z" summary, and page buttons for a server-paged list.
    The page buttons only appear once there is more than one page; the summary and size picker
    show for any non-empty list, and the whole thing disappears when there is nothing to page.
*@

@if (TotalCount > 0)
{
    <div class="data-table-pager">
        <div class="data-table-pager-size">
            <label for="@_pageSizeId">Show</label>
            <select id="@_pageSizeId" class="form-select" value="@PageSize" @onchange="OnPageSizeSelectedAsync">
                @foreach (var size in PageSizes.Allowed)
                {
                    <option value="@size">@size</option>
                }
            </select>
            <span class="data-table-pager-size-unit">@ItemNamePlural</span>
        </div>

        <div class="data-table-pager-summary">
            <span>@FirstItemNumber to @LastItemNumber of @TotalCount</span>
        </div>

        @if (TotalPages > 1)
        {
            <div class="data-table-pager-pages">
                <button type="button" class="data-table-page-button" disabled="@(Page <= 1)"
                        @onclick="() => GoToPageAsync(Page - 1)" title="Previous page">
                    <span class="bi bi-chevron-left"></span>
                </button>

                @foreach (var pageNumber in VisiblePages())
                {
                    if (pageNumber == Ellipsis)
                    {
                        <span class="data-table-page-ellipsis">…</span>
                    }
                    else
                    {
                        var target = pageNumber;
                        <button type="button" class="data-table-page-button @(target == Page ? "active" : "")"
                                @onclick="() => GoToPageAsync(target)">
                            @target
                        </button>
                    }
                }

                <button type="button" class="data-table-page-button" disabled="@(Page >= TotalPages)"
                        @onclick="() => GoToPageAsync(Page + 1)" title="Next page">
                    <span class="bi bi-chevron-right"></span>
                </button>
            </div>
        }
    </div>
}

@code {
    /// <summary>Stands in for a gap in the page buttons rather than a real page number.</summary>
    private const int Ellipsis = -1;

    /// <summary>How many page buttons either side of the current page stay visible.</summary>
    private const int PagesEitherSide = 1;

    /// <summary>1-based number of the page currently shown.</summary>
    [Parameter, EditorRequired]
    public int Page { get; set; }

    /// <summary>Rows per page. Must be one of <see cref="PageSizes.Allowed"/>.</summary>
    [Parameter, EditorRequired]
    public int PageSize { get; set; }

    /// <summary>Size of the whole matching set, not of this page.</summary>
    [Parameter, EditorRequired]
    public int TotalCount { get; set; }

    /// <summary>Raised with the 1-based page number to move to.</summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>Raised with the newly chosen page size.</summary>
    [Parameter]
    public EventCallback<int> OnPageSizeChanged { get; set; }

    /// <summary>What the rows are, plural, for the summary wording - "players", "leagues", "rows".</summary>
    [Parameter]
    public string ItemNamePlural { get; set; } = "rows";

    private readonly string _pageSizeId = $"page-size-{Guid.NewGuid():N}";

    private int TotalPages => TotalCount <= 0 ? 1 : (int)Math.Ceiling(TotalCount / (double)PageSize);
    private int FirstItemNumber => ((Page - 1) * PageSize) + 1;
    private int LastItemNumber => Math.Min(Page * PageSize, TotalCount);

    /// <summary>
    /// First page, last page, and a window around the current one, with gaps collapsed to an
    /// ellipsis so a hundred pages do not produce a hundred buttons.
    /// </summary>
    private List<int> VisiblePages()
    {
        var pages = new List<int>();
        var lastPage = TotalPages;

        for (var pageNumber = 1; pageNumber <= lastPage; pageNumber++)
        {
            var isEdge = pageNumber == 1 || pageNumber == lastPage;
            var isNearCurrent = Math.Abs(pageNumber - Page) <= PagesEitherSide;

            if (isEdge || isNearCurrent)
            {
                pages.Add(pageNumber);
            }
            else if (pages.Count > 0 && pages[^1] != Ellipsis)
            {
                pages.Add(Ellipsis);
            }
        }

        return pages;
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == Page)
            return;

        await OnPageChanged.InvokeAsync(page);
    }

    private async Task OnPageSizeSelectedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var pageSize))
            return;

        await OnPageSizeChanged.InvokeAsync(PageSizes.Clamp(pageSize));
    }
}
