@using ThePredictions.Web.Client.Components.Layout

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <div class="page-container text-white d-flex justify-content-center align-items-center h-screen">
                    <div class="app-loading-container">
                        <div class="spinner"></div>
                        <p>Authorising...</p>
                    </div>
                </div>
            </Authorizing>
            <NotAuthorized Context="authState">
                @* Signed in but lacking permission (e.g. a non-admin hitting an admin route) gets a
                   branded 403; an unauthenticated visitor is sent to log in as before. *@
                @if (authState.User.Identity?.IsAuthenticated == true)
                {
                    <ErrorDisplay Code="403"
                                  Title="Access denied"
                                  Icon="bi-shield-lock"
                                  Message="You don't have permission to view this page. If you think this is a mistake, get in touch." />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <ErrorDisplay Code="404"
                          Title="Page not found"
                          Icon="bi-signpost-2"
                          Message="The page you're looking for doesn't exist or may have moved." />
        </LayoutView>
    </NotFound>
</Router>