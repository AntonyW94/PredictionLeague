@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IThemeService ThemeService
@using ThePredictions.Web.Client.Services.Theme
@implements IDisposable

<div class="page">
    <CascadingAuthenticationState>
        <main class="@_backgroundClass @(ThemeService.IsDarkMode ? "theme-dark" : "")">
            <NavLayout class="@_navLayoutClass" />

            <article class="content">
                <LoggingErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <ErrorDisplay Code="500"
                                      Title="Something went wrong"
                                      Icon="bi-exclamation-triangle"
                                      Message="An unexpected error occurred. Try again, or refresh the page if it keeps happening.">
                            <button class="btn green-button btn-input-height" @onclick="RecoverFromError">
                                <i class="bi bi-arrow-clockwise me-2"></i>Try again
                            </button>
                            <a href="/" class="text-grey-500 text-decoration-none mt-2">Back to dashboard</a>
                        </ErrorDisplay>
                    </ErrorContent>
                </LoggingErrorBoundary>
            </article>

            <Footer />
            <CookieConsentBanner />
        </main>
    </CascadingAuthenticationState>
</div>

@code {
    private LoggingErrorBoundary? _errorBoundary;
    private string _navLayoutClass = "";
    private string _backgroundClass = "";

    protected override async Task OnInitializedAsync()
    {
        SetLayoutClasses();
        NavigationManager.LocationChanged += OnLocationChanged;
        ThemeService.OnThemeChanged += StateHasChanged;
        await ThemeService.InitialiseAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        SetLayoutClasses();
        StateHasChanged();
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }

    private void SetLayoutClasses()
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath;

        var isHomePage = path == "/" || path == "";

        _navLayoutClass = isHomePage ? "navbar-overlay" : "";
        _backgroundClass = isHomePage ? "bg-purple-100" : "";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}