<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <!-- NETSDK1198: Publish profile not found. Suppressed because publish profiles
             are only needed in the Web (server) project, not this WASM client project. -->
        <NoWarn>$(NoWarn);NETSDK1198</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.14" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ThePredictions.Contracts\ThePredictions.Contracts.csproj" />
      <ProjectReference Include="..\ThePredictions.Validators\ThePredictions.Validators.csproj">
        <TreatAsUsed>true</TreatAsUsed>
      </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <Content Update="wwwroot\appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Update="wwwroot\appsettings.Production.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!--
    CSS Bundling for Production

    Development (dotnet run): Uses separate CSS files with @imports for easy debugging
    Production (dotnet publish): CSS bundling handled by MSBuild target in Web.csproj
    -->

    <ItemGroup>
        <!-- Documentation that lives beside the assets it describes, so it is found when someone is
             looking at those files - but it is not part of the site and must not be served. -->
        <Content Update="wwwroot\**\*.md" CopyToPublishDirectory="Never" />

        <!-- A stale, gitignored local artefact from an old workflow. CI never sees it, but a local
             publish would ship 52KB of dead CSS - and now that the build genuinely minifies app.css,
             a file called app.min.css sitting next to it is actively misleading. -->
        <Content Update="wwwroot/css/app.min.css" CopyToPublishDirectory="Never" />
    </ItemGroup>

</Project>
