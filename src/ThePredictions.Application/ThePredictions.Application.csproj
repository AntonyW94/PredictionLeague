<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="MediatR" Version="14.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThePredictions.Application.Tests.Unit" />
    <!-- NSubstitute's proxy generator needs to see internal types to build a return value for a
         read whose result type is internal (e.g. a query handler's nested result record). Without
         this, substituting IApplicationReadDbConnection throws "Can not create proxy for type
         IEnumerable<...> because type ... is not accessible" the moment the handler runs. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThePredictions.Contracts\ThePredictions.Contracts.csproj" />
    <ProjectReference Include="..\ThePredictions.Domain\ThePredictions.Domain.csproj" />
    <ProjectReference Include="..\ThePredictions.Validators\ThePredictions.Validators.csproj" />
  </ItemGroup>

</Project>
